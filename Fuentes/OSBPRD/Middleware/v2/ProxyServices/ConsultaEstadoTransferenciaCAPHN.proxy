        <con:namespace>http://www.ficohsa.com.hn/middleware.services/operacionesCAPPS</con:namespace>
      </con:port>
      <con:selector type="SOAP body"/>
    </ser:binding>
    <ser:monitoring isEnabled="false">
      <ser:aggregationInterval>10</ser:aggregationInterval>
      <ser:pipelineMonitoringLevel>Pipeline</ser:pipelineMonitoringLevel>
    </ser:monitoring>
    <ser:reporting>true</ser:reporting>
    <ser:logging isEnabled="true">
      <ser:logLevel>debug</ser:logLevel>
    </ser:logging>
    <ser:sla-alerting isEnabled="true">
      <ser:alertLevel>normal</ser:alertLevel>
    </ser:sla-alerting>
    <ser:pipeline-alerting isEnabled="true">
      <ser:alertLevel>normal</ser:alertLevel>
    </ser:pipeline-alerting>
    <ser:ws-policy>
      <ser:binding-mode>wsdl-policy-attachments</ser:binding-mode>
    </ser:ws-policy>
  </ser:coreEntry>
  <ser:endpointConfig>
    <tran:provider-id>local</tran:provider-id>
    <tran:inbound>true</tran:inbound>
    <tran:inbound-properties/>
    <tran:all-headers>true</tran:all-headers>
  </ser:endpointConfig>
  <ser:router errorHandler="_onErrorHandler-5648298734580514842-4646737.199f45aab03.-28c6">
    <con:pipeline type="error" name="_onErrorHandler-5648298734580514842-4646737.199f45aab03.-28c6">
      <con:stage name="ManejoError">
        <con:context>
          <con2:varNsDecl namespace="http://www.ficohsa.com.hn/middleware.services/autType" prefix="aut"/>
          <con2:varNsDecl namespace="http://www.ficohsa.com.hn/middleware.services/operacionesCAPTypes" prefix="oper"/>
        </con:context>
        <con:actions>
          <con1:replace varName="header" contents-only="true">
            <con2:id>_ActionId-5648298734580514842-4646737.199f45aab03.-285a</con2:id>
            <con1:expr>
              <con2:xqueryText><![CDATA[<aut:ResponseHeader>
	<messageId>-1</messageId>
	<successIndicator>{ string($fault/ctx:errorCode/text()) }</successIndicator>
	<messages>{ string($fault/ctx:reason/text()) }</messages>
</aut:ResponseHeader>]]></con2:xqueryText>
            </con1:expr>
          </con1:replace>
          <con1:replace contents-only="true" varName="body">
            <con2:id>_ActionId-5648298734580514842-4646737.199f45aab03.-282c</con2:id>
            <con1:expr>
              <con2:xqueryText>&lt;oper:consultaEstadoTransferenciaCAPResponse/></con2:xqueryText>
            </con1:expr>
          </con1:replace>
          <con2:reply>
            <con2:id>_ActionId-5648298734580514842-4646737.199f45aab03.-2819</con2:id>
          </con2:reply>
        </con:actions>
      </con:stage>
    </con:pipeline>
    <con:pipeline type="request" name="ConsultaEstadoTransferenciaCAPHN_request">
      <con:stage name="ConsultaEstadoTransferenciaCAPHN">
        <con:context>
          <con2:varNsDecl namespace="http://www.ficohsa.com.hn/middleware.services/autType" prefix="aut"/>
          <con2:varNsDecl namespace="http://www.ficohsa.com.hn/middleware.services/operacionesCAPTypes" prefix="oper"/>
        </con:context>
        <con:actions>
          <con1:wsCallout>
            <con2:id>_ActionId-5648298734580514842-4646737.199f45aab03.3336</con2:id>
            <con1:service xsi:type="ref:BusinessServiceRef" ref="Middleware/v2/BusinessServices/T24/svcConsultaEstadoTransaccion/biz/svcConsultaEstadoTransaccion" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
            <con1:operation>ConsultaEstadoTransaccion</con1:operation>
            <con1:request>
              <con1:body>$reqConsultaEstadoTransaccion</con1:body>
            </con1:request>
            <con1:response>
              <con1:body>rspConsultaEstadoTransaccion</con1:body>
            </con1:response>
            <con1:requestTransform>
              <con1:assign varName="reqConsultaEstadoTransaccion">
                <con2:id>_ActionId-5648298734580514842-4646737.199f45aab03.3333</con2:id>
                <con1:expr>
                  <con2:xqueryTransform>
                    <con2:resource ref="Middleware/v2/Resources/OperacionesCAP/xq/consultaEstadoTransaccionIn"/>
                    <con2:param name="requestHeader">
                      <con2:path>$header/aut:RequestHeader</con2:path>
                    </con2:param>
                    <con2:param name="consultaEstadoTransferenciaCAPRequest">
                      <con2:path>$body/oper:consultaEstadoTransferenciaCAPRequest</con2:path>
                    </con2:param>
                  </con2:xqueryTransform>
                </con1:expr>
              </con1:assign>
            </con1:requestTransform>
            <con1:responseTransform>
              <con1:assign varName="errorCode">
                <con2:id>_ActionId-5648298734580514842-4646737.199f45aab03.3334</con2:id>
                <con1:expr>
                  <con2:xqueryText>data($rspConsultaEstadoTransaccion/Status/successIndicator/text())</con2:xqueryText>
                </con1:expr>
              </con1:assign>
              <con1:assign varName="validationMessage">
                <con2:id>_ActionId-5648298734580514842-4646737.199f45aab03.3335</con2:id>
                <con1:expr>
                  <con2:xqueryText>data($rspConsultaEstadoTransaccion/Status/messages/text())</con2:xqueryText>
                </con1:expr>
              </con1:assign>
            </con1:responseTransform>
          </con1:wsCallout>
        </con:actions>
      </con:stage>
    </con:pipeline>
    <con:pipeline type="response" name="ConsultaEstadoTransferenciaCAPHN_response">
      <con:stage name="FlujoSalida">
        <con:context>
          <con2:varNsDecl namespace="http://www.ficohsa.com.hn/middleware.services/autType" prefix="aut"/>
          <con2:varNsDecl namespace="http://www.ficohsa.com.hn/middleware.services/operacionesCAPTypes" prefix="oper"/>
        </con:context>
        <con:actions>
          <con1:ifThenElse>
            <con2:id>_ActionId-5648298734580514842-4646737.199f45aab03.-286d</con2:id>
            <con1:case>
              <con1:condition>
                <con2:xqueryText>fn:upper-case($errorCode) = "SUCCESS"</con2:xqueryText>
              </con1:condition>
              <con1:actions>
                <con1:replace contents-only="true" varName="header">
                  <con2:id>_ActionId-5648298734580514842-4646737.199f45aab03.2fac</con2:id>
                  <con1:expr>
                    <con2:xqueryText><![CDATA[<aut:ResponseHeader>
	<successIndicator>Success</successIndicator>
	{
		if(fn:normalize-space($validationMessage) != '')then
			for $msg_node in $rspConsultaEstadoTransaccion/Status/messages/text()
            return
                <messages>{fn:string($msg_node)}</messages>
		else ()
	}
</aut:ResponseHeader>]]></con2:xqueryText>
                  </con1:expr>
                </con1:replace>
                <con1:replace contents-only="true" varName="body">
                  <con2:id>_ActionId-5648298734580514842-4646737.199f45aab03.300e</con2:id>
                  <con1:expr>
                    <con2:xqueryTransform>
                      <con2:resource ref="Middleware/v2/Resources/OperacionesCAP/xq/consultaEstadoTransaccionOut"/>
                      <con2:param name="consultaEstadoTransaccionResponse">
                        <con2:path>$rspConsultaEstadoTransaccion</con2:path>
                      </con2:param>
                    </con2:xqueryTransform>
                  </con1:expr>
                </con1:replace>
              </con1:actions>
            </con1:case>
            <con1:default>
              <con1:replace contents-only="true" varName="header">
                <con2:id>_ActionId-5648298734580514842-4646737.199f45aab03.2fdc</con2:id>
                <con1:expr>
                  <con2:xqueryText><![CDATA[<aut:ResponseHeader>
	<successIndicator>{$errorCode}</successIndicator>
	<messages>{$validationMessage}</messages>
</aut:ResponseHeader>]]></con2:xqueryText>
                </con1:expr>
              </con1:replace>
              <con1:replace contents-only="true" varName="body">
                <con2:id>_ActionId-5648298734580514842-4646737.199f45aab03.3028</con2:id>
                <con1:expr>
                  <con2:xqueryText>&lt;oper:consultaEstadoTransferenciaCAPResponse/></con2:xqueryText>
                </con1:expr>
              </con1:replace>
            </con1:default>
          </con1:ifThenElse>
        </con:actions>
      </con:stage>
    </con:pipeline>
    <con:flow>
      <con:pipeline-node name="ConsultaEstadoTransferenciaCAPHN">
        <con:request>ConsultaEstadoTransferenciaCAPHN_request</con:request>
        <con:response>ConsultaEstadoTransferenciaCAPHN_response</con:response>
      </con:pipeline-node>
