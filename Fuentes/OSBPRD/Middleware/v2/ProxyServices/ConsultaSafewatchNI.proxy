    <con:pipeline type="request" name="NI01_ConsultaSafewatch_request">
      <con:stage name="StageCallScanSafewatch" xmlns:con1="http://www.bea.com/wli/sb/stages/config" xmlns:con2="http://www.bea.com/wli/sb/stages/transform/config">
