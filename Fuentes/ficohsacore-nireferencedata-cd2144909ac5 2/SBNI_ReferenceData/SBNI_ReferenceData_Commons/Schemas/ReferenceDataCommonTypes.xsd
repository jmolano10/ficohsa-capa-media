<?xml version="1.0" encoding="windows-1252" ?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns="https://www.ficohsa.com/regional/common/referenceDataCommonType"
            targetNamespace="https://www.ficohsa.com/regional/common/referenceDataCommonType"
            >
            
            
            
  <!--ServicesAvailable Type-->
  
  <!--Service Type-->
  <xsd:complexType name="ServiceType">
    <xsd:sequence>
      <xsd:element name="Name" type="xsd:string"/>
      <xsd:element name="Value" type="xsd:string"/>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="ServicesAvailableType">
    <xsd:sequence>
      <xsd:element name="Service" type="ServiceType" minOccurs="0" maxOccurs="unbounded"/>
    </xsd:sequence>
  </xsd:complexType>
  <!--Service Type End-->
  <!--+++++++++++++++++++++++++++++++++++++++++++++++++++++-->
  
  
  
  <xsd:complexType name="AgenciesDetailsType">
    <xsd:sequence>
      <xsd:element name="BranchCode" type="xsd:string" minOccurs="0"/>
      <xsd:element name="BranchName" type="xsd:string" minOccurs="0"/>
      <xsd:element name="BranchType" type="xsd:string" minOccurs="0"/>
      <xsd:element name="GeographicZone" type="xsd:string" minOccurs="0"/>
      <xsd:element name="ServicesAvailable" type="ServicesAvailableType" minOccurs="0"/>
    </xsd:sequence>
  </xsd:complexType>
  
  
  
  <!--ServicesAvailable Type End-->
  <!--+++++++++++++++++++++++++++++++++++++++++++++++++++++-->
  <!--ServicesAvailable info-->
  <xsd:element name="Service" type="ServiceType"/>
  <xsd:element name="ServicesAvailable" type="ServicesAvailableType"/>
  <xsd:element name="AgenciesDetails" type="AgenciesDetailsType"/>
  

  
  
  <!--Service end-->
  <!--ServicesAvailable end-->
  
  
  
  
  <!-- Entrega 5 -->
  
  <!-- Definición del tipo BussinessOfficer -->
  <xsd:complexType name="BussinessOfficerType">
    <xsd:sequence>
      <xsd:element name="OfficerCode" type="xsd:string" minOccurs="0"/>
      <xsd:element name="OfficerName" type="xsd:string" minOccurs="0"/>
      <xsd:element name="BranchCode" type="xsd:string" minOccurs="0"/>
      <xsd:element name="BranchName" type="xsd:string" minOccurs="0"/>
      <xsd:element name="DeptoId" type="xsd:decimal" minOccurs="0"/>
      <xsd:element name="DeptoName" type="xsd:string" minOccurs="0"/>
      <xsd:element name="InsuranceAmount" type="xsd:decimal" minOccurs="0"/>
      <xsd:element name="CurrentBalance" type="xsd:decimal" minOccurs="0"/>
    </xsd:sequence>
  </xsd:complexType>
  
  
  
  
  <!-- Entrega 7 -->
  
  <xsd:complexType name="NonWorkingDays">
    <xsd:sequence>
      <xsd:element name="Date" type="xsd:date" minOccurs="0"/>
      <xsd:element name="Module" type="xsd:string" minOccurs="0"/>
      <xsd:element name="Status" type="xsd:string" minOccurs="0"/>
    </xsd:sequence>
  </xsd:complexType>

  
</xsd:schema>