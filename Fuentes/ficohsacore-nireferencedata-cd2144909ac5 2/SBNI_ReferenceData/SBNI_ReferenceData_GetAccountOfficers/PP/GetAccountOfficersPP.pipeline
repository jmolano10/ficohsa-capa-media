let $oficiales := $responseService/dto:oficial
return
if ($successIndicator = "0"  and ($oficiales)) then (
  'Success')
else (
  if ($successIndicator = "0" and not($oficiales) ) then (
    'NoRecords'
  ) else
    $respuestaMsg
)</con2:xqueryText>
