<schema targetNamespace="http://xmlns.oracle.com/pcbpel/adapter/db/sp/ConsultaCatalogosCobis" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:db="http://xmlns.oracle.com/pcbpel/adapter/db/sp/ConsultaCatalogosCobis" elementFormDefault="qualified">
   <element name="InputParameters">
      <complexType>
         <sequence>
            <element name="t_from" type="db:string30" db:index="1" db:type="VARCHAR" minOccurs="0" nillable="true"/>
            <element name="i_canal" type="int" db:index="2" db:type="INT" minOccurs="0" nillable="true"/>
            <element name="i_operacion" type="db:string1" db:index="3" db:type="VARCHAR" minOccurs="0" nillable="true"/>
            <element name="i_cond1" type="db:string64" db:index="4" db:type="VARCHAR" minOccurs="0" nillable="true"/>
            <element name="i_cond2" type="db:string30" db:index="5" db:type="VARCHAR" minOccurs="0" nillable="true"/>
            <element name="i_cond3" type="db:string30" db:index="6" db:type="VARCHAR" minOccurs="0" nillable="true"/>
            <element name="i_cond4" type="db:string30" db:index="7" db:type="VARCHAR" minOccurs="0" nillable="true"/>
            <element name="i_transaction_date" type="db:string13" db:index="8" db:type="VARCHAR" minOccurs="0" nillable="true"/>
         </sequence>
      </complexType>
   </element>
   <element name="OutputParameters">
      <complexType>
         <sequence>
            <element name="RowSet" type="db:RowSet" db:type="RowSet" minOccurs="0" maxOccurs="unbounded" nillable="true"/>
            <element name="RETURN_VALUE" type="int" db:index="0" db:type="INT" minOccurs="0" nillable="true"/>
         </sequence>
      </complexType>
   </element>
   <complexType name="RowSet">
      <sequence>
         <element name="Row" minOccurs="0" maxOccurs="unbounded">
            <complexType>
               <sequence>
                  <element name="Column" maxOccurs="unbounded" nillable="true">
                     <complexType>
                        <simpleContent>
                           <extension base="string">
                              <attribute name="name" type="string" use="required"/>
                              <attribute name="sqltype" type="string" use="required"/>
                           </extension>
                        </simpleContent>
                     </complexType>
                  </element>
               </sequence>
            </complexType>
         </element>
      </sequence>
   </complexType>
   <simpleType name="string30">
      <restriction base="string">
         <maxLength value="30"/>
      </restriction>
   </simpleType>
   <simpleType name="string1">
      <restriction base="string">
         <maxLength value="1"/>
      </restriction>
   </simpleType>
   <simpleType name="string64">
      <restriction base="string">
         <maxLength value="64"/>
      </restriction>
   </simpleType>
   <simpleType name="string13">
      <restriction base="string">
         <maxLength value="13"/>
      </restriction>
   </simpleType>
</schema>
