	<xs:element name="reversarTransaccion">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="TRANSACTION_ID" type="xs:string" />
				<xs:element name="TRANSACTION_TYPE" type="xs:string" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="reversarTransaccionResponse"/>

</xs:schema>]]></con:schema>
    <con:targetNamespace>http://www.ficohsa.com.hn/middleware.services/reversarTransaccionTypes</con:targetNamespace>
