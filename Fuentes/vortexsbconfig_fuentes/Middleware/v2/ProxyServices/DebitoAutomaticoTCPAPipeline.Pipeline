                </con:context>
                <con:actions>
                    <con1:wsCallout xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N53e24ef9.26f0e0c0.0.19973c2baac.N7fcd</con2:id>
                        <con1:service ref="Middleware/v2/BusinessServices/ABKPA/DebitoAutomaticoTCPA/biz/debitoAutomaticoTC_db" xsi:type="ref:BusinessServiceRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
                        <con1:operation>debitoAutomaticoTC_db</con1:operation>
                        <con1:request>
                            <con1:body wrapped="false">debitoAutomaticoRequest</con1:body>
                        </con1:request>
                        <con1:response>
                            <con1:body wrapped="false">responseSp</con1:body>
                        </con1:response>
                        <con1:requestTransform>
                            <con1:assign varName="debitoAutomaticoRequestBody">
                                <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N53e24ef9.26f0e0c0.0.19973c2baac.N7fba</con2:id>
                                <con1:expr>
                                    <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">$body/deb:DebitoAutomaticoTCPArequest</con2:xqueryText>
                                </con1:expr>
                            </con1:assign>
                            <con1:assign varName="debitoAutomaticoRequest">
                                <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N53e24ef9.5f033da3.0.1997d911fb2.N7fee</con2:id>
                                <con1:expr>
                                    <con2:xqueryTransform xmlns:con2="http://www.bea.com/wli/sb/stages/config">
                                        <con2:resource ref="Middleware/v2/Resources/DebitoAutomaticoTCPA/xq/debitoAutomaticoTCPAIn"/>
                                        <con2:param name="debitoAutomaticoRequest">
