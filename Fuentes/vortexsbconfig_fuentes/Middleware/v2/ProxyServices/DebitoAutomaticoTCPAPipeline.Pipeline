            <con:stage id="_StageId-N53e24ef9.5cb6971b.0.1993a0eb3b9.N7cd3" name="FlujoSalida">
                <con:context>
                    <con1:userNsDecl prefix="deb" namespace="http://www.ficohsa.com.pa/regional/Vortex/DebitoAutomaticoTCPA" xmlns:con1="http://www.bea.com/wli/sb/stages/config"/>
                    <con1:userNsDecl prefix="aut" namespace="http://www.ficohsa.com.hn/middleware.services/autType" xmlns:con1="http://www.bea.com/wli/sb/stages/config"/>
