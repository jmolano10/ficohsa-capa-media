                                <con1:expr>
                                    <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">concat($responseSp/*:P_ERROR_CODE/text(),'')</con2:xqueryText>
                                </con1:expr>
                            </con1:assign>
