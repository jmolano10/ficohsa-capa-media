                                <con2:id>_ActionId-8807908541737007639-59cd1880.196ac7a92ad.-7e97</con2:id>
                                <con3:case>
                                    <con3:condition>
                                        <con2:xqueryText>fn:upper-case(fn:string($header/aut:ResponseHeader/successIndicator/text())) != "SUCCESS"
and
count($header/aut:ResponseHeader/messageId) = 0</con2:xqueryText>
