                        <con5:id xmlns:con5="http://www.bea.com/wli/sb/stages/config">_ActionId-8807908541737007639-59cd1880.196ac7a92ad.-7e15</con5:id>
                        <con4:expr>
                            <con5:xqueryText xmlns:con5="http://www.bea.com/wli/sb/stages/config">fn:string($fault/ctx:errorCode/text())</con5:xqueryText>
