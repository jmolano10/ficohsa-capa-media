    <con:router errorHandler="_onErrorHandler-8807908541737007639-59cd1880.196ac7a92ad.-7e90" xmlns:ser="http://www.bea.com/wli/sb/services" xmlns:tran="http://www.bea.com/wli/sb/transports" xmlns:env="http://www.bea.com/wli/config/env" xmlns:http="http://www.bea.com/wli/sb/transports/http" xmlns:con1="http://www.bea.com/wli/sb/stages/routing/config" xmlns:con2="http://www.bea.com/wli/sb/stages/config">
        <con:pipeline type="error" name="_onErrorHandler-8807908541737007639-59cd1880.196ac7a92ad.-7e90">
            <con:stage name="ManejoError">
