                        <con2:id>_ActionId-5656691700730765979-1f7bbe00.19683831b1c.-7d8f</con2:id>
                        <con3:expr>
                            <con2:xqueryText>let $typeOperation := data(($body/ret:retiroCuponTD/OPERATION | $body/ret:gestionCupon/TYPE))
return
	if ($operation = 'generarCuponRetiro') then
		'GENERACION CUPON'
	else if ($operation = 'retiroCuponTD' and $typeOperation = 'EXCHANGE') then
		'COBRO DE CUPON'
	else if ($operation = 'retiroCuponTD'and $typeOperation = 'REVERSE') then
		'REVERSA COBRO'
	else if ($operation = 'gestionCupon' and $typeOperation = 'APPLY') then
		'APLICACION CUPON'
	else if ($operation = 'gestionCupon' and $typeOperation = 'CANCEL') then
		'CANCELACION CUPON'
	else if ($operation = 'gestionCupon' and $typeOperation = 'EXPIRED') then
		'EXPIRACION CUPON'
	else if ($operation = 'notificaCuponPendiente') then
		'NOTIFICACION PENDIENTE'
	else
		'NO DEFINIDA'</con2:xqueryText>
