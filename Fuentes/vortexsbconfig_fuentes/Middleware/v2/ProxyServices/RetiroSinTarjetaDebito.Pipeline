return
if (string-length(normalize-space($ticketRetiro)) > 0) then
	$ticketRetiro
else
	'0000'</con2:xqueryText>
                        </con3:expr>
                    </con3:assign>
                    <con3:assign varName="uuid">
                        <con2:id>_ActionId-6589269004590814636--a68dcf9.19a30a4c04e.-79e9</con2:id>
