                            <con2:xqueryText>let $uuidTicket := data($body/ret:gestionCupon/TRANSACTION_ID | $body/ret:notificaCuponPendiente/TRANSACTION_ID)
return
	if (string-length(normalize-space($uuidTicket)) > 0 )then
		$uuidTicket
	else
		'0'</con2:xqueryText>
                        </con3:expr>
                    </con3:assign>
