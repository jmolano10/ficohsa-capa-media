            <con:stage name="ObtenerPuntos">
                <con:context>
                    <con1:varNsDecl namespace="http://www.ficohsa.com.hn/middleware.services/programaLealtadTypes" prefix="prog" xmlns:con1="http://www.bea.com/wli/sb/stages/config"/>
                    <con1:varNsDecl namespace="http://xmlns.oracle.com/pcbpel/adapter/db/sp/canjearPuntosEfectivo" prefix="can" xmlns:con1="http://www.bea.com/wli/sb/stages/config"/>
                </con:context>
                <con:actions>
                    <con1:ifThenElse xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-8977047900227999812-4a3f78f7.16b4c53ea3c.-73b8</con2:id>
                        <con1:case>
                            <con1:condition>
                                <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">$validationMessage != ""</con2:xqueryText>
                            </con1:condition>
                            <con1:actions/>
                        </con1:case>
                        <con1:case>
                            <con1:condition>
                                <con4:xqueryText xmlns:con4="http://www.bea.com/wli/sb/stages/config">fn:string($body/prog:redencionPuntosLealtad/REDEMPTION_TYPE/text()) = 'CASH' or fn:string($body/prog:redencionPuntosLealtad/REDEMPTION_TYPE/text()) = 'CONNECTMILES'</con4:xqueryText>
                            </con1:condition>
                            <con1:actions>
                                <con1:wsCallout>
                                    <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-8977047900227999812-4a3f78f7.16b4c53ea3c.-7380</con2:id>
                                    <con1:service xsi:type="ref:BusinessServiceRef" ref="Middleware/v2/BusinessServices/PXYNIC/canjearPuntosEfectivo/biz/canjearPuntosEfectivo_db" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
                                    <con1:operation>canjearPuntosEfectivo</con1:operation>
                                    <con1:request>
                                        <con1:body>REQcanjearPuntosEfectivo</con1:body>
                                    </con1:request>
                                    <con1:response>
                                        <con1:body>RSPcanjearPuntosEfectivo</con1:body>
                                    </con1:response>
                                    <con1:requestTransform>
                                        <con1:assign varName="REQcanjearPuntosEfectivo">
                                            <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-8977047900227999812-4a3f78f7.16b4c53ea3c.-7348</con2:id>
                                            <con1:expr>
                                                <con2:xqueryTransform xmlns:con2="http://www.bea.com/wli/sb/stages/config">
                                                    <con2:resource ref="Middleware/v2/Resources/ProgramaLealtad/xq/conversionPuntosNIIn"/>
                                                    <con2:param name="logo">
                                                        <con2:path>$logo</con2:path>
                                                    </con2:param>
                                                    <con2:param name="tipoConversion">
                                                        <con2:path>'2'</con2:path>
                                                    </con2:param>
                                                    <con2:param name="cashRedemptionType1">
                                                        <con2:path>$body/prog:redencionPuntosLealtad/CASH_REDEMPTION</con2:path>
                                                    </con2:param>
                                                    <con2:param name="montoConversion">
                                                        <con2:path>string($body/prog:redencionPuntosLealtad/REDEMPTION_AMOUNT/text())</con2:path>
                                                    </con2:param>
                                                </con2:xqueryTransform>
                                            </con1:expr>
                                        </con1:assign>
                                    </con1:requestTransform>
                                    <con1:responseTransform>
                                        <con1:assign varName="totalPoints">
                                            <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-8977047900227999812-4a3f78f7.16b4c53ea3c.-72d8</con2:id>
                                            <con1:expr>
                                                <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">string($RSPcanjearPuntosEfectivo/can:PN_VALORSALIDA/text())</con2:xqueryText>
                                            </con1:expr>
                                        </con1:assign>
                                        <con1:assign varName="errorCode">
                                            <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-8977047900227999812-4a3f78f7.16b4c53ea3c.-72bb</con2:id>
                                            <con1:expr>
                                                <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">fn:string($RSPcanjearPuntosEfectivo/can:PV_CODIGOMENSAJE/text())</con2:xqueryText>
                                            </con1:expr>
                                        </con1:assign>
                                        <con1:assign varName="validationMessage">
                                            <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-8977047900227999812-4a3f78f7.16b4c53ea3c.-729e</con2:id>
                                            <con1:expr>
                                                <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">fn:string($RSPcanjearPuntosEfectivo/can:PV_DESCRIPCIONMENSAJE/text())</con2:xqueryText>
                                            </con1:expr>
                                        </con1:assign>
                                    </con1:responseTransform>
                                </con1:wsCallout>
                            </con1:actions>
                        </con1:case>
                        <con1:default>
                            <con1:assign varName="totalPoints">
                                <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-8977047900227999812-4a3f78f7.16b4c53ea3c.-7266</con2:id>
                                <con1:expr>
                                    <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">string($body/prog:redencionPuntosLealtad/REDEMPTION_AMOUNT/text())</con2:xqueryText>
                                </con1:expr>
                            </con1:assign>
                        </con1:default>
                    </con1:ifThenElse>
                </con:actions>
            </con:stage>
            <con:stage name="ObtenerParametrizacion">
                <con:context>
                    <con1:varNsDecl namespace="http://www.ficohsa.com.hn/middleware.services/autType" prefix="aut" xmlns:con1="http://www.bea.com/wli/sb/stages/config"/>
                    <con1:varNsDecl namespace="http://xmlns.oracle.com/pcbpel/adapter/db/ORA_BANK/OSB_GET_CONFIG/" prefix="osb" xmlns:con1="http://www.bea.com/wli/sb/stages/config"/>
                </con:context>
                <con:actions>
                    <con1:ifThenElse xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-8977047900227999812-4a3f78f7.16b4c53ea3c.-71c2</con2:id>
                        <con1:case>
                            <con1:condition>
                                <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">$validationMessage = ''</con2:xqueryText>
                            </con1:condition>
                            <con1:actions>
                                <con1:ifThenElse>
                                    <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-8977047900227999812-4a3f78f7.16b4c53ea3c.-711e</con2:id>
                                    <con1:case>
                                        <con1:condition>
                                            <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">$programCode = '1' or $programCode = '2'</con2:xqueryText>
                                        </con1:condition>
                                        <con1:actions>
                                            <con1:wsCallout>
                                                <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-8977047900227999812-4a3f78f7.16b4c53ea3c.-70e6</con2:id>
                                                <con1:service xsi:type="ref:BusinessServiceRef" ref="Middleware/Business_Resources/general/Resources/ObtenerParametrizacion/ObtenerParametrizacion" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
                                                <con1:operation>obtenerParametrizacion</con1:operation>
                                                <con1:request>
                                                    <con1:body>REQobtenerParametrizacion</con1:body>
                                                </con1:request>
                                                <con1:response>
                                                    <con1:body>RSPobtenerParametrizacion</con1:body>
                                                </con1:response>
                                                <con1:requestTransform>
                                                    <con1:assign varName="matrixIdParameter">
                                                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-8977047900227999812-4a3f78f7.16b4c53ea3c.-70ae</con2:id>
                                                        <con1:expr>
                                                            <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">concat('FICBCO0229.MRS.MATRIXID.', 
	string($header/aut:RequestHeader/Region/SourceBank/text()))</con2:xqueryText>
                                                        </con1:expr>
                                                    </con1:assign>
                                                    <con1:assign varName="institutionNameParameter">
                                                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-8977047900227999812-4a3f78f7.16b4c53ea3c.-7074</con2:id>
                                                        <con1:expr>
                                                            <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">'FICBCO0229.MRS.INSTITUTION.NAME'</con2:xqueryText>
                                                        </con1:expr>
                                                    </con1:assign>
                                                    <con1:assign varName="rewardItemParameter">
                                                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-8977047900227999812-4a3f78f7.16b4c53ea3c.-6fe7</con2:id>
                                                        <con1:expr>
                                                            <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">concat('FICBCO0229.', 
	upper-case(string($header/aut:RequestHeader/Authentication/UserName/text())), '.REWARDITEM')</con2:xqueryText>
                                                        </con1:expr>
                                                    </con1:assign>
                                                    <con1:assign varName="activityClassificationParameter">
                                                        <con4:id xmlns:con4="http://www.bea.com/wli/sb/stages/config">_ActionId-762052883257721860-156078b.19bfb26ed23.-7fd7</con4:id>
                                                        <con1:expr>
                                                            <con4:xqueryText xmlns:con4="http://www.bea.com/wli/sb/stages/config">'FICBCO0229.COPA.ACTIVITYCLASSIFICATION'</con4:xqueryText>
                                                        </con1:expr>
                                                    </con1:assign>
                                                    <con1:assign varName="audienceParameter">
                                                        <con4:id xmlns:con4="http://www.bea.com/wli/sb/stages/config">_ActionId-762052883257721860-156078b.19bfb26ed23.-7fbf</con4:id>
                                                        <con1:expr>
                                                            <con4:xqueryText xmlns:con4="http://www.bea.com/wli/sb/stages/config">'FICBCO0229.COPA.AUDIENCE'</con4:xqueryText>
                                                        </con1:expr>
                                                    </con1:assign>
                                                    <con1:assign varName="channelIdParameter">
                                                        <con4:id xmlns:con4="http://www.bea.com/wli/sb/stages/config">_ActionId-762052883257721860-156078b.19bfb26ed23.-7fa1</con4:id>
                                                        <con1:expr>
                                                            <con4:xqueryText xmlns:con4="http://www.bea.com/wli/sb/stages/config">'FICBCO0229.COPA.CHANNELID'</con4:xqueryText>
                                                        </con1:expr>
                                                    </con1:assign>
                                                    <con1:assign varName="companyCodeParameter">
                                                        <con4:id xmlns:con4="http://www.bea.com/wli/sb/stages/config">_ActionId-762052883257721860-156078b.19bfb26ed23.-7f81</con4:id>
                                                        <con1:expr>
                                                            <con4:xqueryText xmlns:con4="http://www.bea.com/wli/sb/stages/config">'FICBCO0229.COPA.COMPANYCODE'</con4:xqueryText>
                                                        </con1:expr>
                                                    </con1:assign>
                                                    <con1:assign varName="explanationParameter">
                                                        <con4:id xmlns:con4="http://www.bea.com/wli/sb/stages/config">_ActionId-762052883257721860-156078b.19bfb26ed23.-7f66</con4:id>
                                                        <con1:expr>
                                                            <con4:xqueryText xmlns:con4="http://www.bea.com/wli/sb/stages/config">'FICBCO0229.COPA.EXPLANATION'</con4:xqueryText>
                                                        </con1:expr>
                                                    </con1:assign>
                                                    <con1:assign varName="grantTypeParameter">
                                                        <con4:id xmlns:con4="http://www.bea.com/wli/sb/stages/config">_ActionId-762052883257721860-156078b.19bfb26ed23.-7f4a</con4:id>
                                                        <con1:expr>
                                                            <con4:xqueryText xmlns:con4="http://www.bea.com/wli/sb/stages/config">'FICBCO0229.COPA.GRANTTYPE'</con4:xqueryText>
                                                        </con1:expr>
                                                    </con1:assign>
                                                    <con1:assign varName="languageParameter">
                                                        <con4:id xmlns:con4="http://www.bea.com/wli/sb/stages/config">_ActionId-762052883257721860-156078b.19bfb26ed23.-7f16</con4:id>
                                                        <con1:expr>
                                                            <con4:xqueryText xmlns:con4="http://www.bea.com/wli/sb/stages/config">'FICBCO0229.COPA.LANGUAGE'</con4:xqueryText>
                                                        </con1:expr>
                                                    </con1:assign>
                                                    <con1:assign varName="scopeParameter">
                                                        <con4:id xmlns:con4="http://www.bea.com/wli/sb/stages/config">_ActionId-762052883257721860-156078b.19bfb26ed23.-7efd</con4:id>
                                                        <con1:expr>
                                                            <con4:xqueryText xmlns:con4="http://www.bea.com/wli/sb/stages/config">'FICBCO0229.COPA.SCOPE'</con4:xqueryText>
                                                        </con1:expr>
                                                    </con1:assign>
                                                    <con1:assign varName="REQobtenerParametrizacion">
                                                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-8977047900227999812-4a3f78f7.16b4c53ea3c.-6fca</con2:id>
                                                        <con1:expr>
                                                            <con2:xqueryTransform xmlns:con2="http://www.bea.com/wli/sb/stages/config">
                                                                <con2:resource ref="Middleware/Business_Resources/general/Parametrizacion/obtenerParametrizacionIn"/>
                                                                <con2:param name="nombreParametros">
                                                                    <con2:path>concat($matrixIdParameter, '||', $institutionNameParameter, '||', $rewardItemParameter, '||', $activityClassificationParameter, '||', $audienceParameter, '||', $channelIdParameter, '||', $companyCodeParameter, '||', $explanationParameter, '||', $grantTypeParameter, '||', $languageParameter, '||', $scopeParameter)</con2:path>
                                                                </con2:param>
                                                            </con2:xqueryTransform>
                                                        </con1:expr>
                                                    </con1:assign>
                                                </con1:requestTransform>
                                                <con1:responseTransform>
                                                    <con1:assign varName="matrixId">
                                                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-8977047900227999812-4a3f78f7.16b4c53ea3c.-703c</con2:id>
                                                        <con1:expr>
                                                            <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">string($RSPobtenerParametrizacion/osb:CONFIGURACIONES/osb:CONFIGURACIONES_ITEM[ osb:NAME = $matrixIdParameter ]/osb:VALUE/text())</con2:xqueryText>
                                                        </con1:expr>
                                                    </con1:assign>
                                                    <con1:assign varName="institutionName">
                                                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-8977047900227999812-4a3f78f7.16b4c53ea3c.-701f</con2:id>
                                                        <con1:expr>
                                                            <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">string($RSPobtenerParametrizacion/osb:CONFIGURACIONES/osb:CONFIGURACIONES_ITEM[ osb:NAME = $institutionNameParameter ]/osb:VALUE/text())</con2:xqueryText>
                                                        </con1:expr>
                                                    </con1:assign>
                                                    <con1:assign varName="rewardItem">
                                                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-8977047900227999812-4a3f78f7.16b4c53ea3c.-6fad</con2:id>
                                                        <con1:expr>
                                                            <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">let $reward := fn:string($RSPobtenerParametrizacion/osb:CONFIGURACIONES/osb:CONFIGURACIONES_ITEM[ osb:NAME = $rewardItemParameter ]/osb:VALUE/text())
return
(
	if ($reward = '') then
		(  
			'CANJE POR SALESFORC'
		)else ($reward)
)</con2:xqueryText>
                                                        </con1:expr>
                                                    </con1:assign>
                                                    <con1:assign varName="activityClassification">
                                                        <con4:id xmlns:con4="http://www.bea.com/wli/sb/stages/config">_ActionId-762052883257721860-156078b.19bfb26ed23.-7eb6</con4:id>
                                                        <con1:expr>
                                                            <con4:xqueryText xmlns:con4="http://www.bea.com/wli/sb/stages/config">string($RSPobtenerParametrizacion/osb:CONFIGURACIONES/osb:CONFIGURACIONES_ITEM[ osb:NAME = $activityClassificationParameter ]/osb:VALUE/text())</con4:xqueryText>
                                                        </con1:expr>
                                                    </con1:assign>
                                                    <con1:assign varName="audience">
                                                        <con4:id xmlns:con4="http://www.bea.com/wli/sb/stages/config">_ActionId-762052883257721860-156078b.19bfb26ed23.-7e9a</con4:id>
                                                        <con1:expr>
                                                            <con4:xqueryText xmlns:con4="http://www.bea.com/wli/sb/stages/config">string($RSPobtenerParametrizacion/osb:CONFIGURACIONES/osb:CONFIGURACIONES_ITEM[ osb:NAME = $audienceParameter ]/osb:VALUE/text())</con4:xqueryText>
                                                        </con1:expr>
                                                    </con1:assign>
                                                    <con1:assign varName="channelId">
                                                        <con4:id xmlns:con4="http://www.bea.com/wli/sb/stages/config">_ActionId-762052883257721860-156078b.19bfb26ed23.-7e7e</con4:id>
                                                        <con1:expr>
                                                            <con4:xqueryText xmlns:con4="http://www.bea.com/wli/sb/stages/config">string($RSPobtenerParametrizacion/osb:CONFIGURACIONES/osb:CONFIGURACIONES_ITEM[ osb:NAME = $channelIdParameter ]/osb:VALUE/text())</con4:xqueryText>
                                                        </con1:expr>
                                                    </con1:assign>
                                                    <con1:assign varName="companyCode">
                                                        <con4:id xmlns:con4="http://www.bea.com/wli/sb/stages/config">_ActionId-762052883257721860-156078b.19bfb26ed23.-7e56</con4:id>
                                                        <con1:expr>
                                                            <con4:xqueryText xmlns:con4="http://www.bea.com/wli/sb/stages/config">string($RSPobtenerParametrizacion/osb:CONFIGURACIONES/osb:CONFIGURACIONES_ITEM[ osb:NAME = $companyCodeParameter ]/osb:VALUE/text())</con4:xqueryText>
                                                        </con1:expr>
                                                    </con1:assign>
                                                    <con1:assign varName="explanation">
                                                        <con4:id xmlns:con4="http://www.bea.com/wli/sb/stages/config">_ActionId-762052883257721860-156078b.19bfb26ed23.-7e2d</con4:id>
                                                        <con1:expr>
                                                            <con4:xqueryText xmlns:con4="http://www.bea.com/wli/sb/stages/config">string($RSPobtenerParametrizacion/osb:CONFIGURACIONES/osb:CONFIGURACIONES_ITEM[ osb:NAME = $explanationParameter ]/osb:VALUE/text())</con4:xqueryText>
                                                        </con1:expr>
                                                    </con1:assign>
                                                    <con1:assign varName="grantType">
                                                        <con4:id xmlns:con4="http://www.bea.com/wli/sb/stages/config">_ActionId-762052883257721860-156078b.19bfb26ed23.-7dea</con4:id>
                                                        <con1:expr>
                                                            <con4:xqueryText xmlns:con4="http://www.bea.com/wli/sb/stages/config">string($RSPobtenerParametrizacion/osb:CONFIGURACIONES/osb:CONFIGURACIONES_ITEM[ osb:NAME = $grantTypeParameter ]/osb:VALUE/text())</con4:xqueryText>
                                                        </con1:expr>
                                                    </con1:assign>
                                                    <con1:assign varName="language">
                                                        <con4:id xmlns:con4="http://www.bea.com/wli/sb/stages/config">_ActionId-762052883257721860-156078b.19bfb26ed23.-7dc9</con4:id>
                                                        <con1:expr>
                                                            <con4:xqueryText xmlns:con4="http://www.bea.com/wli/sb/stages/config">string($RSPobtenerParametrizacion/osb:CONFIGURACIONES/osb:CONFIGURACIONES_ITEM[ osb:NAME = $languageParameter ]/osb:VALUE/text())</con4:xqueryText>
                                                        </con1:expr>
                                                    </con1:assign>
                                                    <con1:assign varName="scope">
                                                        <con4:id xmlns:con4="http://www.bea.com/wli/sb/stages/config">_ActionId-762052883257721860-156078b.19bfb26ed23.-7da4</con4:id>
                                                        <con1:expr>
                                                            <con4:xqueryText xmlns:con4="http://www.bea.com/wli/sb/stages/config">string($RSPobtenerParametrizacion/osb:CONFIGURACIONES/osb:CONFIGURACIONES_ITEM[ osb:NAME = $scopeParameter ]/osb:VALUE/text())</con4:xqueryText>
                                                        </con1:expr>
                                                    </con1:assign>
                                                </con1:responseTransform>
                                            </con1:wsCallout>
                                        </con1:actions>
                                    </con1:case>
                                    <con1:default/>
                                </con1:ifThenElse>
                            </con1:actions>
                        </con1:case>
                        <con1:default/>
                    </con1:ifThenElse>
                </con:actions>
            </con:stage>
            <con:stage name="RedimirPuntos">
                <con:context>
                    <con1:varNsDecl namespace="http://redemption.ws.mcrewards.mastercard.com/" prefix="red" xmlns:con1="http://www.bea.com/wli/sb/stages/config"/>
                    <con4:varNsDecl namespace="http://www.procesa.com/fdcs" prefix="fdcs" xmlns:con4="http://www.bea.com/wli/sb/stages/config"/>
                </con:context>
                <con:actions>
                    <con1:ifThenElse xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-8977047900227999812-4a3f78f7.16b4c53ea3c.-6f09</con2:id>
                        <con1:case>
                            <con1:condition>
                                <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">$programCode = '2' and $rewardItem != ''</con2:xqueryText>
                            </con1:condition>
                            <con1:actions>
                                <con1:assign varName="serviceAccountOne">
                                    <con4:id xmlns:con4="http://www.bea.com/wli/sb/stages/config">_ActionId-762052883257721860-156078b.19bfb26ed23.-7d0e</con4:id>
                                    <con1:expr>
                                        <con4:xqueryText xmlns:con4="http://www.bea.com/wli/sb/stages/config">'COPAMILES'</con4:xqueryText>
                                    </con1:expr>
                                </con1:assign>
                                <con1:assign varName="clientId">
                                    <con4:id xmlns:con4="http://www.bea.com/wli/sb/stages/config">_ActionId-762052883257721860-156078b.19bfb26ed23.-7ceb</con4:id>
                                    <con1:expr>
                                        <con4:xqueryTransform xmlns:con4="http://www.bea.com/wli/sb/stages/config">
                                            <con4:resource ref="Middleware/Business_Resources/general/Credenciales/consultaUsernameServiceAccount"/>
                                            <con4:param name="serviceAccountName">
                                                <con4:path>$serviceAccountOne</con4:path>
                                            </con4:param>
                                        </con4:xqueryTransform>
                                    </con1:expr>
                                </con1:assign>
                                <con1:assign varName="clientSecret">
                                    <con4:id xmlns:con4="http://www.bea.com/wli/sb/stages/config">_ActionId-762052883257721860-156078b.19bfb26ed23.-7ccf</con4:id>
                                    <con1:expr>
                                        <con4:xqueryTransform xmlns:con4="http://www.bea.com/wli/sb/stages/config">
                                            <con4:resource ref="Middleware/Business_Resources/general/Credenciales/consultaPasswordServiceAccount"/>
                                            <con4:param name="serviceAccountName">
                                                <con4:path>$serviceAccountOne</con4:path>
                                            </con4:param>
                                        </con4:xqueryTransform>
                                    </con1:expr>
                                </con1:assign>
                                <con1:assign varName="serviceAccountTwo">
                                    <con4:id xmlns:con4="http://www.bea.com/wli/sb/stages/config">_ActionId-762052883257721860-156078b.19bfb26ed23.-7cf9</con4:id>
                                    <con1:expr>
                                        <con4:xqueryText xmlns:con4="http://www.bea.com/wli/sb/stages/config">'COPAMILESSUBSCRIPTIONKEY'</con4:xqueryText>
                                    </con1:expr>
                                </con1:assign>
                                <con1:assign varName="usernameTwo">
                                    <con4:id xmlns:con4="http://www.bea.com/wli/sb/stages/config">_ActionId-762052883257721860-156078b.19bfb26ed23.-7cac</con4:id>
                                    <con1:expr>
                                        <con4:xqueryTransform xmlns:con4="http://www.bea.com/wli/sb/stages/config">
                                            <con4:resource ref="Middleware/Business_Resources/general/Credenciales/consultaUsernameServiceAccount"/>
                                            <con4:param name="serviceAccountName">
                                                <con4:path>$serviceAccountTwo</con4:path>
                                            </con4:param>
                                        </con4:xqueryTransform>
                                    </con1:expr>
                                </con1:assign>
                                <con1:assign varName="ocpApimSubscriptionKey">
                                    <con4:id xmlns:con4="http://www.bea.com/wli/sb/stages/config">_ActionId-762052883257721860-156078b.19bfb26ed23.-7c96</con4:id>
                                    <con1:expr>
                                        <con4:xqueryTransform xmlns:con4="http://www.bea.com/wli/sb/stages/config">
                                            <con4:resource ref="Middleware/Business_Resources/general/Credenciales/consultaPasswordServiceAccount"/>
                                            <con4:param name="serviceAccountName">
                                                <con4:path>$serviceAccountTwo</con4:path>
                                            </con4:param>
                                        </con4:xqueryTransform>
                                    </con1:expr>
