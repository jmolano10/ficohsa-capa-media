                        <con4:id xmlns:con4="http://www.bea.com/wli/sb/stages/config">_ActionId-4850140205375469334--51843b82.16b5102ac83.-7eea</con4:id>
                        <con1:expr>
                            <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">let $customerIdType := string($body/prog:redencionPuntosLealtad/CUSTOMER_ID_TYPE/text())
return
	if($validationMessage != '') then(
        
        $validationMessage
    ) else if($customerIdType != 'CARD_NUMBER') then(
        
        'CUSTOMER_ID_TYPE no soportado'
    )else ('')</con2:xqueryText>
