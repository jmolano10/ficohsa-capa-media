                                                        <con1:expr>
                                                            <con2:xqueryText>let $errorCode := fn:upper-case(fn:string($RSPPayCashPickUpOrder/ria:Response/ria:ResponseCode/text()))
return
  if($errorCode = '1000') then(
        'SUCCESS'
  )else(
        fn:concat("RIA-PAY-", $errorCode)
  )</con2:xqueryText>
