                                                            <con2:xqueryText>let $errorMessage := fn:string($RSPPayCashPickUpOrder/ria:Response/ria:ResponseText/text())
return
if($errorCode = 'SUCCESS') then(
    ''
)else(
        fn:substring(fn:concat('Error en RIA: ', $errorMessage), 1, 500)
)</con2:xqueryText>
