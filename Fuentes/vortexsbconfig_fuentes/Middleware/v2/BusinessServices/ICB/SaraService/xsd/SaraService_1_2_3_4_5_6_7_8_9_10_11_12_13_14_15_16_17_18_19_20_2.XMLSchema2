    <con:schema><![CDATA[<xs:schema elementFormDefault="qualified" targetNamespace="urn:infocorp.framework.common.datacontracts" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:tns="urn:infocorp.framework.common.datacontracts" xmlns:ser="http://schemas.microsoft.com/2003/10/Serialization/">
