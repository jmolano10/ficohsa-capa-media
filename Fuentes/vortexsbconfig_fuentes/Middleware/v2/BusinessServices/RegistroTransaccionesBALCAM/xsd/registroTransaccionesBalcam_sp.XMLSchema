    <con:schema><![CDATA[<schema targetNamespace="http://xmlns.oracle.com/pcbpel/adapter/db/sp/registroTransaccionesBalcam" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:db="http://xmlns.oracle.com/pcbpel/adapter/db/sp/registroTransaccionesBalcam" elementFormDefault="qualified">
   <element name="InputParameters">
