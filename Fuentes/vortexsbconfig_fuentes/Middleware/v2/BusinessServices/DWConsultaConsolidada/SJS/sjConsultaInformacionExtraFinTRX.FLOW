                    </trf:expr>
                </trf:assign>
            </bpel:extensionAssignOperation>
        </bpel:assign>
        <bpel:flow>
            <bpel:scope>
                <bpel:faultHandlers>
                    <bpel:catch faultName="tns:userFault">
                        <bpel:sequence>
