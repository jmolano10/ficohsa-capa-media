        <bpel:partnerLink name="integracionConsultaTrxPrestamos_db"
                          partnerLinkType="tns:integracionConsultaTrxPrestamos_db"
                          partnerRole="integracionConsultaTrxPrestamos_db"/>
        <bpel:partnerLink name="integracionConsultaTrxPasivos_db" partnerLinkType="tns:integracionConsultaTrxPasivos_db"
