                                        <trf:expr>
                                            <expr:xqueryText>&lt;ns2:RSPintegracionConsultaTrxPrestamos/&gt;</expr:xqueryText>
                                        </trf:expr>
                                    </trf:replace>
                                </bpel:extensionAssignOperation>
                            </bpel:assign>
                        </bpel:sequence>
                    </bpel:catch>
                </bpel:faultHandlers>
                <bpel:sequence>
                    <bpel:assign>
                        <bpel:extensionAssignOperation>
                            <trf:assign varName="REQintegracionConsultaTrxPrestamos.InputParameters">
                                <trf:expr>
                                    <expr:xqueryTransform>
                                        <expr:resource ref="Middleware/v2/Resources/ConsultaConsolidadaRiesgoCliente/xq/integracionConsultaTrxPrestamosIn"/>
                                        <expr:param name="identidad">
                                            <expr:path>$identidadSJExtraFin</expr:path>
                                        </expr:param>
                                        <expr:param name="pais">
                                            <expr:path>$pais</expr:path>
                                        </expr:param>
                                    </expr:xqueryTransform>
                                </trf:expr>
                            </trf:assign>
                        </bpel:extensionAssignOperation>
                    </bpel:assign>
                    <bpel:invoke partnerLink="integracionConsultaTrxPrestamos_db"
