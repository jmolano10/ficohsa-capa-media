                            <expr:param name="InputIntegrationConsultaTrxPrestamos">
                                <expr:path>$RSPintegracionConsultaTrxPrestamos.OutputParameters</expr:path>
                            </expr:param>
                            <expr:param name="InputIntegrationTrxTarjeta">
                                <expr:path>$RSPintegracionConsultaTrxTarjetas.OutputParameters</expr:path>
                            </expr:param>
                            <expr:param name="InputIntegrationConsultaTrxPasivo">
                                <expr:path>$RSPintegracionConsultaTrxPasivo.OutputParameters</expr:path>
                            </expr:param>
                            <expr:param name="InputIntegrationConsultaExtraFin">
                                <expr:path>$RSPintegracionConsultaExtraFin.OutputParameters</expr:path>
                            </expr:param>
                        </expr:xqueryTransform>
                    </trf:expr>
                </trf:assign>
            </bpel:extensionAssignOperation>
