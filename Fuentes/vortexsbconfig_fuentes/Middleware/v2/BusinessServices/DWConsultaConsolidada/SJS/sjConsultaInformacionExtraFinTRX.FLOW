                                        <expr:param name="identidad">
                                            <expr:path>$identidadSJExtraFin</expr:path>
                                        </expr:param>
                                        <expr:param name="pais">
                                            <expr:path>$pais</expr:path>
                                        </expr:param>
                                    </expr:xqueryTransform>
                                </trf:expr>
                            </trf:assign>
