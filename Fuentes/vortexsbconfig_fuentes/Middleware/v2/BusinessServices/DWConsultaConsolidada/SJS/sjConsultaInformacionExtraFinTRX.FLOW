        <bpel:partnerLink name="integracionConsultaExtraFin_db" partnerLinkType="tns:integracionConsultaExtraFin_db"
                          partnerRole="integracionConsultaExtraFin_db"/>
    </bpel:partnerLinks>

	   <bpel:variables>
        <bpel:variable name="request"
	                      messageType="bind:consultaConsolidadaRiesgoClienteRequest">
	       </bpel:variable>
	       <bpel:variable name="response"
                       messageType="bind:consultaConsolidadaRiesgoClienteResponse">
	       </bpel:variable>
        <bpel:variable name="pais" type="xsd:string"/>
        <bpel:variable name="identidadSJExtraFin" type="xsd:string"/>
        <bpel:variable name="REQintegracionConsultaTrxTarjetas" messageType="ns1:args_in_msg"/>
        <bpel:variable name="RSPintegracionConsultaTrxTarjetas" messageType="ns1:args_out_msg"/>
        <bpel:variable name="REQintegracionConsultaTrxPrestamos" messageType="ns2:args_in_msg"/>
        <bpel:variable name="RSPintegracionConsultaTrxPrestamos" messageType="ns2:args_out_msg"/>
        <bpel:variable name="REQintegracionConsultaTrxPasivo" messageType="ns3:args_in_msg"/>
        <bpel:variable name="RSPintegracionConsultaTrxPasivo" messageType="ns3:args_out_msg"/>
        <bpel:variable name="REQintegracionConsultaExtraFin" messageType="ns4:args_in_msg"/>
        <bpel:variable name="RSPintegracionConsultaExtraFin" messageType="ns4:args_out_msg"/>
    </bpel:variables>

    <bpel:sequence>
        <bpel:receive partnerLink="sjConsultaInformacionExtraFinTRX" operation="consultaConsolidadaRiesgoCliente" createInstance="yes"
