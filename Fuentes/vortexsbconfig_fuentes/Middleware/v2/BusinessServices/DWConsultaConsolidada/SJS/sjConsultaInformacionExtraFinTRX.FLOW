                    </bpel:catch>
                </bpel:faultHandlers>
                <bpel:sequence>
                    <bpel:assign>
                        <bpel:extensionAssignOperation>
                            <trf:assign varName="REQintegracionConsultaTrxPasivo.InputParameters">
                                <trf:expr>
