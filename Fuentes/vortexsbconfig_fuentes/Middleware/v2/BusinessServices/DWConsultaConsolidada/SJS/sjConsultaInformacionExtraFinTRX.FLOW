                            </bpel:assign>
                        </bpel:sequence>
                    </bpel:catch>
                </bpel:faultHandlers>
                <bpel:sequence>
                    <bpel:assign>
                        <bpel:extensionAssignOperation>
                            <trf:assign varName="REQintegracionConsultaExtraFin.InputParameters">
