                <bpel:sequence>
                    <bpel:assign>
                        <bpel:extensionAssignOperation>
                            <trf:assign varName="REQintegracionConsultaTrxTarjetas.InputParameters">
                                <trf:expr>
                                    <expr:xqueryTransform>
                                        <expr:resource ref="Middleware/v2/Resources/ConsultaConsolidadaRiesgoCliente/xq/integracionConsultaTrxTarjetasIn"/>
