                <rescon:wsdl ref="Middleware/v2/BusinessServices/DWConsultaConsolidada/SJS/wsdl/sjConsultaConsolidadaRiesgoClienteHN" binding="bind:consultaConsolidadaRiesgoClientePSSOAP"/>
            </rescon:receiveInfo>
        </bpel:receive>
        <bpel:assign>
            <bpel:extensionAssignOperation>
                <trf:assign varName="pais">
                    <trf:expr>
                        <expr:xqueryText>'HN'</expr:xqueryText>
