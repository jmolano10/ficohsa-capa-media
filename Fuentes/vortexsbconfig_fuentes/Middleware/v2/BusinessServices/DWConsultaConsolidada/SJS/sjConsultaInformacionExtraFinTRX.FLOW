        <bpel:reply partnerLink="sjConsultaInformacionExtraFinTRX" operation="consultaConsolidadaRiesgoCliente"
                    variable="response"></bpel:reply>
    </bpel:sequence>
</bpel:process>]]></con:flow>
    <oper:operations/>
</con:flowEntry>