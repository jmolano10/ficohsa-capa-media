              xmlns:ns2="http://xmlns.oracle.com/pcbpel/adapter/db/ApplicationTest/INTEGRACION_CONSULTA_TRX_PRESTAMOS/integracionConsultaTrxPrestamos"
              xmlns:ns3="http://xmlns.oracle.com/pcbpel/adapter/db/ApplicationTest/INTEGRACION_CONSULTA_TRX_PASIVOS/integracionConsultaTrxPasivos"
              xmlns:ns4="http://xmlns.oracle.com/pcbpel/adapter/db/Application1/Project4/integracionConsultaExtraFin">
    <rescon:importInfo>
        <rescon:wsdl-import ref="Middleware/v2/BusinessServices/DWConsultaConsolidada/integracionConsultaTrxTarjetas/wsdl/integracionConsultaTrxTarjetas"/>
        <rescon:wsdl-import ref="Middleware/v2/BusinessServices/DWConsultaConsolidada/integracionConsultaTrxPrestamos/wsdl/integracionConsultaTrxPrestamos"/>
        <rescon:wsdl-import ref="Middleware/v2/BusinessServices/DWConsultaConsolidada/integracionConsultaTrxPasivos/wsdl/integracionConsultaTrxPasivos"/>
        <rescon:wsdl-import ref="Middleware/v2/BusinessServices/DWConsultaConsolidada/integracionConsultaExtraFin/wsdl/integracionConsultaExtraFin"/>
    </rescon:importInfo>
    <bpel:partnerLinks>
        <bpel:partnerLink name="sjConsultaInformacionExtraFinTRX" partnerLinkType="tns:sjConsultaInformacionExtraFinTRX"
