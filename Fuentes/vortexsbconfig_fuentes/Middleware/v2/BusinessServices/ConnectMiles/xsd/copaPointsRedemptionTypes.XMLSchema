<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:tns="http://copa.com/osb/redemption" targetNamespace="http://copa.com/osb/redemption" elementFormDefault="qualified">

    <xsd:element name="copaPointsRedemptionResponseHeader">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="messageId" type="xsd:string" minOccurs="0"/>
                <xsd:element name="successIndicator" type="xsd:string"/>
                <xsd:element name="messages" type="xsd:string" minOccurs="0"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="copaPointsRedemptionRequest">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="COMPANY_CODE" type="xsd:string"/>
                <xsd:element name="FREQUENT_FLYER_ID" type="xsd:string"/>

                <xsd:element name="COPA_LANGUAGE" type="xsd:string"/>
                <xsd:element name="COPA_CHANNEL_ID" type="xsd:string"/>
                <xsd:element name="AUTHORIZATION" type="xsd:string"/>
                <xsd:element name="OCP_APIM_SUBSCRIPTION_KEY" type="xsd:string"/>

                <xsd:element name="FIRST_NAME" type="xsd:string"/>
                <xsd:element name="SUR_NAME" type="xsd:string"/>

                <xsd:element name="AWARD_MILES" type="xsd:string"/>
                <xsd:element name="ACTIVITY_DATE" type="xsd:string"/>
                <xsd:element name="EXPLANATION" type="xsd:string"/>
                <xsd:element name="ACTIVITY_CLASSIFICATION" type="xsd:string"/>
                <xsd:element name="TRANSACTION_PARTNER_ID" type="xsd:string"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:element name="copaPointsRedemptionResponse">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="LOYALTY_ID" type="xsd:string" minOccurs="0"/>
                <xsd:element name="RESULT_PROCES" type="xsd:string" minOccurs="0"/>
                <xsd:element name="MESSAGE_CODE" type="xsd:string" minOccurs="0"/>
                <xsd:element name="MESSAGE_DESCRIPTION" type="xsd:string" minOccurs="0"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

</xsd:schema>]]></con:schema>
    <con:targetNamespace>http://copa.com/osb/redemption</con:targetNamespace>
</con:schemaEntry>