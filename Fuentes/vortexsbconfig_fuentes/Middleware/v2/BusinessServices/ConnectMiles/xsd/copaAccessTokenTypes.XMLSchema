<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" targetNamespace="http://copa.com/osb/accesstoken"
  xmlns:tns="http://copa.com/osb/accesstoken" elementFormDefault="qualified">

  <xsd:element name="copaAccessTokenRequest">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="AUDIENCE" type="xsd:string"/>
        <xsd:element name="SCOPE" type="xsd:string"/>
        <xsd:element name="GRANT_TYPE" type="xsd:string"/>
        <xsd:element name="CLIENT_ID" type="xsd:string"/>
        <xsd:element name="CLIENT_SECRET" type="xsd:string"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>

  <xsd:element name="copaAccessTokenResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="ACCESS_TOKEN" type="xsd:string"/>
        <xsd:element name="TOKEN_TYPE" type="xsd:string"/>
        <xsd:element name="EXPIRES_IN" type="xsd:int"/>
        <xsd:element name="SCOPE" type="xsd:string"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>

  <!-- Response Header -->
  <xsd:element name="CopaResponseHeader">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="messageId" type="xsd:string" minOccurs="0"/>
        <xsd:element name="successIndicator" type="xsd:string"/>
        <xsd:element name="messages" type="xsd:string" minOccurs="0"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>

</xsd:schema>]]></con:schema>
    <con:targetNamespace>http://copa.com/osb/accesstoken</con:targetNamespace>
</con:schemaEntry>