<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  xmlns:tns="http://copa.com/osb/userprofile" targetNamespace="http://copa.com/osb/userprofile" elementFormDefault="qualified">

  <!-- Request -->
  <xsd:element name="copaUserProfileRequest">
    <xsd:complexType>
      <xsd:sequence>
        <!-- Query param -->
        <xsd:element name="MEMBERSHIP_ID" type="xsd:string"/>

        <!-- REST headers (passed via SOAP body) -->
        <xsd:element name="COPA_CHANNEL_ID" type="xsd:string"/>
        <xsd:element name="AUTHORIZATION" type="xsd:string"/>
        <xsd:element name="OCP_APIM_SUBSCRIPTION_KEY" type="xsd:string"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>

  <!-- Response -->
  <xsd:element name="copaUserProfileResponse">
    <xsd:complexType>
      <xsd:sequence>
        <!-- Core customer data -->
        <xsd:element name="BIRTH_DATE" type="xsd:string" minOccurs="0"/>
        <xsd:element name="GIVEN_NAME" type="xsd:string" minOccurs="0"/>
        <xsd:element name="SURNAME" type="xsd:string" minOccurs="0"/>
        <xsd:element name="LOYALTY_ID" type="xsd:string" minOccurs="0"/>
        <xsd:element name="BALANCE" type="xsd:string" minOccurs="0"/>

        <!-- Convenience fields -->
        <xsd:element name="FULL_NAME" type="xsd:string" minOccurs="0"/>
        <xsd:element name="RAW_RESPONSE" type="xsd:string" minOccurs="0"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>

  <!-- Response Header -->
  <xsd:element name="CopaResponseHeader">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="messageId" type="xsd:string" minOccurs="0"/>
        <xsd:element name="successIndicator" type="xsd:string"/>
        <xsd:element name="messages" type="xsd:string" minOccurs="0"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>

</xsd:schema>]]></con:schema>
    <con:targetNamespace>http://copa.com/osb/userprofile</con:targetNamespace>
</con:schemaEntry>