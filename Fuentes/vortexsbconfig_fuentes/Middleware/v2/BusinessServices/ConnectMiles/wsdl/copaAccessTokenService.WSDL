<?xml version="1.0" encoding="UTF-8"?>
<con:wsdlEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:wsdl><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:tns="http://copa.com/osb/accesstoken"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema" name="CopaAccessTokenService" targetNamespace="http://copa.com/osb/accesstoken">

    <types>
        <xsd:schema targetNamespace="http://copa.com/osb/accesstoken" elementFormDefault="qualified">

            <xsd:include schemaLocation="../xsd/copaAccessTokenTypes.xsd"/>
        </xsd:schema>
    </types>

    <message name="CopaAccessTokenRequestMessage">
