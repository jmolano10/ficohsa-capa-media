<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<xs:schema targetNamespace="http://www.ficohsa.com.hn/middleware.services/IdentityProtectionTypes" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:kvp="http://www.ficohsa.com.hn/middleware.services/kvpType" xmlns:tns="http://www.ficohsa.com.hn/middleware.services/IdentityProtectionTypes">

	
	<xs:import namespace="http://www.ficohsa.com.hn/middleware.services/kvpType" schemaLocation="../../../Resources/esquemas_generales/KeyValuePair.xsd"/>	
	<xs:complexType name="IdentityProtectionRequest">
	<xs:sequence>
	        <xs:element name="OPERATION_NAME" type="xs:string"/>
			<xs:element name="ACTION" type="xs:string"/>
			<xs:element name="KVPAIRS" type="kvp:UnboundKvPair" minOccurs="0" maxOccurs="1"/>			
    </xs:sequence>
	</xs:complexType>
	
	<xs:complexType name="IdentityProtectionResponse">
		<xs:sequence>			
		</xs:sequence>
	</xs:complexType>
	
	<xs:element name="IdentityProtectionRequest" type="tns:IdentityProtectionRequest"/>

	<xs:element name="IdentityProtectionResponse" type="tns:IdentityProtectionResponse"/>
</xs:schema>]]></con:schema>
    <con:dependencies>
        <con:import namespace="http://www.ficohsa.com.hn/middleware.services/kvpType" schemaLocation="../../../Resources/esquemas_generales/KeyValuePair.xsd" ref="Middleware/v2/Resources/esquemas_generales/KeyValuePair"/>
    </con:dependencies>
    <con:targetNamespace>http://www.ficohsa.com.hn/middleware.services/IdentityProtectionTypes</con:targetNamespace>
</con:schemaEntry>