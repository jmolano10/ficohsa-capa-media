<?xml version="1.0" encoding="UTF-8"?>
<con:jcaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:jca><![CDATA[<adapter-config name="readWebServicesKeyStore" adapter="FTP Adapter" wsdlLocation="../wsdl/readWebServicesKeyStore.wsdl" xmlns="http://platform.integration.oracle/blocks/adapter/fw/metadata">
  
  <connection-factory location="eis/Ftp/ConnectionReadKeyStore"/>
  <endpoint-interaction portType="readKeyStore_ptt" operation="readKeyStore">
    <interaction-spec className="oracle.tip.adapter.ftp.outbound.FTPReadInteractionSpec">
      <property name="DeleteFile" value="true"/>
      <property name="PhysicalDirectory" value="/home/oracle/"/>
      <property name="FileName" value="webServices.jks"/>
      <property name="FileType" value="ascii"/>
    </interaction-spec>
  </endpoint-interaction>

</adapter-config>]]></con:jca>
    <con:jcaDependency>
        <con:wsdlRef wsdlLocation="../wsdl/readWebServicesKeyStore.wsdl" ref="Middleware/v2/BusinessServices/FTP/readWebServicesKeyStore/wsdl/readWebServicesKeyStore"/>
    </con:jcaDependency>
</con:jcaEntry>