<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.ficohsa.com.hn/middleware.services/sjConsultaMultipleRemesadorasNI" xmlns:cons="http://www.ficohsa.com.hn/middleware.services/sjConsultaMultipleRemesadorasNI" elementFormDefault="qualified" >
	<xs:element name="sjConsultaMultipleRemesadorasNI">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="REMITTANCE_ID" type="xs:string" minOccurs="0"/>
				<xs:element name="CORRESPONSAL_BRANCHCODE" type="xs:string" minOccurs="0"/>
				<xs:element name="BENEFICIARY_FIRSTNAME" type="xs:string" minOccurs="0"/>
				<xs:element name="BENEFICIARY_MIDDLENAME" type="xs:string" minOccurs="0"/>
				<xs:element name="BENEFICIARY_FIRSTSURNAME" type="xs:string" minOccurs="0"/>
				<xs:element name="BENEFICIARY_AMOUNT" type="xs:string" minOccurs="0"/>
					<xs:element name="REMITTANCE_TYPES" minOccurs="0">
						<xs:complexType>
							<xs:sequence>
								<xs:element name="REMITTANCE_TYPES_ITEM " minOccurs="0" maxOccurs="unbounded">
									<xs:complexType>
										<xs:sequence>
											<xs:element name="REMITTANCE_NAME" type="xs:string" minOccurs="0"/>
									        <xs:element name="REMITTANCE_TYPE" type="xs:string" minOccurs="0"/>
									        <xs:element name="AGREEMENT_ID" type="xs:decimal" minOccurs="0"/>
									        <xs:element name="AGREEMENT_ID_T24" type="xs:string" minOccurs="0"/>
									        <xs:element name="REMITTANCE_ABBREVIATION" type="xs:string" minOccurs="0"/>
									        <xs:element name="PRIORITY" type="xs:decimal" minOccurs="0" nillable="true"/>
										</xs:sequence>
									</xs:complexType>
								</xs:element>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
			<xs:element name="ADDITIONAL_INFO" minOccurs="0" maxOccurs="1">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="INFO" minOccurs="0" maxOccurs="unbounded">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="NAME" type="xs:string" minOccurs="0" />
										<xs:element name="VALUE" type="xs:string" minOccurs="0" />
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	
	<xs:element name="sjConsultaMultipleRemesadorasNIResponse">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="SUCCESS_INDICATOR" type="xs:string" minOccurs="0" />
				<xs:element name="ERROR_MESSAGE" type="xs:string" minOccurs="0" />
				<xs:element name="REMITTANCE" minOccurs="0">
					<xs:complexType>
							<xs:sequence>
								<xs:element name="ROUTER_RESPONSE" minOccurs="0" >
									<xs:complexType>
										<xs:sequence>
											<xs:element name="REMITTANCE_ID" type="xs:string" minOccurs="0"/>
											<xs:element name="REMITTER_NAME" type="xs:string" minOccurs="0"/>
									        <xs:element name="AGREEMENT_ID" type="xs:decimal" minOccurs="0"/>
									        <xs:element name="REMITTANCE_TYPE" type="xs:string" minOccurs="0"/>
									        <xs:element name="REMITTANCE_NAME" type="xs:string" minOccurs="0"/>
									        <xs:element name="REMITTANCE_ABBREVIATION" type="xs:string" minOccurs="0"/>
									        <xs:element name="PRIORITY" type="xs:decimal" minOccurs="0" nillable="true"/>
									        <xs:element name="BENEFICIARY_NAME" type="xs:string" minOccurs="0"/>
											<xs:element name="BRANCH_NAME" type="xs:string" minOccurs="0"/>
						                    <xs:element name="PAYMENT_DATE" type="xs:string" minOccurs="0"/>
						                    <xs:element name="REMITTANCE_DATE" type="xs:string" minOccurs="0"/>
						                    <xs:element name="CURRENCY" type="xs:string" minOccurs="0"/>
						                    <xs:element name="EXCHANGE_RATE" type="xs:string" minOccurs="0"/>
						                    <xs:element name="REMITTANCE_STATUS" type="xs:string" minOccurs="0"/>
						                    <xs:element name="REMITTANCE_AMOUNT" type="xs:string" minOccurs="0"/>
						                    <xs:element name="REMITTANCE_SOURCE_AMOUNT" type="xs:string" minOccurs="0"/>
						                    <xs:element name="ORIGIN_COUNTRY" type="xs:string" minOccurs="0"/>
						                    <xs:element name="TRANSACTION_ID" type="xs:string" minOccurs="0"/>
						                    <xs:element name="ORDER_ID" type="xs:string" minOccurs="0"/>
						                    <xs:element name="TRANSMITTERCODE" type="xs:string" minOccurs="0"/>
										</xs:sequence>
									</xs:complexType>
								</xs:element>
							</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	
</xs:schema>]]></con:schema>
    <con:targetNamespace>http://www.ficohsa.com.hn/middleware.services/sjConsultaMultipleRemesadorasNI</con:targetNamespace>
</con:schemaEntry>