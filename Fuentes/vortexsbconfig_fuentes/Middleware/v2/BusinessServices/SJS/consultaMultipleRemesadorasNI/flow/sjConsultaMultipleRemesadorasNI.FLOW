<?xml version="1.0" encoding="UTF-8"?>
<con:flowEntry xmlns:con="http://www.bea.com/alsb/flow/resources/config" xmlns:oper="http://xmlns.oracle.com/servicebus/flow/operations">
    <con:flow><![CDATA[<bpel:process name="sjConsultaMultipleRemesadorasNI" targetNamespace="http://www.example.com/flow/Middleware/v2/BusinessServices/SJS/consultaMultipleRemesadorasNI/flow/sjConsultaMultipleRemesadorasNI" bea:name="sjConsultaMultipleRemesadorasNI" xmlns:tns="http://www.example.com/flow/Middleware/v2/BusinessServices/SJS/consultaMultipleRemesadorasNI/flow/sjConsultaMultipleRemesadorasNI" xmlns:bpel="http://docs.oasis-open.org/wsbpel/2.0/process/executable" xmlns:rescon="http://www.bea.com/alsb/flow/resources/config" xmlns:bea="http://www.bea.com/bpel/ui/extensions" xmlns:ext="http://www.bea.com/bpel/extensions" xmlns:expr="http://www.bea.com/wli/sb/stages/config" xmlns:trf="http://www.bea.com/wli/sb/stages/transform/config" xmlns:bind="http://www.ficohsa.com.hn/middleware.services/sjConsultaMultipleRemesadorasNI" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:sj="http://www.ficohsa.com.hn/middleware.services/sjConsultaMultipleRemesadorasNI" xmlns:ns1="http://xmlns.oracle.com/pcbpel/adapter/db/InterbancaSOAApplication/ObtenerParametrizacion/obtenerParametrizacion" xmlns:ns0="http://www.ficohsa.com.hn/middleware.services/riaMoneyTransferPS" xmlns:osb="http://xmlns.oracle.com/pcbpel/adapter/db/ORA_BANK/OSB_GET_CONFIG/" xmlns:riam="http://www.ficohsa.com.hn/middleware.services/riaMoneyTransferTypes">
    <bpel:partnerLinks>
        <bpel:partnerLink name="sjConsultaMultipleRemesadorasNI" partnerLinkType="tns:sjConsultaMultipleRemesadorasNI" myRole="sjConsultaMultipleRemesadorasNI">
	       </bpel:partnerLink>
	   <bpel:partnerLink name="ObtenerParametrizacion" partnerLinkType="tns:ObtenerParametrizacion_plnkType" partnerRole="ObtenerParametrizacion_PartnerRole">
	   </bpel:partnerLink>
	   <bpel:partnerLink name="searchCashPickUpOrder" partnerLinkType="tns:searchCashPickUpOrder_plnkType" partnerRole="searchCashPickUpOrder_PartnerRole">
	   </bpel:partnerLink></bpel:partnerLinks>

	   <bpel:variables>
        <bpel:variable name="request" messageType="bind:sjConsultaMultipleRemesadorasNI">
	       </bpel:variable>
	       <bpel:variable name="response" messageType="bind:sjConsultaMultipleRemesadorasNIResponse">
	       </bpel:variable>
    <bpel:variable name="resultGroup" type="xsd:anyType"/></bpel:variables>

    <bpel:sequence>
        <bpel:receive partnerLink="sjConsultaMultipleRemesadorasNI" operation="consultaRemesadoras" variable="request" createInstance="yes">
	           <rescon:receiveInfo>
                
            <rescon:wsdl ref="Middleware/v2/BusinessServices/SJS/consultaMultipleRemesadorasNI/wsdl/sjConsultaMultipleRemesadorasNI" binding="bind:sjConsultaMultipleRemesadorasNISOAP"/></rescon:receiveInfo>
        </bpel:receive>
        <bpel:scope>
        	<bpel:sequence>
        		<bpel:assign>
        			<bpel:extensionAssignOperation>
        				<trf:assign varName="response.outputParameters">
        					<trf:expr>
        						<expr:xqueryText><![CDATA[<sjConsultaMultipleRemesadorasNIResponse>
     <sj:SUCCESS_INDICATOR>SUCCESS</sj:SUCCESS_INDICATOR>
    <sj:ERROR_MESSAGE/>
    <sj:REMITTANCE/>
</sjConsultaMultipleRemesadorasNIResponse>]]]]>><![CDATA[</expr:xqueryText></trf:expr></trf:assign>
        			</bpel:extensionAssignOperation>
        		</bpel:assign>
        		<bpel:assign>
        			<bpel:extensionAssignOperation>
        				<trf:assign varName="resultGroup">
        					<trf:expr>
        						<expr:xqueryText>&lt;RESULT_GROUP>
  &lt;REMITTANCE/>
&lt;/RESULT_GROUP></expr:xqueryText></trf:expr></trf:assign>
        			</bpel:extensionAssignOperation>
        		</bpel:assign></bpel:sequence>
        </bpel:scope>
        
        <bpel:flow>
        	<bpel:scope>
        		<bpel:variables>
        			<bpel:variable name="riaAgentId" type="xsd:string">
        			</bpel:variable>
        			<bpel:variable name="subscriptionKey" type="xsd:string">
        			</bpel:variable>
        			<bpel:variable name="REQobtenerParametrizacion" messageType="ns1:args_in_msg">
        			</bpel:variable>
        			<bpel:variable name="RSPobtenerParametrizacion" messageType="ns1:args_out_msg">
        			</bpel:variable>
        			<bpel:variable name="REQSearchCashPickUpOrder" messageType="ns0:SearchCashPickUpOrder_inputMessage">
        			</bpel:variable>
        			<bpel:variable name="RSPSearchCashPickUpOrder" messageType="ns0:SearchCashPickUpOrder_outputMessage">
        			</bpel:variable></bpel:variables>
        		<bpel:faultHandlers>
        			<bpel:catchAll>
        				<bpel:sequence>
        					<bpel:empty/>
        				<bpel:assign>
		<bpel:extensionAssignOperation>
			<trf:insert varName="resultGroup">
				<trf:location>
					<expr:xpathText>./REMITTANCE</expr:xpathText></trf:location>
				<trf:where>last-child</trf:where>
			<trf:expr>
				<expr:xqueryText><![CDATA[<ROUTER_RESPONSE>
  <SUCCESS_INDICATOR>ERROR</SUCCESS_INDICATOR>,
  <ERROR_MESSAGE>Error consultando remesa en RIA</ERROR_MESSAGE>
</ROUTER_RESPONSE>]]]]>><![CDATA[</expr:xqueryText></trf:expr></trf:insert>
		</bpel:extensionAssignOperation>
        				</bpel:assign></bpel:sequence>
        			</bpel:catchAll></bpel:faultHandlers>
        		<bpel:sequence>
        			<bpel:assign>
        				<bpel:extensionAssignOperation>
        					<trf:assign varName="riaAgentId">
        						<trf:expr>
        							<expr:xqueryText>'RIA.NI01.AGENTID'</expr:xqueryText></trf:expr></trf:assign>
        				</bpel:extensionAssignOperation>
        				<bpel:extensionAssignOperation>
        					<trf:assign varName="subscriptionKey">
        						<trf:expr>
        							<expr:xqueryText>'RIA.NI01.OCPAPIMSUBSCRIPTIONKEY'</expr:xqueryText></trf:expr></trf:assign>
        				</bpel:extensionAssignOperation>
        			<bpel:extensionAssignOperation>
		<trf:assign varName="REQobtenerParametrizacion.InputParameters">
			<trf:expr>
				<expr:xqueryTransform>
					<expr:resource ref="Middleware/Business_Resources/general/Parametrizacion/obtenerParametrizacionIn"/>
					<expr:param name="nombreParametros">
						<expr:path>fn:concat(
$riaAgentId, " || ",
$subscriptionKey)</expr:path></expr:param></expr:xqueryTransform></trf:expr></trf:assign>
        			</bpel:extensionAssignOperation></bpel:assign>
        			<bpel:invoke operation="obtenerParametrizacion" partnerLink="ObtenerParametrizacion" inputVariable="REQobtenerParametrizacion" outputVariable="RSPobtenerParametrizacion">
        				<rescon:invokeInfo><rescon:service ref="Middleware/Business_Resources/general/Resources/ObtenerParametrizacion/ObtenerParametrizacion" xsi:type="ref:BusinessServiceRef" xmlns:ref="http://www.bea.com/wli/sb/reference" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"/></rescon:invokeInfo></bpel:invoke>
        			<bpel:assign>
        				<bpel:extensionAssignOperation>
        					<trf:assign varName="REQSearchCashPickUpOrder.request">
        						<trf:expr>
        							<expr:xqueryTransform>
        								<expr:resource ref="Middleware/v2/BusinessServices/SJS/consultaMultipleRemesadorasNI/xq/searchCashPickUpOrderIn"/>
        								
        								
        								
        								
        								
        								
        								
        								
        								
        								
        								
        								
        								
        								
        								
        								
        								
        								
        								
        								
        								
        								
        								
        								
        								
        								
        								
        								
        								
        								
        								
        								
        								<expr:param name="subscriptionKey">
        									<expr:path>fn:string($RSPobtenerParametrizacion.OutputParameters/osb:CONFIGURACIONES/osb:CONFIGURACIONES_ITEM[osb:NAME=$subscriptionKey]/osb:VALUE/text())</expr:path></expr:param>
        								<expr:param name="riaAgentId">
        									<expr:path>fn:string($RSPobtenerParametrizacion.OutputParameters/osb:CONFIGURACIONES/osb:CONFIGURACIONES_ITEM[osb:NAME=$riaAgentId]/osb:VALUE/text())</expr:path></expr:param>
        								<expr:param name="sjConsultaMultipleRemesadorasNI">
        									<expr:path>$request.inputParameters</expr:path></expr:param></expr:xqueryTransform></trf:expr></trf:assign>
        				</bpel:extensionAssignOperation>
        			</bpel:assign>
        			<bpel:invoke operation="SearchCashPickUpOrder" partnerLink="searchCashPickUpOrder" outputVariable="RSPSearchCashPickUpOrder" inputVariable="REQSearchCashPickUpOrder">
        				<rescon:invokeInfo><rescon:service ref="Middleware/v2/BusinessServices/Remesas/RIANI/searchCashPickUpOrder/biz/searchCashPickUpOrder" xsi:type="ref:BusinessServiceRef" xmlns:ref="http://www.bea.com/wli/sb/reference" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"/></rescon:invokeInfo></bpel:invoke>
        			<bpel:if>
        				<bpel:condition>string($RSPSearchCashPickUpOrder.reply/riam:Response/riam:ResponseCode/text()) != "2001"</bpel:condition>
        				<bpel:sequence>
        					<bpel:empty/>
        				<bpel:assign>
		<bpel:extensionAssignOperation>
			<trf:insert varName="resultGroup">
				<trf:location>
					<expr:xpathText>./REMITTANCE</expr:xpathText></trf:location>
				<trf:where>last-child</trf:where>
			<trf:expr>
				<expr:xqueryTransform>
					<expr:resource ref="Middleware/v2/BusinessServices/SJS/consultaMultipleRemesadorasNI/xq/searchCashPickUpOrderOut"/>
					
					<expr:param name="searchCashPickUpOrderResponse">
						<expr:path>$RSPSearchCashPickUpOrder.reply</expr:path></expr:param>
					<expr:param name="sjConsultaRemesadorasNI">
						<expr:path>$request.inputParameters</expr:path></expr:param></expr:xqueryTransform></trf:expr></trf:insert>
		</bpel:extensionAssignOperation>
        				</bpel:assign></bpel:sequence>
        				<bpel:else>
        					<bpel:sequence>
        						<bpel:empty/>
        					</bpel:sequence>
        				</bpel:else>
        			</bpel:if></bpel:sequence>
        	</bpel:scope>
        	
        </bpel:flow>
        <bpel:assign>
        	<bpel:extensionAssignOperation>
        		<trf:assign varName="response.outputParameters">
        			<trf:expr>
        				<expr:xqueryTransform>
        					<expr:resource ref="Middleware/v2/BusinessServices/SJS/consultaMultipleRemesadorasNI/xq/sjConsultaRemesadorasNIOut"/>
        					<expr:param name="resultGroup">
        						<expr:path>$resultGroup</expr:path></expr:param></expr:xqueryTransform></trf:expr></trf:assign>
        	</bpel:extensionAssignOperation>
        </bpel:assign>
        <bpel:reply partnerLink="sjConsultaMultipleRemesadorasNI" operation="consultaRemesadoras" variable="response"/>
    </bpel:sequence>
</bpel:process>]]></con:flow>
    <oper:operations/>
</con:flowEntry>