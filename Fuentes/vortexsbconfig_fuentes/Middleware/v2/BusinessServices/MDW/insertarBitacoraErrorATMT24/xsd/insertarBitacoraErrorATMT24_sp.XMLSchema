            <element name="PV_NUMERO_BILLETE" type="string" db:index="6" db:type="VARCHAR2" minOccurs="0" nillable="true"/>
            <element name="PV_MONEDA" type="string" db:index="7" db:type="VARCHAR2" minOccurs="0" nillable="true"/>
            <element name="PV_MONTO" type="decimal" db:index="8" db:type="VARCHAR2" minOccurs="0" nillable="true"/>
