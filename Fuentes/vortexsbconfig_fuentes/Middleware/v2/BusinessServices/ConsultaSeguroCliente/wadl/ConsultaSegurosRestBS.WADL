<?xml version="1.0" encoding="UTF-8"?>
<con:wadlEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:wadl><![CDATA[<application xmlns:soa="http://www.oracle.com/soa/rest" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://wadl.dev.java.net/2009/02">
   <doc title="ConsultaSegurosRestBS">RestReference</doc>
   <grammars>
      <xsd:schema>
            <xsd:import namespace="https://www.ficohsa.com/regional/Insurance" schemaLocation="../Schemas/ConsultaSegurosTypes.xsd"/>
        </xsd:schema>
   </grammars>
   <resources>
      <resource path="/find">
         <method name="GET" soa:wsdlOperation="GetAssuranseCustomer">
            <request soa:paramElement="pns:consultaSeguros" xmlns:pns="https://www.ficohsa.com/regional/Insurance">
               <param name="sistema" style="query" soa:expression="$msg.request/sistema" type="xsd:string"/>
               <param name="noDocumento" style="query" soa:expression="$msg.request/noDocumento" type="xsd:string"/>
               <param name="stsCertificado" style="query" soa:expression="$msg.request/stsCertificado" type="xsd:string"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:consultaSegurosResponse" xmlns:cns="https://www.ficohsa.com/regional/Insurance"/>
            </response>
         </method>
      </resource>
   </resources>
</application>]]></con:wadl>
    <con:dependencies>
        <con:importSchema namespace="https://www.ficohsa.com/regional/Insurance" schemaLocation="../Schemas/ConsultaSegurosTypes.xsd" ref="Middleware/v2/BusinessServices/ConsultaSeguroCliente/xsd/ConsultaSegurosTypes"/>
    </con:dependencies>
</con:wadlEntry>