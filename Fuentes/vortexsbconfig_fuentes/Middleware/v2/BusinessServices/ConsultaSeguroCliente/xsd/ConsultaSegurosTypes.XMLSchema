<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<?xml version="1.0" encoding="windows-1252" ?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="https://www.ficohsa.com/regional/Insurance"
            xmlns:com="https://www.ficohsa.com/regional/common/commonTypes"
            targetNamespace="https://www.ficohsa.com/regional/Insurance">
            
  <!-- Elemento Request -->
  <xsd:element name="consultaSeguros">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="sistema" type="xsd:string"/>
        <xsd:element name="noDocumento" type="xsd:string"/>
        <xsd:element name="stsCertificado" type="xsd:string"/>  
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  
  <!-- Elemento Response -->
  <xsd:element name="consultaSegurosResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="ok" type="xsd:boolean"/>
        <xsd:element name="code" type="xsd:string"/>
        <xsd:element name="message" type="xsd:string"/>
        <xsd:element name="body" minOccurs="0">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="certificados" minOccurs="0" maxOccurs="unbounded">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="nombreProductoSeguro" type="xsd:string"/>
                    <xsd:element name="numeroCertificado" type="xsd:string"/>
                    <xsd:element name="descripcionEstadoCertificado" type="xsd:string"/>
                    <xsd:element name="fechaVentaSeguro" type="xsd:date"/>
                    <xsd:element name="fechaVencimientoSeguro" type="xsd:date"/>
                    <xsd:element name="sumaAsegurada" type="xsd:string"/>
                    <xsd:element name="nombrePlanSeguro" type="xsd:string"/>
                    <xsd:element name="primaCuota" type="xsd:string"/>
                    <xsd:element name="medioPago" type="xsd:string"/>
                    <xsd:element name="frecuenciaPago" type="xsd:string"/>
                    <xsd:element name="monedaPoliza" type="xsd:string"/>
                    <xsd:element name="cliente">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="nombreCompleto" type="xsd:string"/>
                          <xsd:element name="numeroIdentificacion" type="xsd:string"/>
                          <xsd:element name="fechaNacimiento" type="xsd:date"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="beneficiarios" minOccurs="0" maxOccurs="unbounded">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="nombreCompleto" type="xsd:string"/>
                          <xsd:element name="porcentaje" type="xsd:string"/>
                          <xsd:element name="parentesco" type="xsd:string"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="aseguradosAdicionales" minOccurs="0" maxOccurs="unbounded">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="nombreCompleto" type="xsd:string"/>
                          <xsd:element name="numeroIdentificacion" type="xsd:string"/>
                          <xsd:element name="parentesco" type="xsd:string"/>
                          <xsd:element name="fechaNacimiento" type="xsd:date"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>]]></con:schema>
    <con:targetNamespace>https://www.ficohsa.com/regional/Insurance</con:targetNamespace>
</con:schemaEntry>