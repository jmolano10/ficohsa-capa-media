<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://www.ficohsa.com.hn/middleware.services/retiroSinTarjetaDebitoTypes"
	xmlns:tns="http://www.ficohsa.com.hn/middleware.services/retiroSinTarjetaDebitoTypes">
	<!--################################################################# -->
					<!--OPERACION: GENERA CUPON RETIRO -->

	<xs:element name="generarCuponRetiro">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="CUSTOMER_ID" type="xs:string" minOccurs="1" />
				<xs:element name="ACCOUNT_NUMBER" type="xs:string" minOccurs="1" />
				<xs:element name="AMOUNT" type="xs:decimal" minOccurs="1" />
				<xs:element name="CURRENCY" type="xs:string" minOccurs="1" />
				<xs:element name="CHANNEL" type="xs:string" minOccurs="0" />
				<xs:element name="TIME_TICKET" type="xs:int" minOccurs="1" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="generarCuponRetiroResponse">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="TICKET_NUMBER" type="xs:string" minOccurs="0" />
				<xs:element name="TRANSACTION_ID" type="xs:string"	minOccurs="0" />
				<xs:element name="DATE_TICKET" type="xs:date" minOccurs="0" />
				<xs:element name="QR_CODE" type="xs:string" minOccurs="0" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<!--################################################################# -->
						<!--OPERACION: RETIRO CUPON TD -->

	<xs:element name="retiroCuponTD">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="OPERATION" minOccurs="1">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="EXCHANGE" />
							<xs:enumeration value="REVERSE" />
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="TICKET_NUMBER" type="xs:string" minOccurs="1" />
				<xs:element name="TICKET_AMOUNT" type="xs:decimal" minOccurs="1" />
				<xs:element name="TICKET_CURRENCY" type="xs:string" minOccurs="1" />
				<xs:element name="WITHDRAWAL_POINT_INFORMATION" minOccurs="1">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="TYPE" minOccurs="1">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:enumeration value="ATM" />
										<xs:enumeration value="CNB" />
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="NAME" type="xs:string" minOccurs="1" />
							<xs:element name="TERMINAL_ID" type="xs:string"	minOccurs="1" />
							<xs:element name="TRACE" type="xs:string"	minOccurs="0" />
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="retiroCuponTDResponse">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="TICKET_NUMBER" type="xs:string" minOccurs="0" />
				<xs:element name="TRANSACTION_ID" type="xs:string" minOccurs="0" />		
				<xs:element name="TRANSACTION_DATE" type="xs:string" minOccurs="0" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<!--################################################################# -->
						<!--OPERACION: GESTION CUPON -->

	<xs:element name="gestionCupon">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="TYPE" minOccurs="1">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="APPLY" />
							<xs:enumeration value="CANCEL" />
							<xs:enumeration value="EXPIRED" />
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="CUSTOMER_ID" type="xs:string" minOccurs="1" />
				<xs:element name="ACCOUNT_NUMBER" type="xs:string" minOccurs="1" />
				<xs:element name="AMOUNT" type="xs:decimal" minOccurs="1" />
				<xs:element name="CURRENCY" type="xs:string" minOccurs="1" />
				<xs:element name="CHANNEL" type="xs:string" minOccurs="0" />
				<xs:element name="TICKET_NUMBER" type="xs:string" minOccurs="1" />
				<xs:element name="TRANSACTION_ID" type="xs:string" minOccurs="1" />
				<xs:element name="WITHDRAWAL_POINT_ID" type="xs:string"	minOccurs="0" />
				<xs:element name="WITHDRAWAL_TRACE" type="xs:string" minOccurs="0" />
				<xs:element name="DESPIGNORATION_CODE" type="xs:string" minOccurs="0" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="gestionCuponResponse">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="TICKET_NUMBER" type="xs:string" minOccurs="0" />
				<xs:element name="TRANSACTION_ID" type="xs:string" minOccurs="0" />
				<xs:element name="TRANSACTION_CORE_ID" type="xs:string" minOccurs="0" />
				<xs:element name="REF_T24" type="xs:string" minOccurs="0" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	
	<!--################################################################# -->
						<!--OPERACION: NOTIFICA CUPON PENDIENTE -->

	<xs:element name="notificaCuponPendiente">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="TYPE" minOccurs="1">
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:enumeration value="APPLY" />
							<xs:enumeration value="CANCEL" />
							<xs:enumeration value="EXPIRED" />
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="TICKET_NUMBER" type="xs:string" minOccurs="1" />
				<xs:element name="TRANSACTION_ID" type="xs:string" minOccurs="1" />
				<xs:element name="TRANSACTION_CORE_ID" type="xs:string" minOccurs="1" />
				<xs:element name="ICB_URI" type="xs:string" minOccurs="1" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="notificaCuponPendienteResponse"/>
</xs:schema>]]></con:schema>
    <con:targetNamespace>http://www.ficohsa.com.hn/middleware.services/retiroSinTarjetaDebitoTypes</con:targetNamespace>
</con:schemaEntry>