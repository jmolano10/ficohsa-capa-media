<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<xs:schema targetNamespace="http://www.ficohsa.com.hn/middleware.services/consultaTucaHNTypes"
