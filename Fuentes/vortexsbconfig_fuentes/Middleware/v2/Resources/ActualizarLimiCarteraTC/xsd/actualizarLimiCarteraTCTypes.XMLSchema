<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
    version="1.0"
    targetNamespace="http://www.ficohsa.com.hn/middleware.services/actualizarLimiCarteraTCTypes" 
    xmlns:tns="http://www.ficohsa.com.hn/middleware.services/actualizarLimiCarteraTCTypes">
    
    <xs:simpleType name="stringMaxLength19">
        <xs:restriction base="xs:string">
            <xs:maxLength value="19" />
        </xs:restriction>
    </xs:simpleType>
    
    <xs:simpleType name="stringMaxLength3">
        <xs:restriction base="xs:string">
            <xs:maxLength value="3" />
        </xs:restriction>
    </xs:simpleType>

    <xs:element name="actualizarLimiCarteraTC">
        <xs:complexType>
            <xs:sequence>
                <xs:element minOccurs="0" name="ORG" type="xs:int"/>
                <xs:element minOccurs="1" name="CARD_NUMBER" type="tns:stringMaxLength19"/>
                <xs:element minOccurs="0" name="CARD_SEQUENCE" type="xs:int" default="0"/>
                <xs:element minOccurs="0" name="ACCOUNT_NUMBER" type="xs:string"/>
                <xs:element minOccurs="0" name="CUSTOMER_NUMBER" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element> 
    
        
<xs:element name="actualizarLimiCarteraTCResponse"/>
        


</xs:schema>]]></con:schema>
    <con:targetNamespace>http://www.ficohsa.com.hn/middleware.services/actualizarLimiCarteraTCTypes</con:targetNamespace>
</con:schemaEntry>