<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<?xml version="1.0" encoding="windows-1252" ?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns="http://www.ficohsa.com.pa/regional/Vortex/DebitoAutomaticoTCPA"
            targetNamespace="http://www.ficohsa.com.pa/regional/Vortex/DebitoAutomaticoTCPA"
            elementFormDefault="qualified">
            
  <!-- DebitoAutomaticoTCPAtypes -->
    <xsd:element name="DebitoAutomaticoTCPArequest">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="OPERATION_TYPE" type="OperationtypeType"/>
                <xsd:element name="OPERATION_INFO" type="OperationInfoType"/>
                <xsd:element name="KV_PAIRS" type="KVPairsType" minOccurs="0"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>
    <!-- OperationtypeType -->
    <xsd:simpleType name="OperationtypeType">
		<xsd:restriction base="xsd:decimal">
			<xsd:enumeration value="0"/>
			<xsd:enumeration value="1"/>
		</xsd:restriction>
	</xsd:simpleType>
    <!-- OperationInfoType -->
    <xsd:complexType name="OperationInfoType">
        <xsd:sequence>
            <xsd:element name="UniqueID" type="xsd:decimal" minOccurs="0"/>
            <xsd:element name="DAY1" type="xsd:integer" minOccurs="0"/>
            <xsd:element name="DAY2" type="xsd:integer" minOccurs="0"/>
            <xsd:element name="PAY_TYPE" type="xsd:string" minOccurs="0"/>
            <xsd:element name="LAST_EXECUTION" type="xsd:date" minOccurs="0"/>
            <xsd:element name="CREDIT_CARD" type="xsd:string" minOccurs="0"/>
            <xsd:element name="TC_ACOUNT_NUMBER" type="xsd:string" minOccurs="0"/>
            <xsd:element name="TC_CUSTOMER_NAME" type="xsd:string" minOccurs="0"/>
            <xsd:element name="ACCOUNT_TYPE" type="xsd:string" minOccurs="0"/>
            <xsd:element name="ACCOUNT_NAME" type="xsd:string" minOccurs="0"/>
            <xsd:element name="BRANCH_CODE" type="xsd:integer" minOccurs="0"/>
            <xsd:element name="SUB_APPLICATION" type="xsd:integer" minOccurs="0"/>
            <xsd:element name="ACCOUNT_NUMBER" type="xsd:string" minOccurs="0"/>
            <xsd:element name="LAST_EXECUTION_STATUS" type="xsd:string" minOccurs="0"/>
            <xsd:element name="STATUS" type="xsd:string" minOccurs="0"/>
            <xsd:element name="OPERATION_TYPE" type="xsd:integer" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>
    <!-- KVPairsType -->
    <xsd:complexType name="KVPairsType">
        <xsd:sequence>
            <xsd:element name="PAIR" maxOccurs="unbounded">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="KEY" type="xsd:string"/>
                        <xsd:element name="VALUE" type="xsd:string"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>
    <!-- DebitoAutomaticoTCPAtypesresponse -->
    <xsd:element name="DebitoAutomaticoTCPAresponse">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="OPERATION_INFO" type="OperationInfoType"/>
                <xsd:element name="KV_PAIRS" type="KVPairsType" minOccurs="0"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>
</xsd:schema>]]></con:schema>
    <con:targetNamespace>http://www.ficohsa.com.pa/regional/Vortex/DebitoAutomaticoTCPA</con:targetNamespace>
</con:schemaEntry>