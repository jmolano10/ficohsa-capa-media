<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	version="1.0"
	targetNamespace="http://www.ficohsa.com.hn/middleware.services/actualizacionLogiClientesCorpoTypes" 
	xmlns:tns="http://www.ficohsa.com.hn/middleware.services/actualizacionLogiClientesCorpoTypes">
	
	<xs:simpleType name="stringMaxLength19">
		<xs:restriction base="xs:string">
			<xs:maxLength value="19" />
		</xs:restriction>
	</xs:simpleType>
	
	<xs:simpleType name="stringMaxLength3">
		<xs:restriction base="xs:string">
			<xs:maxLength value="3" />
		</xs:restriction>
	</xs:simpleType>

    <xs:element name="actualizacionLogiClientesCorpo">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="ORG" type="xs:int" minOccurs="1"/>
                <xs:element name="CARD_NUMBER" type="tns:stringMaxLength19" minOccurs="1"/>
                <xs:element name="ACCOUNT_NUMBER" type="xs:string" minOccurs="0"/>
                <xs:element name="CUSTOMER_NUMBER" type="tns:stringMaxLength19" minOccurs="0"/>
                <xs:element name="CUSTOMER_ID" type="xs:string" minOccurs="0"/>
                <xs:element name="PROFILE_ID" type="xs:int" minOccurs="0" default="0"/>
                <xs:element name="ECOMMERCE_INDICATOR" type="xs:string" minOccurs="0"/>
                <xs:element name="CONTACTLESS_INDICATOR" type="xs:string" minOccurs="0"/>
                <xs:element name="RESTRICTION_TABLE" type="xs:int" minOccurs="0" default="0"/>
                <xs:element name="SPENDING_LIMIT" type="xs:int" minOccurs="0" default="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
	
<xs:element name="actualizacionLogiClientesCorpoResponse"/>

</xs:schema>]]></con:schema>
    <con:targetNamespace>http://www.ficohsa.com.hn/middleware.services/actualizacionLogiClientesCorpoTypes</con:targetNamespace>
</con:schemaEntry>