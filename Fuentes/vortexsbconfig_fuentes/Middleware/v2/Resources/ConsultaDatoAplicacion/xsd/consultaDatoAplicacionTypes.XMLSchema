<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
	xmlns:xs="http://www.w3.org/2001/XMLSchema"
	targetNamespace="http://www.ficohsa.com.hn/middleware.services/consultaDatoAplicacionTypes"
	xmlns:tns="http://www.ficohsa.com.hn/middleware.services/consultaDatoAplicacionTypes"
	elementFormDefault="qualified">
	
	<xs:element name="consultaDatoAplicacion">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="APPLICATION_NAME" type="xs:string"/>
				<xs:element name="DATA_IDENTIFIER" type="xs:string"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	
	<xs:element name="consultaDatoAplicacionResponse">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="DATA_VALUE" type="xs:string" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>]]></con:schema>
    <con:targetNamespace>http://www.ficohsa.com.hn/middleware.services/consultaDatoAplicacionTypes</con:targetNamespace>
</con:schemaEntry>