<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	version="1.0"
	targetNamespace="http://www.ficohsa.com.hn/middleware.services/consultaSeguroClienteTypes"
	xmlns:act="http://www.ficohsa.com.hn/middleware.services/consultaSeguroClienteTypes">

	<xs:element name="consultaSeguroClienteRequest">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="NO_DOCUMENTO" type="xs:string" />
				<xs:element name="STS_CERTIFICADO" type="xs:string" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>

	<xs:element name="consultaSeguroClienteResponse">
		<xs:complexType>
                    <xs:sequence>
                      <xs:element name="certificados" minOccurs="0" maxOccurs="unbounded">
                        <xs:complexType>
                          <xs:sequence>
                            <xs:element name="NOMBRE_PRODUCTO_SEGURO" type="xs:string"/>
                            <xs:element name="NUMERO_CERTIFICADO" type="xs:string"/>
                            <xs:element name="DESCRIPCION_ESTADO_CERTIFICADO" type="xs:string"/>
                            <xs:element name="FECHA_VENTA_SEGURO" type="xs:date"/>
                            <xs:element name="FECHA_VENCIMIENTO_SEGURO" type="xs:date"/>
                            <xs:element name="SUMA_ASEGURADA" type="xs:string"/>
                            <xs:element name="NOMBRE_PLAN_SEGURO" type="xs:string"/>
                            <xs:element name="PRIMA_CUOTA" type="xs:string"/>
                            <xs:element name="MEDIO_PAGO" type="xs:string"/>
                            <xs:element name="FRECUENCIA_PAGO" type="xs:string"/>
                            <xs:element name="MONEDA_POLIZA" type="xs:string"/>
                            <xs:element name="CLIENTE" minOccurs="0" maxOccurs="unbounded">
                              <xs:complexType>
                                <xs:sequence>
                                  <xs:element name="NOMBRE_COMPLETO" type="xs:string"/>
                                  <xs:element name="NUMERO_IDENTIFICACION" type="xs:string"/>
                                  <xs:element name="FECHA_NACIMIENTO" type="xs:date"/>
                                </xs:sequence>
                              </xs:complexType>
                            </xs:element>
                            <xs:element name="BENEFICIARIOS" minOccurs="0" maxOccurs="unbounded">
                              <xs:complexType>
                                <xs:sequence>
                                  <xs:element name="NOMBRE_COMPLETO" type="xs:string"/>
                                  <xs:element name="PORCENTAJE" type="xs:string"/>
                                  <xs:element name="PARENTESCO" type="xs:string"/>
                                </xs:sequence>
                              </xs:complexType>
                            </xs:element>
                            <xs:element name="ASEGURADOS_ADICIONALES" minOccurs="0" maxOccurs="unbounded">
                              <xs:complexType>
                                <xs:sequence>
                                  <xs:element name="NOMBRE_COMPLETO" type="xs:string"/>
                                  <xs:element name="NUMERO_IDENTIFICACION" type="xs:string"/>
                                  <xs:element name="PARENTESCO" type="xs:string"/>
                                  <xs:element name="FECHA_NACIMIENTO" type="xs:date"/>
                                </xs:sequence>
                              </xs:complexType>
                            </xs:element>
                          </xs:sequence>
                        </xs:complexType>
                      </xs:element>
                    </xs:sequence>
                </xs:complexType>
	</xs:element>


</xs:schema>]]></con:schema>
    <con:targetNamespace>http://www.ficohsa.com.hn/middleware.services/consultaSeguroClienteTypes</con:targetNamespace>
</con:schemaEntry>