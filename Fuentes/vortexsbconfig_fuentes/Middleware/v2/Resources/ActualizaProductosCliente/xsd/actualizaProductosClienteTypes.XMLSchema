	xmlns:act="http://www.ficohsa.com.hn/middleware.services/actualizaProductosClienteTypes">

<xs:element name="actualizaProductosCliente">
	<xs:complexType>
	<xs:sequence>
		<xs:element name="CUSTOMER_ID_TYPE">
		<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:minLength value="1"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:element>
		<xs:element name="CUSTOMER_ID_VALUE">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:minLength value="1"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:element>
	</xs:sequence>
</xs:complexType>
</xs:element>

	

<xs:element name="actualizaProductosClienteResponse">
</xs:element>

</xs:schema>]]></con:schema>
    <con:targetNamespace>http://www.ficohsa.com.hn/middleware.services/actualizaProductosClienteTypes</con:targetNamespace>
