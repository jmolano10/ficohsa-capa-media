<?xml version="1.0" encoding="UTF-8"?>
<con:wadlEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:wadl><![CDATA[<application xmlns:soa="http://www.oracle.com/soa/rest" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://wadl.dev.java.net/2009/02">
   <doc title="CloudCodeRestBS">RestReference</doc>
   <grammars>
      <xsd:schema>
            <xsd:import namespace="https://www.ficohsa.com/honduras/pension/cloudCodeTypes" schemaLocation="../Schemas/CloudCodeTypes.xsd"/>
        </xsd:schema>
   </grammars>
   <resources>
      <resource path="/cuentas/relaciones/periodos">
         <method name="GET" soa:wsdlOperation="periodos">
            <request soa:paramElement="pns:getPeriodos" xmlns:pns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes">
               <param name="codigoCuenta" style="query" soa:expression="$msg.request/codigoCuenta" type="xsd:string"/>
               <param name="codigoTipoIdentificacionAfiliado" style="query" soa:expression="$msg.request/codigoTipoIdentificacionAfiliado" type="xsd:string"/>
               <param name="numeroIdentificacionAfiliado" style="query" soa:expression="$msg.request/numeroIdentificacionAfiliado" type="xsd:string"/>
               <param name="fechaInicialConsulta" style="query" soa:expression="$msg.request/fechaInicialConsulta" type="xsd:string"/>
               <param name="fechaFinalConsulta" style="query" soa:expression="$msg.request/fechaFinalConsulta" type="xsd:string"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:getPeriodosResponse" xmlns:cns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes"/>
            </response>
         </method>
      </resource>
      <resource path="/cuentas/saldos">
         <method name="GET" soa:wsdlOperation="saldos">
            <request soa:paramElement="pns:getSaldos" xmlns:pns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes">
               <param name="codigoTipoIdentificacion" style="query" soa:expression="$msg.request/codigoTipoIdentificacion" type="xsd:string"/>
               <param name="numeroIdentificacion" style="query" soa:expression="$msg.request/numeroIdentificacion" type="xsd:string"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:getSaldosResponse" xmlns:cns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes"/>
            </response>
         </method>
      </resource>
   </resources>
</application>]]></con:wadl>
    <con:dependencies>
        <con:importSchema namespace="https://www.ficohsa.com/honduras/pension/cloudCodeTypes" schemaLocation="../Schemas/CloudCodeTypes.xsd" ref="SBHN_Pension_GetMultipleProduct/Schemas/CloudCodeTypes"/>
    </con:dependencies>
</con:wadlEntry>