<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<xsd:schema targetNamespace="https://www.ficohsa.com/regional/pension" xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns="https://www.ficohsa.com/regional/pension"
            xmlns:com="https://www.ficohsa.com/regional/common/commonTypes">
  <xsd:import schemaLocation="../../SBRG_Pension_Commons/Schemas/CommonTypes.xsd"
              namespace="https://www.ficohsa.com/regional/common/commonTypes"/>
  <xsd:element name="getValidProductCustomer">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="GeneralInfo" type="com:GeneralInfoType"/>
        <xsd:element name="AccountCode" type="xsd:string"/>
        <xsd:element name="IdentificationTypeCode" type="xsd:string"/>
        <xsd:element name="IdentificationNumber" type="xsd:string"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="getValidProductCustomerResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="StatusInfo" type="com:StatusInfoType" minOccurs="0"/>
        <xsd:element name="ErrorInfo" type="com:ErrorInfoType" minOccurs="0"/>
        <xsd:element name="Error" type="xsd:string"/>
        <xsd:element name="Message" type="xsd:string"/>
        <xsd:element name="TypeIdentification" type="xsd:string"/>
        <xsd:element name="NumberAffiliateIdentification" type="xsd:string"/>
        <xsd:element name="NameCustomer" type="xsd:string"/>
        <xsd:element name="AccountCode" type="xsd:string"/>
        <xsd:element name="CodeCurrency" type="xsd:string"/>
        <xsd:element name="NumberApplicationRequestBinding" type="xsd:string"/>
        <xsd:element name="LineProduct" type="xsd:string"/>
        <xsd:element name="Sponsor" type="xsd:string"/>
        <xsd:element name="DateOpenAccount" type="xsd:string"/>
        <xsd:element name="BalanceTotalCurrent" type="xsd:string"/>
        <xsd:element name="BalancesSubaccount">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="subaccount" type="xsd:string"/>
              <xsd:element name="initialBalance" type="xsd:string"/>
              <xsd:element name="contributions" type="xsd:string"/>
              <xsd:element name="commissions" type="xsd:string"/>
              <xsd:element name="withdrawals" type="xsd:string"/>
              <xsd:element name="profits" type="xsd:string"/>
              <xsd:element name="insurance" type="xsd:string"/>
              <xsd:element name="balanceCurrent" type="xsd:string"/>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>]]></con:schema>
    <con:dependencies>
        <con:import namespace="https://www.ficohsa.com/regional/common/commonTypes" schemaLocation="../../SBRG_Pension_Commons/Schemas/CommonTypes.xsd" ref="SBRG_Pension_Commons/Schemas/CommonTypes"/>
    </con:dependencies>
    <con:targetNamespace>https://www.ficohsa.com/regional/pension</con:targetNamespace>
</con:schemaEntry>