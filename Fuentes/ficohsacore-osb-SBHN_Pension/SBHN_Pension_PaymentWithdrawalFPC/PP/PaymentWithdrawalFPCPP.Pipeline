                                    <con1:expr>
                                        <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">&lt;serviceAccount xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xmlns="https://www.ficohsa.com/honduras/pension/user">
  &lt;accountName>{$serviceAccountName}&lt;/accountName>
&lt;/serviceAccount></con2:xqueryText>
                                    </con1:expr>
