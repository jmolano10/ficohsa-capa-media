                        <con1:case id="_BranchId-N3f57eb3f.5f94c062.0.18cabdd0e79.N7d0a">
                            <con1:condition>
                                <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">$errorCodeAuthorization = '401'</con2:xqueryText>
                            </con1:condition>
                            <con1:actions>
