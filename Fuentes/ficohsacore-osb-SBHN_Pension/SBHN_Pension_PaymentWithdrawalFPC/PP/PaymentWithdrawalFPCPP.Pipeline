                                            <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N3f57eb3f.5f94c062.0.18cabdd0e79.N7d00</con2:id>
                                            <con1:expr>
                                                <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">let $successIndicator := $responseService/cli:error/text()
return
if($successIndicator = 'false') then (
  'Success'
) else 'Error'</con2:xqueryText>
                                            </con1:expr>
                                        </con1:assign>
                                        <con1:assign varName="codeErrorService">
                                            <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N3f57eb3f.5f94c062.0.18cabdd0e79.N7cff</con2:id>
