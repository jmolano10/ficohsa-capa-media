            <con:stage id="_StageId-N3f57eb3f.5f94c062.0.18cabdd0e79.N7d0d" name="StageErrorHandler">
                <con:context>
                    <con1:userNsDecl prefix="cli" namespace="https://www.ficohsa.com/honduras/pension/cloudCodeTypes" xmlns:con1="http://www.bea.com/wli/sb/stages/config"/>
                    <con1:userNsDecl prefix="err" namespace="http://www.bea.com/wli/sb/errors" xmlns:con1="http://www.bea.com/wli/sb/stages/config"/>
