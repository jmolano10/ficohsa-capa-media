<?xml version="1.0" encoding="UTF-8"?>
<con:wadlEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:wadl><![CDATA[<application xmlns:soa="http://www.oracle.com/soa/rest" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://wadl.dev.java.net/2009/02">
   <doc title="GetBalancesWarrantiesRestPS">RestService</doc>
   <grammars>
      <xsd:schema xmlns:tns="https://www.ficohsa.com/honduras/pension" xmlns:inp1="https://www.ficohsa.com/honduras/pension" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">
            <xsd:import namespace="https://www.ficohsa.com/honduras/pension" schemaLocation="../Schemas/GetBalancesWarrantiesTypes.xsd"/>
        </xsd:schema>
   </grammars>
   <resources>
      <resource path="/">
         <method name="POST" soa:wsdlOperation="getBalancesWarranties">
            <request>
               <representation mediaType="application/json" element="cns:getBalancesWarranties" xmlns:cns="https://www.ficohsa.com/honduras/pension"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:getBalancesWarrantiesResponse" xmlns:cns="https://www.ficohsa.com/honduras/pension"/>
            </response>
         </method>
      </resource>
   </resources>
</application>]]></con:wadl>
    <con:dependencies>
        <con:importSchema namespace="https://www.ficohsa.com/honduras/pension" schemaLocation="../Schemas/GetBalancesWarrantiesTypes.xsd" ref="SBHN_Pension_GetBalancesWarranties/Schemas/GetBalancesWarrantiesTypes"/>
    </con:dependencies>
</con:wadlEntry>