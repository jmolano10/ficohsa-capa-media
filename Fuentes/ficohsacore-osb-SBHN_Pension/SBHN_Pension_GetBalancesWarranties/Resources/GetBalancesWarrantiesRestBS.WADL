<?xml version="1.0" encoding="UTF-8"?>
<con:wadlEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:wadl><![CDATA[<application xmlns:soa="http://www.oracle.com/soa/rest" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ns0="https://www.ficohsa.com/honduras/pension/cloudCodeTypes" xmlns="http://wadl.dev.java.net/2009/02">
   <doc title="GetBalancesWarrantiesRestBS">RestReference</doc>
   <grammars>
      <xsd:schema>
            <xsd:import namespace="https://www.ficohsa.com/honduras/pension/cloudCodeTypes" schemaLocation="../Schemas/CloudCodeTypes.xsd"/>
        </xsd:schema>
   </grammars>
   <resources>
      <resource path="/clientes/restricciones/integrales">
         <method name="GET" soa:wsdlOperation="restricciones">
            <request soa:paramElement="pns:restricciones" xmlns:pns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes">
               <param name="codigoCuenta" style="query" soa:expression="$msg.request/ns0:codigoCuenta" type="xsd:string"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:restriccionesResponse" xmlns:cns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes"/>
            </response>
         </method>
      </resource>
      <resource path="/recaudos">
         <method name="GET" soa:wsdlOperation="recaudos">
            <request soa:paramElement="pns:recaudos" xmlns:pns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes">
               <param name="codigoCuenta" style="query" soa:expression="$msg.request/ns0:codigoCuenta" type="xsd:string"/>
               <param name="codigoSubcuenta" style="query" soa:expression="$msg.request/ns0:codigoSubcuenta" type="xsd:string"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:recaudosResponse" xmlns:cns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes"/>
            </response>
         </method>
      </resource>
      <resource path="/clientes/cuentas/saldos/integrales">
         <method name="GET" soa:wsdlOperation="integrales">
            <request soa:paramElement="pns:integrales" xmlns:pns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes">
               <param name="codigoLineaProducto" style="query" soa:expression="$msg.request/ns0:codigoLineaProducto" type="xsd:string"/>
               <param name="codigoTipoIdentificacionCliente" style="query" soa:expression="$msg.request/ns0:codigoTipoIdentificacionCliente" type="xsd:string"/>
               <param name="numeroIdentificacionCliente" style="query" soa:expression="$msg.request/ns0:numeroIdentificacionCliente" type="xsd:string"/>
               <param name="codigoCuenta" style="query" soa:expression="$msg.request/ns0:codigoCuenta" type="xsd:string"/>
               <param name="codigoSubcuenta" style="query" soa:expression="$msg.request/ns0:codigoSubcuenta" type="xsd:string"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:integralesResponse" xmlns:cns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes"/>
            </response>
         </method>
      </resource>
   </resources>
</application>]]></con:wadl>
    <con:dependencies>
        <con:importSchema namespace="https://www.ficohsa.com/honduras/pension/cloudCodeTypes" schemaLocation="../Schemas/CloudCodeTypes.xsd" ref="SBHN_Pension_GetBalancesWarranties/Schemas/CloudCodeTypes"/>
    </con:dependencies>
</con:wadlEntry>