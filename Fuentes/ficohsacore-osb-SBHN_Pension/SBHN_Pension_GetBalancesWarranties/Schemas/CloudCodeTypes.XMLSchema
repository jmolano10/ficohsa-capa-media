<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<?xml version="1.0" encoding="windows-1252" ?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes"
            targetNamespace="https://www.ficohsa.com/honduras/pension/cloudCodeTypes" elementFormDefault="qualified">
  <xsd:element name="recaudos">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="codigoCuenta" type="xsd:string"/>
        <xsd:element name="codigoSubcuenta" type="xsd:string"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="recaudosResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="error" type="xsd:string" minOccurs="0"/>
        <xsd:element name="mensaje" type="xsd:string" minOccurs="0"/>
        <xsd:element name="datos" minOccurs="0">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="cuenta" minOccurs="0">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="fechaApertura" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoLineaProducto" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="periodoAporte" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="descripcionSubcuenta" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoSubcuenta" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="estado" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="descripcionMoneda" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoMoneda" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="saldo" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoAlternativa" type="xsd:string" minOccurs="0"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="cliente" minOccurs="0">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="codigoIdentificacion" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="numeroIdentificacion" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="diaPago" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="frecuenciaPago" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="descripcionFrecuenciaPago" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="montoPactado" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="telefonoArea" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="telefonoNumero" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="telefonoTipo" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="telefonoUbicacion" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="correoElectronico" type="xsd:string" minOccurs="0"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="fecha" minOccurs="0">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="fechaRentabilidad" type="xsd:string" minOccurs="0"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="restricciones">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="codigoCuenta" type="xsd:string"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="restriccionesResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="error" type="xsd:string" minOccurs="0"/>
        <xsd:element name="mensaje" type="xsd:string" minOccurs="0"/>
        <xsd:element name="datos" minOccurs="0">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="cuenta" minOccurs="0">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="codigoCuenta" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoLineaProducto" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoProducto" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoTipoIdentificacionCliente" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="numeroIdentificacionCliente" type="xsd:string" minOccurs="0"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="restricciones" minOccurs="0" maxOccurs="unbounded">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="nombreTipoRestriccion" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="nombreConceptoRestriccion" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoTipoMontoRestriccion" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoTipoRestriccion" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoAFP" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="nombreAFP" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="nombreLineaNegocio" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoLineaProducto" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoProducto" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="nombreProducto" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="fechaInicioAplicacionRestriccion" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoConceptoRestriccion" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoLineaNegocio" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="nombreLineaProducto" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoCuenta" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorRestriccion" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="fechaRegistroRestriccion" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="numeroSolicitud" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoProcesoRegistroRestriccion" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="nombreProcesoRegistroRestriccion" type="xsd:string" minOccurs="0"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="integrales">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="codigoLineaProducto" type="xsd:string"/>
        <xsd:element name="codigoTipoIdentificacionCliente" type="xsd:string"/>
        <xsd:element name="numeroIdentificacionCliente" type="xsd:string"/>
        <xsd:element name="codigoCuenta" type="xsd:string"/>
        <xsd:element name="codigoSubcuenta" type="xsd:string"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="integralesResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="error" type="xsd:string" minOccurs="0"/>
        <xsd:element name="mensaje" type="xsd:string" minOccurs="0"/>
        <xsd:element name="datos" minOccurs="0">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="informacion" minOccurs="0">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="codigoAFP" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="nombreAFP" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoLineaNegocio" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="nombreLineaNegocio" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoLineaProducto" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="nombreLineaProducto" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoProducto" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="nombreProducto" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoTipoIdentificacionCliente" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="numeroIdentificacionCliente" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="nombreCliente" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoCuenta" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="nombreCuenta" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoObjetivoCuenta" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="nombreObjetivoCuenta" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoEstadoCuenta" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="nombreEstadoCuenta" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoSubcuenta" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="nombreSubcuenta" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="descripcionSubcuenta" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoAlternativa" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="nombreAlternativa" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="numeroUnicoAporte" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="fechaAporte" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="saldoCapitalNivel" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="saldoRetencionNivel" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="saldoTotalConRetContPesosParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="saldoTotalConRetContUnidadesParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="saldoTotalConRetContPesosPatrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="saldoTotalConRetContUnidadesPatrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="saldoTotalExentoPesosParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="saldoTotalExentoUnidadesParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="saldoTotalExentoPesosPatrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="saldoTotalExentoUnidadesPatrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="saldoTotalNivelPesos" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="conversionSaldoTotalNivelPesos" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="saldoTotalNivelUnidades" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="saldoTotalSinRetContPesosParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="saldoTotalSinRetContUnidadesParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="saldoTotalSinRetContPesosPatrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="saldoTotalSinRetContUnidadesPatrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorCapitalDisponibleParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorCapitalDisponiblePatrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorCapitalNoDisponibleParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorCapitalNoDisponiblePatrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorDisponibleParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorDisponiblePatrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorNoDisponibleParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorNoDisponiblePatrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorDisponibleConRetencionParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorDisponibleSinRetencionParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorDisponibleExcentoParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorDisponibleConRetencionPatrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorDisponibleSinRetencionPatrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorDisponibleExcentoPatrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorNoDisponibleConRetencionParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorNoDisponibleSinRetencionParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorNoDisponibleExentoParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorNoDisponibleConRetencionPatrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorNoDisponibleSinRetencionPatrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorNoDisponibleExentoPatrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorCapitalDisponibleConRetencionParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorCapitalDisponibleSinRetencionParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorCapitalDisponibleExcentoParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorCapitalDisponibleConRetencionPatrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorCapitalDisponibleSinRetencionPatrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorCapitalDisponibleExcentoPatrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorCapitalNoDisponibleConRetencionParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorCapitalNoDisponibleSinRetencionParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorCapitalNoDisponibleExentoParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="valorCapitalNoDisponibleConRetencionPatrocinador" type="xsd:string"
                                 minOccurs="0"/>
                    <xsd:element name="valorCapitalNoDisponibleSinRetencionPatrocinador" type="xsd:string"
                                 minOccurs="0"/>
                    <xsd:element name="valorCapitalNoDisponibleExentoPatrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="unidadesDisponiblesConRetencionParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="unidadesDisponiblesSinRetencionParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="unidadesDisponiblesExentoParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="unidadesDisponiblesPatrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="unidadesDisponiblesConRetencionPatrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="unidadesDisponiblesSinRetencionPatrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="unidadesDisponiblesExentoPatrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="unidadesRestringidoParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="unidadesRestringidoConRetencionParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="unidadesRestringidoSinRetencionParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="unidadesRestringidoExentoParticipe" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="unidadesRestringidoPatrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="unidadesRestringidoConRetencionPatrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="unidadesRestringidoSinRetencionPatrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="unidadesRestringidoExentoPatrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="unidadesDisponiblesParticipe" type="xsd:string" minOccurs="0"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>]]></con:schema>
    <con:targetNamespace>https://www.ficohsa.com/honduras/pension/cloudCodeTypes</con:targetNamespace>
</con:schemaEntry>