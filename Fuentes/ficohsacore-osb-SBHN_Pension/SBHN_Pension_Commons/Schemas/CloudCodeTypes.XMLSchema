<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<?xml version="1.0" encoding="windows-1252" ?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes"
            xmlns:cct="https://www.ficohsa.com/honduras/pension/cloudCodeTypes"
            targetNamespace="https://www.ficohsa.com/honduras/pension/cloudCodeTypes" elementFormDefault="qualified">
  <xsd:element name="saldos">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="codigoTipoIdentificacion" type="xsd:string"/>
        <xsd:element name="numeroIdentificacion" type="xsd:string"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="saldosResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="error" type="xsd:string" minOccurs="0"/>
        <xsd:element name="mensaje" type="xsd:string" minOccurs="0"/>
        <xsd:element name="datos" minOccurs="0">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="fecha" minOccurs="0">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="fechaRentabilidad" type="xsd:string" minOccurs="0"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="cuentas" minOccurs="0" maxOccurs="unbounded">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="cuenta" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="moneda" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="saldoTotal" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="primerNombre" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="segundoNombre" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="primerApellido" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="segundoApellido" type="xsd:string" minOccurs="0"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="retirosPost">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="numeroTransaccion" type="xsd:string"/>
        <xsd:element name="moneda" type="xsd:string"/>
        <xsd:element name="monto" type="xsd:string"/>
        <xsd:element name="usuarioPago" type="xsd:string"/>
        <xsd:element name="fechaPago" type="xsd:string"/>
        <xsd:element name="numeroReferencia" type="xsd:string"/>
        <xsd:element name="codigoAgencia" type="xsd:string"/>
        <xsd:element name="nombreAgencia" type="xsd:string"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="retirosPostResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="error" type="xsd:string" minOccurs="0"/>
        <xsd:element name="mensaje" type="xsd:string" minOccurs="0"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="financieros">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="codigoTipoIdentificacion" type="xsd:string"/>
        <xsd:element name="numeroIdentificacion" type="xsd:string"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="financierosResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="error" type="xsd:string" minOccurs="0"/>
        <xsd:element name="mensaje" type="xsd:string" minOccurs="0"/>
        <xsd:element name="datos" minOccurs="0">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="fecha" minOccurs="0">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="fechaRentabilidad" type="xsd:string" minOccurs="0"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="cuentas" maxOccurs="unbounded" minOccurs="0">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="cuenta" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="moneda" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="saldoTotal" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="nombreCuenta" type="xsd:string" minOccurs="0"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="bancoRegion" type="xsd:string" minOccurs="0"/>
              <xsd:element name="tipoProductoCli" type="xsd:string" minOccurs="0"/>
              <xsd:element name="tipoProducto" type="xsd:string" minOccurs="0"/>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="demograficos">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="codigoCuenta" type="xsd:integer"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="demograficosResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="error" type="xsd:string"/>
        <xsd:element name="mensaje" type="xsd:string"/>
        <xsd:element name="datos">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="demograficos">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="cuenta">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="fechaSolicitud" type="xsd:string"/>
                          <xsd:element name="codigoProducto" type="xsd:integer"/>
                          <xsd:element name="nombreProducto" type="xsd:string"/>
                          <xsd:element name="montoAporte" type="xsd:integer"/>
                          <xsd:element name="frecuencia" type="xsd:string"/>
                          <xsd:element name="formaAporte" type="xsd:string"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="persona">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="tipoIdentificacion" type="xsd:string"/>
                          <xsd:element name="identificacion" type="xsd:integer"/>
                          <xsd:element name="primerNombre" type="xsd:string"/>
                          <xsd:element name="segundoNombre" type="xsd:string"/>
                          <xsd:element name="primerApellido" type="xsd:string"/>
                          <xsd:element name="segundoApellido" type="xsd:string"/>
                          <xsd:element name="fechaNacimiento" type="xsd:string"/>
                          <xsd:element name="fechaVencimiento" type="xsd:string"/>
                          <xsd:element name="correo" type="xsd:string"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="patrono">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="tipoIdentificacionEmpleador" type="xsd:string"/>
                          <xsd:element name="numeroIdentificacionEmpleador" type="xsd:integer"/>
                          <xsd:element name="razonSocial" type="xsd:string"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="beneficiarios">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="beneficiarioPrimerNombre" type="xsd:string"/>
                          <xsd:element name="beneficiarioSegundoNombre" type="xsd:string"/>
                          <xsd:element name="beneficiarioPrimerApellido" type="xsd:string"/>
                          <xsd:element name="beneficiarioSegundoApellido" type="xsd:string"/>
                          <xsd:element name="beneficiarioParentesco" type="xsd:string"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="bancos">
    <!--Empty Parameter List-->
    <xsd:complexType/>
  </xsd:element>
  <xsd:element name="bancostResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="error" type="xsd:string"/>
        <xsd:element name="mensaje" type="xsd:string"/>
        <xsd:element name="datos">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="entes" maxOccurs="unbounded">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="codigo" type="xsd:integer"/>
                    <xsd:element name="descripcion" type="xsd:string"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="periodos">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="tipoIdentificacionAfiliado" type="xsd:string"/>
        <xsd:element name="numeroIdentificacionAfiliado" type="xsd:string"/>
        <xsd:element name="fechaInicio" type="xsd:string"/>
        <xsd:element name="fechaFin" type="xsd:string"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="periodosResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="error" type="xsd:boolean" minOccurs="0"/>
        <xsd:element name="mensaje" type="xsd:string" minOccurs="0"/>
        <xsd:element name="datos">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="laborales" maxOccurs="unbounded" minOccurs="0">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="codigoCuenta" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="estado" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="fechaSalida" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="numeroPeriodo" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="tipoIdentificacionPatron" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="nombrePatrono" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="RTNPatrono" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="tipoIngreso" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="montoPagado" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="ocupacion" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="puesto" type="xsd:string" minOccurs="0"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="monedas">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="codigoCuenta" type="xsd:integer"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="monedasResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="error" type="xsd:string" minOccurs="0"/>
        <xsd:element name="mensaje" type="xsd:string" minOccurs="0"/>
        <xsd:element name="datos" minOccurs="0">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="cuenta" minOccurs="0">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="codigoCuenta" type="xsd:integer" minOccurs="0"/>
                    <xsd:element name="codigoMoneda" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="descripcionMoneda" type="xsd:string" minOccurs="0"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="persona" minOccurs="0">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="tipoIdentificacion" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="identificacion" type="xsd:integer" minOccurs="0"/>
                    <xsd:element name="primerNombre" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="segundoNombre" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="primerApellido" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="segundoApellido" type="xsd:string" minOccurs="0"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="historicasLaborales">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="codigoCuenta" type="xsd:string"/>
        <xsd:element name="fechaInicio" type="xsd:string"/>
        <xsd:element name="fechaFin" type="xsd:string"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="historicasLaboralesResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="error" type="xsd:string" minOccurs="0"/>
        <xsd:element name="mensaje" type="xsd:string" minOccurs="0"/>
        <xsd:element name="datos" minOccurs="0">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="laborales" minOccurs="0">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="infoLaboralHistorica" maxOccurs="unbounded">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="codigoCuenta" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="estadoCuenta" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="fechaInicio" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="fechaFin" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="periodo" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="codigoEmpleador" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="RTNEmpleador" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="nombreEmpleador" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="tipoIngreso" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="montoAporte" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="monedaSalario" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="montoSalario" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="codigoOcupacion" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="descripcionOcupacion" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="codigoTrabajo" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="descripcionTrabajo" type="xsd:string" minOccurs="0"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="cuentasFondosPensiones">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="codigoCuenta" type="xsd:string"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="cuentasFondosPensionesResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="error" type="xsd:string" minOccurs="0"/>
        <xsd:element name="mensaje" type="xsd:string" minOccurs="0"/>
        <xsd:element name="datos" minOccurs="0">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="cuenta" minOccurs="0">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="codigoCuenta" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoCliente" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="nombreCliente" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoLineaProducto" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="nombreProducto" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoProducto" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="fechaApertura" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="montoAsegurado" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="ultimaContribucion" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="siguienteContribucion" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="ultimoMontoContribucion" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="ultimaContribucicionExtra" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="frecuenciaAporte" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="formaAporte" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="montoAporte" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="beneficiarios" maxOccurs="unbounded">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="nombreBeneficiario" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="relacionBeneficiario" type="xsd:string" minOccurs="0"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="estadoCuentasHistoricos">
    <xsd:complexType>
      <xsd:sequence maxOccurs="unbounded">
        <xsd:element name="tipoIdentificacion" type="xsd:string"/>
        <xsd:element name="numeroIdentificacion" type="xsd:string"/>
        <xsd:element name="fechaInicio" type="xsd:string"/>
        <xsd:element name="fechaFinal" type="xsd:string"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="estadoCuentasHistoricosResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="error" type="xsd:boolean" minOccurs="0"/>
        <xsd:element name="mensaje" type="xsd:string" minOccurs="0"/>
        <xsd:element name="datos" maxOccurs="unbounded">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="estadoCuenta">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="fecha" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="nombreCliente" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="emailCliente" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="numeroCliente" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="movimientos" maxOccurs="unbounded">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="moneda" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="cuenta" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="rendimiento" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="totalPersonal" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="totalPatronal" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="granTotal" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="transacciones" maxOccurs="unbounded">
                            <xsd:complexType>
                              <xsd:sequence>
                                <xsd:element name="fecha" type="xsd:string" minOccurs="0"/>
                                <xsd:element name="tipoMovimiento" type="xsd:string" minOccurs="0"/>
                                <xsd:element name="descripcionTransaccion" type="xsd:string" minOccurs="0"/>
                                <xsd:element name="movimientoPersonal" type="xsd:string" minOccurs="0"/>
                                <xsd:element name="movimientoPatronal" type="xsd:string" minOccurs="0"/>
                                <xsd:element name="movimientoTotal" type="xsd:string" minOccurs="0"/>
                              </xsd:sequence>
                            </xsd:complexType>
                          </xsd:element>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>]]></con:schema>
    <con:targetNamespace>https://www.ficohsa.com/honduras/pension/cloudCodeTypes</con:targetNamespace>
</con:schemaEntry>