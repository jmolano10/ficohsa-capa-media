<?xml version="1.0" encoding="UTF-8"?>
<con:wadlEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:wadl><![CDATA[<?xml version = '1.0' encoding = 'UTF-8'?>
<application xmlns:soa="http://www.oracle.com/soa/rest" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ns0="https://www.ficohsa.com/honduras/pension/cloudCodeTypes" xmlns="http://wadl.dev.java.net/2009/02">
   <doc title="CloudCodeRestBS">RestReference</doc>
   <grammars>
      <xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <xsd:import namespace="https://www.ficohsa.com/honduras/pension/cloudCodeTypes" schemaLocation="../Schemas/CloudCodeTypes.xsd"/>
        </xsd:schema>
   </grammars>
   <resources>
      <resource path="/cuentas/saldos">
         <method name="GET" soa:wsdlOperation="saldos">
            <request soa:paramElement="pns:saldos" xmlns:pns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes">
               <param name="codigoLineaProducto" style="query" soa:expression="$msg.request/ns0:codigoLineaProducto" type="xsd:integer"/>
               <param name="codigoTipoIdentificacion" style="query" soa:expression="$msg.request/ns0:codigoTipoIdentificacion" type="xsd:string"/>
               <param name="numeroIdentificacion" style="query" soa:expression="$msg.request/ns0:numeroIdentificacion" type="xsd:string"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:saldosResponse" xmlns:cns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes"/>
            </response>
         </method>
      </resource>
      <resource path="/clientes/financieros">
         <method name="GET" soa:wsdlOperation="financieros">
            <request soa:paramElement="pns:financieros" xmlns:pns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes">
               <param name="codigoTipoIdentificacion" style="query" soa:expression="$msg.request/ns0:codigoTipoIdentificacion" type="xsd:string"/>
               <param name="numeroIdentificacion" style="query" soa:expression="$msg.request/ns0:numeroIdentificacion" type="xsd:string"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:financierosResponse" xmlns:cns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes"/>
            </response>
         </method>
      </resource>
      <resource path="/retiros">
         <method name="POST" soa:wsdlOperation="retirosPost">
            <request>
               <representation mediaType="application/json" element="cns:retirosPost" xmlns:cns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:retirosPostResponse" xmlns:cns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes"/>
            </response>
         </method>
      </resource>
      <resource path="/cuentas/clientes/demograficos">
         <method name="GET" soa:wsdlOperation="demograficos">
            <request soa:paramElement="pns:demograficos" xmlns:pns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes">
               <param name="codigoCuenta" style="query" soa:expression="$msg.request/ns0:codigoCuenta" type="xsd:integer"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:demograficosResponse" xmlns:cns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes"/>
            </response>
         </method>
      </resource>
      <resource path="/entes/bancos">
         <method name="GET" soa:wsdlOperation="bancos">
            <request soa:paramElement="pns:bancos" xmlns:pns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes"/>
            <response status="200">
               <representation mediaType="application/json" element="cns:bancostResponse" xmlns:cns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes"/>
            </response>
         </method>
      </resource>
      <resource path="/clientes/laborales/periodos">
         <method name="GET" soa:wsdlOperation="periodos">
            <request soa:paramElement="pns:periodos" xmlns:pns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes">
               <param name="tipoIdentificacionAfiliado" style="query" soa:expression="$msg.request/ns0:tipoIdentificacionAfiliado" type="xsd:string"/>
               <param name="numeroIdentificacionAfiliado" style="query" soa:expression="$msg.request/ns0:numeroIdentificacionAfiliado" type="xsd:string"/>
               <param name="fechaInicio" style="query" soa:expression="$msg.request/ns0:fechaInicio" type="xsd:string"/>
               <param name="fechaFin" style="query" soa:expression="$msg.request/ns0:fechaFin" type="xsd:string"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:periodosResponse" xmlns:cns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes"/>
            </response>
         </method>
      </resource>
      <resource path="/cuentas/monedas">
         <method name="GET" soa:wsdlOperation="monedas">
            <request soa:paramElement="pns:monedas" xmlns:pns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes">
               <param name="codigoCuenta" style="query" soa:expression="$msg.request/ns0:codigoCuenta" type="xsd:integer"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:monedasResponse" xmlns:cns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes"/>
            </response>
         </method>
      </resource>
      <resource path="/clientes/historicas/laborales">
         <method name="GET" soa:wsdlOperation="historicasLaborales">
            <request soa:paramElement="pns:historicasLaborales" xmlns:pns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes">
               <param name="codigoCuenta" style="query" soa:expression="$msg.request/ns0:codigoCuenta" type="xsd:string"/>
               <param name="fechaInicio" style="query" soa:expression="$msg.request/ns0:fechaInicio" type="xsd:string"/>
               <param name="fechaFin" style="query" soa:expression="$msg.request/ns0:fechaFin" type="xsd:string"/>
            </request>
            <response status="200">
               <representation mediaType="application/xml" element="cns:historicasLaboralesResponse" xmlns:cns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes"/>
               <representation mediaType="application/json" element="cns:historicasLaboralesResponse" xmlns:cns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes"/>
            </response>
         </method>
      </resource>
      <resource path="/cuentas/fondos/pensiones">
         <method name="GET" soa:wsdlOperation="cuentasFondosPensiones">
            <request soa:paramElement="pns:cuentasFondosPensiones" xmlns:pns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes">
               <param name="codigoCuenta" style="query" soa:expression="$msg.request/ns0:codigoCuenta" type="xsd:string"/>
            </request>
            <response status="200">
               <representation mediaType="application/xml" element="cns:cuentasFondosPensionesResponse" xmlns:cns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes"/>
               <representation mediaType="application/json" element="cns:cuentasFondosPensionesResponse" xmlns:cns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes"/>
            </response>
         </method>
      </resource>
      <resource path="/estados-cuentas/historicos">
         <method name="POST" soa:wsdlOperation="estadoCuentasHistoricos">
            <request>
               <representation mediaType="application/json" element="cns:estadoCuentasHistoricos" xmlns:cns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:estadoCuentasHistoricosResponse" xmlns:cns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes"/>
            </response>
         </method>
      </resource>
   </resources>
</application>]]></con:wadl>
    <con:dependencies>
        <con:importSchema namespace="https://www.ficohsa.com/honduras/pension/cloudCodeTypes" schemaLocation="../Schemas/CloudCodeTypes.xsd" ref="SBHN_Pension_Commons/Schemas/CloudCodeTypes"/>
    </con:dependencies>
</con:wadlEntry>