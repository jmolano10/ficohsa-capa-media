<?xml version="1.0" encoding="UTF-8"?>
<con:wadlEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:wadl><![CDATA[<application xmlns:soa="http://www.oracle.com/soa/rest" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://wadl.dev.java.net/2009/02">
   <doc title="GetParametersRestBS">RestService</doc>
   <grammars>
      <xsd:schema>
            <xsd:import namespace="https://www.ficohsa.com/regional/utility/constants" schemaLocation="SBRG_Constants_Commons/Schemas/CustomParameter.xsd"/>
        </xsd:schema>
   </grammars>
   <resources>
      <resource path="/">
         <method name="POST" soa:wsdlOperation="GetParameters">
            <request>
               <representation mediaType="application/xml" element="cns:GetParameters" xmlns:cns="https://www.ficohsa.com/regional/utility/constants"/>
               <representation mediaType="application/json" element="cns:GetParameters" xmlns:cns="https://www.ficohsa.com/regional/utility/constants"/>
            </request>
            <response status="200">
               <representation mediaType="application/xml" element="cns:GetParametersResponse" xmlns:cns="https://www.ficohsa.com/regional/utility/constants"/>
               <representation mediaType="application/json" element="cns:GetParametersResponse" xmlns:cns="https://www.ficohsa.com/regional/utility/constants"/>
            </response>
         </method>
      </resource>
   </resources>
</application>]]></con:wadl>
    <con:dependencies>
        <con:importSchema namespace="https://www.ficohsa.com/regional/utility/constants" schemaLocation="SBRG_Constants_Commons/Schemas/CustomParameter.xsd" ref="SBHN_Pension_Commons/Resources/SBRG_Constants_Commons/Schemas/CustomParameter"/>
    </con:dependencies>
</con:wadlEntry>