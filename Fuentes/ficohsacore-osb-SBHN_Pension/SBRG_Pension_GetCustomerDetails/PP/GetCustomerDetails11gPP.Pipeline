                        <con1:expr>
                            <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config"><![CDATA[<pen:getCustomerDetailsResponse>
  <ErrorInfo>
    {
       let $error := data($body/pen:getCustomerDetailsResponse/ErrorInfo/Details/SystemStatus)
       let $message := data($body/pen:getCustomerDetailsResponse/ErrorInfo/Details/Messages)
       return
	     
		if($error) then (
          <Code>{ $error }</Code>,
          <Description>{ $message }</Description>
		  ) else(
		  <Code>{fn:data($fault/ctx:errorCode) }</Code>,
          <Description>{ fn:data($fault/ctx:reason) }</Description>
		  )
    }
  </ErrorInfo>
</pen:getCustomerDetailsResponse>]]></con2:xqueryText>
