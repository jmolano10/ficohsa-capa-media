<?xml version="1.0" encoding="UTF-8"?>
<con:wadlEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:wadl><![CDATA[<application xmlns:soa="http://www.oracle.com/soa/rest" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://wadl.dev.java.net/2009/02">
   <doc title="CloudCodeRestBS">RestReference</doc>
   <grammars>
      <xsd:schema>
            <xsd:import namespace="https://www.ficohsa.com/regional/pension/CloudCodeTypes" schemaLocation="../Schemas/CloudCodeTypes.xsd"/>
        </xsd:schema>
   </grammars>
   <resources>
      <resource path="/cuentas/relaciones/periodos">
         <method name="GET" soa:wsdlOperation="getValidProductCustomer">
            <request soa:paramElement="pns:cloudCode" xmlns:pns="https://www.ficohsa.com/regional/pension/CloudCodeTypes">
               <param name="codigoCuenta" style="query" soa:expression="$msg.request/codigoCuenta" type="xsd:string"/>
               <param name="codigoTipoIdentificacionAfiliado" style="query" soa:expression="$msg.request/codigoTipoIdentificacionAfiliado" type="xsd:string"/>
               <param name="numeroIdentificacionAfiliado" style="query" soa:expression="$msg.request/numeroIdentificacionAfiliado" type="xsd:string"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:cloudCodeResponse" xmlns:cns="https://www.ficohsa.com/regional/pension/CloudCodeTypes"/>
            </response>
         </method>
      </resource>
   </resources>
</application>]]></con:wadl>
    <con:dependencies>
        <con:importSchema namespace="https://www.ficohsa.com/regional/pension/CloudCodeTypes" schemaLocation="../Schemas/CloudCodeTypes.xsd" ref="SBHN_Pension_GetValidProductCustomer/Schemas/CloudCodeTypes"/>
    </con:dependencies>
</con:wadlEntry>