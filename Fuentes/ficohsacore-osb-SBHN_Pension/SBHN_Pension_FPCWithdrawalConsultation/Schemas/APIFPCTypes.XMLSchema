<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="https://www.ficohsa.com/regional/pension"
            targetNamespace="https://www.ficohsa.com/regional/pension">
    <xsd:element name="CloudCode">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="numeroSolicitud" type="xsd:decimal"/>
        <xsd:element name="numeroIdentificacion" type="xsd:string"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="CloudCodeResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="error" type="xsd:string" minOccurs="0"/>
        <xsd:element name="mensaje" type="xsd:string" minOccurs="0"/>
        <xsd:element name="datos" minOccurs="0">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="retiros" minOccurs="0">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="id" type="xsd:string"/>
                    <xsd:element name="cuenta" type="xsd:string"/>
                    <xsd:element name="numeroIdentificacion" type="xsd:string"/>
                    <xsd:element name="nombreCliente" type="xsd:string"/>
                    <xsd:element name="formaPago" type="xsd:string"/>
                    <xsd:element name="moneda" type="xsd:string"/>
                    <xsd:element name="monto" type="xsd:decimal"/>
                    <xsd:element name="tipoRetiro" type="xsd:string"/>
                    <xsd:element name="cuentaBancaria" type="xsd:string"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>]]></con:schema>
    <con:targetNamespace>https://www.ficohsa.com/regional/pension</con:targetNamespace>
</con:schemaEntry>