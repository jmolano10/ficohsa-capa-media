<?xml version="1.0" encoding="UTF-8"?>
<con:wadlEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:wadl><![CDATA[<?xml version = '1.0' encoding = 'UTF-8'?>
<application xmlns:soa="http://www.oracle.com/soa/rest" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://wadl.dev.java.net/2009/02">
   <doc title="CloudCodeRestBS">RestReference</doc>
   <grammars>
      <xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <xsd:import namespace="https://www.ficohsa.com/regional/pension" schemaLocation="../Schemas/APIFPCTypes.xsd"/>
        </xsd:schema>
   </grammars>
   <resources>
      <resource path="/retiros">
         <method name="GET" soa:wsdlOperation="GetFPCWithdrawal">
            <request soa:paramElement="pns:CloudCode" xmlns:pns="https://www.ficohsa.com/regional/pension">
               <param name="numeroSolicitud" style="query" soa:expression="$msg.request/numeroSolicitud" type="xsd:decimal"/>
               <param name="numeroIdentificacion" style="query" soa:expression="$msg.request/numeroIdentificacion" type="xsd:string"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:CloudCodeResponse" xmlns:cns="https://www.ficohsa.com/regional/pension"/>
            </response>
         </method>
      </resource>
   </resources>
</application>]]></con:wadl>
    <con:dependencies>
        <con:importSchema namespace="https://www.ficohsa.com/regional/pension" schemaLocation="../Schemas/APIFPCTypes.xsd" ref="SBHN_Pension_FPCWithdrawalConsultation/Schemas/APIFPCTypes"/>
    </con:dependencies>
</con:wadlEntry>