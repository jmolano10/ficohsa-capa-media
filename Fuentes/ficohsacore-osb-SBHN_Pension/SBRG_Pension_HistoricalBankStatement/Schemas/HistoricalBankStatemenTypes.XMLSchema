<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<?xml version="1.0" encoding="windows-1252" ?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="https://www.ficohsa.com/regional/pension"
            targetNamespace="https://www.ficohsa.com/regional/pension"
            xmlns:com="https://www.ficohsa.com/regional/common/commonTypes">
  <xsd:import schemaLocation="../../SBRG_Pension_Commons/Schemas/CommonTypes.xsd"
              namespace="https://www.ficohsa.com/regional/common/commonTypes"/>
  <xsd:element name="historicalBankStatement">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="GeneralInfo" type="com:GeneralInfoType" minOccurs="0"/>
        <xsd:element name="IdentificationType" type="xsd:string"/>
        <xsd:element name="IdentificationNumber" type="xsd:string"/>
        <xsd:element name="StartDate" type="xsd:string"/>
        <xsd:element name="EndDate" type="xsd:string"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="historicalBankStatementResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="StatusInfo" type="com:StatusInfoType" minOccurs="0"/>
        <xsd:element name="ErrorInfo" type="com:StatusInfoType" minOccurs="0"/>
        <xsd:element name="Data" minOccurs="0" maxOccurs="unbounded">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="Error" type="xsd:string" minOccurs="0"/>
              <xsd:element name="Message" type="xsd:string" minOccurs="0"/>
              <xsd:element name="Data" minOccurs="0">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="StatusAccount" minOccurs="0">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="Date" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="NameClient" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="EmailClient" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="CustomerNumber" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="Movements" minOccurs="0" maxOccurs="unbounded">
                            <xsd:complexType>
                              <xsd:sequence>
                                <xsd:element name="Currency" type="xsd:string" minOccurs="0"/>
                                <xsd:element name="Account" type="xsd:string" minOccurs="0"/>
                                <xsd:element name="Yield" type="xsd:string" minOccurs="0"/>
                                <xsd:element name="TotalStaff" type="xsd:string" minOccurs="0"/>
                                <xsd:element name="TotalEmployee" type="xsd:string" minOccurs="0"/>
                                <xsd:element name="GrandTotal" type="xsd:string" minOccurs="0"/>
                                <xsd:element name="Transactions" maxOccurs="unbounded">
                                  <xsd:complexType>
                                    <xsd:sequence>
                                      <xsd:element name="Date" type="xsd:string" minOccurs="0"/>
                                      <xsd:element name="DescriptionTransaction" type="xsd:string" minOccurs="0"/>
                                      <xsd:element name="MovementStaff" type="xsd:string" minOccurs="0"/>
                                      <xsd:element name="EmployerMovement" type="xsd:string" minOccurs="0"/>
                                      <xsd:element name="TotalMovement" type="xsd:string" minOccurs="0"/>
                                    </xsd:sequence>
                                  </xsd:complexType>
                                </xsd:element>
                              </xsd:sequence>
                            </xsd:complexType>
                          </xsd:element>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>]]></con:schema>
    <con:dependencies>
        <con:import namespace="https://www.ficohsa.com/regional/common/commonTypes" schemaLocation="../../SBRG_Pension_Commons/Schemas/CommonTypes.xsd" ref="SBRG_Pension_Commons/Schemas/CommonTypes"/>
    </con:dependencies>
    <con:targetNamespace>https://www.ficohsa.com/regional/pension</con:targetNamespace>
</con:schemaEntry>