<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<?xml version="1.0" encoding="windows-1252" ?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes"
            targetNamespace="https://www.ficohsa.com/honduras/pension/cloudCodeTypes">
  <xsd:element name="getFICOPEN">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="codigoCuenta" type="xsd:string"/>
        <xsd:element name="fechaInicialConsulta" type="xsd:string"/>
        <xsd:element name="fechaFinalConsulta" type="xsd:string"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="getFICOPENResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="error" type="xsd:string" minOccurs="0"/>
        <xsd:element name="mensaje" type="xsd:string" minOccurs="0"/>
        <xsd:element name="datos">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="cuenta">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="tipoIdentificacion" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="numeroIdentificacionAfiliado" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="nombreCliente" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoCuenta" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="codigoMoneda" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="numeroSolicitudVinculacion" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="lineaProducto" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="patrocinador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="fechaAperturaCuenta" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="saldoTotalActual" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="saldosSubcuenta" maxOccurs="unbounded">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="subcuenta" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="saldoInicial" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="aportes" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="comisiones" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="retiros" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="rendimientos" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="seguros" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="saldoActual" type="xsd:string" minOccurs="0"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="monedas">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="codigoCuenta" type="xsd:integer"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="monedasResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="error" type="xsd:string" minOccurs="0"/>
        <xsd:element name="mensaje" type="xsd:string" minOccurs="0"/>
        <xsd:element name="datos" minOccurs="0">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="cuenta" minOccurs="0">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="codigoCuenta" type="xsd:integer" minOccurs="0"/>
                    <xsd:element name="codigoMoneda" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="descripcionMoneda" type="xsd:string" minOccurs="0"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="persona" minOccurs="0">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="tipoIdentificacion" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="identificacion" type="xsd:integer" minOccurs="0"/>
                    <xsd:element name="primerNombre" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="segundoNombre" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="primerApellido" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="segundoApellido" type="xsd:string" minOccurs="0"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>]]></con:schema>
    <con:targetNamespace>https://www.ficohsa.com/honduras/pension/cloudCodeTypes</con:targetNamespace>
</con:schemaEntry>