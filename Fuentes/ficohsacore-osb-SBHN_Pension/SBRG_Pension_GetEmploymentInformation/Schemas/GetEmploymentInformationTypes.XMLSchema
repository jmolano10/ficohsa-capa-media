<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<xsd:schema targetNamespace="https://www.ficohsa.com/regional/pension" xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns="https://www.ficohsa.com/regional/pension"
            xmlns:ctp="https://www.ficohsa.com/regional/common/commonTypes">
  <xsd:import schemaLocation="../../SBRG_Pension_Commons/Schemas/CommonTypes.xsd"
              namespace="https://www.ficohsa.com/regional/common/commonTypes"/>
  <xsd:element name="getEmploymentInformation">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="GeneralInfo" minOccurs="0" type="ctp:GeneralInfoType"/>
        <xsd:element name="AccountCode" type="xsd:string"/>
        <xsd:element name="StartDate" type="xsd:string"/>
        <xsd:element name="DateEnd" type="xsd:string"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="getEmploymentInformationResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="StatusInfo" type="ctp:StatusInfoType" minOccurs="0"/>
        <xsd:element name="ErrorInfo" type="ctp:ErrorInfoType" minOccurs="0"/>
        <xsd:element name="Data" minOccurs="0">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="Employment" minOccurs="0">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="HistoricalLaborInformation" maxOccurs="unbounded">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="AccountCode" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="AccountState" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="StartDate" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="DateEnd" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="Period" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="EmployerCode" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="RTNEmployer" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="EmployeeName" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="TypeIncome" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="ContributionAmount" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="CurrencySalary" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="SalaryAmount" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="CodeOccupation" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="DescriptionOccupation" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="JobCode" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="JobDescription" type="xsd:string" minOccurs="0"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>]]></con:schema>
    <con:dependencies>
        <con:import namespace="https://www.ficohsa.com/regional/common/commonTypes" schemaLocation="../../SBRG_Pension_Commons/Schemas/CommonTypes.xsd" ref="SBRG_Pension_Commons/Schemas/CommonTypes"/>
    </con:dependencies>
    <con:targetNamespace>https://www.ficohsa.com/regional/pension</con:targetNamespace>
</con:schemaEntry>