<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<xsd:schema targetNamespace="https://www.ficohsa.com/regional/pension" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="https://www.ficohsa.com/regional/pension" xmlns:ctp="https://www.ficohsa.com/regional/common/commonTypes">
  <xsd:import schemaLocation="../../SBRG_Pension_Commons/Schemas/CommonTypes.xsd" namespace="https://www.ficohsa.com/regional/common/commonTypes"/>
  <xsd:element name="getPensionFundByAccountNumber">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="GeneralInfo" minOccurs="0" type="ctp:GeneralInfoType"/>
        <xsd:element name="CodeAccount" type="xsd:string"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="getPensionFundByAccountNumberResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="StatusInfo" type="ctp:StatusInfoType" minOccurs="0"/>
        <xsd:element name="ErrorInfo" type="ctp:ErrorInfoType" minOccurs="0"/>
        <xsd:element name="Error" type="xsd:string"/>
        <xsd:element name="Message" type="xsd:string"/>
        <xsd:element name="Data">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="Customer" minOccurs="0">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="FirstName" minOccurs="0"/>
                    <xsd:element name="SecondName" minOccurs="0"/>
                    <xsd:element name="FirstSurname" minOccurs="0"/>
                    <xsd:element name="SecondSurname" minOccurs="0"/>
                    <xsd:element name="IdentificationType" minOccurs="0"/>
                    <xsd:element name="IdentificationNumber" minOccurs="0"/>
                    <xsd:element name="ExpirationDate" minOccurs="0"/>
                    <xsd:element name="Mail" minOccurs="0"/>
                    <xsd:element name="BirthDate" minOccurs="0"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Employer" minOccurs="0">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="TypeEmployerIdentification" minOccurs="0"/>
                    <xsd:element name="EmployerIdentificationNumber" minOccurs="0"/>
                    <xsd:element name="SocialReason" minOccurs="0"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Account" minOccurs="0">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="ApplicationDate" minOccurs="0"/>
                    <xsd:element name="ProductCode" minOccurs="0"/>
                    <xsd:element name="ProductName" minOccurs="0"/>
                    <xsd:element name="AmountContribution" minOccurs="0"/>
                    <xsd:element name="Frequency" minOccurs="0"/>
                    <xsd:element name="FormContribution" minOccurs="0"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
              <xsd:element name="Beneficiaries" minOccurs="0">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="CeneficiaryName" minOccurs="0"/>
                    <xsd:element name="BeneficiaryRelationship" minOccurs="0"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>]]></con:schema>
    <con:dependencies>
        <con:import namespace="https://www.ficohsa.com/regional/common/commonTypes" schemaLocation="../../SBRG_Pension_Commons/Schemas/CommonTypes.xsd" ref="SBRG_Pension_Commons/Schemas/CommonTypes"/>
    </con:dependencies>
    <con:targetNamespace>https://www.ficohsa.com/regional/pension</con:targetNamespace>
</con:schemaEntry>