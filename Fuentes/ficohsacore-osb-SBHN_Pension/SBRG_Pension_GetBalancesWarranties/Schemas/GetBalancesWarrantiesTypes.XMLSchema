<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<xsd:schema targetNamespace="https://www.ficohsa.com/regional/pension" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="https://www.ficohsa.com/regional/pension" xmlns:com="https://www.ficohsa.com/regional/common/commonTypes">
  <xsd:import schemaLocation="../../SBRG_Pension_Commons/Schemas/CommonTypes.xsd" namespace="https://www.ficohsa.com/regional/common/commonTypes"/>
  <xsd:element name="getBalancesWarranties">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="GeneralInfo" type="com:GeneralInfoType"/>
        <xsd:element name="AccountCode" type="xsd:string"/>
        <xsd:element name="SubAccountCode" type="xsd:string"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="getBalancesWarrantiesResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="StatusInfo" type="com:StatusInfoType"/>
        <xsd:element name="ErrorInfo" type="com:ErrorInfoType"/>
        <xsd:element name="Error" type="xsd:string"/>
        <xsd:element name="Message" type="xsd:string"/>
        <xsd:element name="Data" type="DataType"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <!-- Data Type -->
  <xsd:complexType name="DataType">
    <xsd:sequence>
      <xsd:element name="Account" type="AccountType" minOccurs="0"/>
      <xsd:element name="Restrictions" type="restrictionsType" minOccurs="0" maxOccurs="unbounded"/>
      <xsd:element name="Informations" type="informationType" minOccurs="0" maxOccurs="unbounded"/>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="AccountType">
    <xsd:sequence>
      <xsd:element name="raised" minOccurs="0" maxOccurs="unbounded">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="DateOpening" type="xsd:string"/>
            <xsd:element name="Status" type="xsd:string"/>
            <xsd:element name="SubAccountCode" type="xsd:string"/>
            <xsd:element name="CurrencyCode" type="xsd:string"/>
            <xsd:element name="Balance" type="xsd:string"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="CodeLineProduct" type="xsd:string"/>
      <xsd:element name="ProductCode" type="xsd:string"/>
      <xsd:element name="CodeCustomerIdentificationType" type="xsd:string"/>
      <xsd:element name="NumberCustomerIdentification" type="xsd:string"/>
    </xsd:sequence>
  </xsd:complexType>
  <xsd:complexType name="restrictionsType">
    <xsd:sequence>
      <xsd:element name="NameConceptRestriction" type="xsd:string"/>
      <xsd:element name="CodeLineProduct" type="xsd:string"/>
      <xsd:element name="DateStartApplicationRestriction" type="xsd:string"/>
      <xsd:element name="CodeConceptRestriction" type="xsd:string"/>
      <xsd:element name="CodeBusinessLine" type="xsd:string"/>
      <xsd:element name="CodeRestrictionType" type="xsd:string"/>
      <xsd:element name="CodeTypeAmountRestriction" type="xsd:string"/>
      <xsd:element name="RestrictionValue" type="xsd:string"/>
      <xsd:element name="DateRecordRestriction" type="xsd:string"/>
      <xsd:element name="CodeProcessRecordRestriction" type="xsd:string"/>
    </xsd:sequence>
  </xsd:complexType>
  <!-- Person Type -->
  <xsd:complexType name="informationType">
    <xsd:sequence>
      <xsd:element name="SubAccountCode" type="xsd:string"/>
      <xsd:element name="NameSubAccount" type="xsd:string"/>
      <xsd:element name="BalanceTotalLevel" type="xsd:string"/>
    </xsd:sequence>
  </xsd:complexType>
</xsd:schema>]]></con:schema>
    <con:dependencies>
        <con:import namespace="https://www.ficohsa.com/regional/common/commonTypes" schemaLocation="../../SBRG_Pension_Commons/Schemas/CommonTypes.xsd" ref="SBRG_Pension_Commons/Schemas/CommonTypes"/>
    </con:dependencies>
    <con:targetNamespace>https://www.ficohsa.com/regional/pension</con:targetNamespace>
</con:schemaEntry>