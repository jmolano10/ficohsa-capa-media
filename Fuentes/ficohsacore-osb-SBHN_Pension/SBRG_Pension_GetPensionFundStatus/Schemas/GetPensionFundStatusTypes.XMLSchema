<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<xsd:schema targetNamespace="https://www.ficohsa.com/regional/pension" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="https://www.ficohsa.com/regional/pension" xmlns:ctp="https://www.ficohsa.com/regional/common/commonTypes">
  <xsd:import schemaLocation="../../SBRG_Pension_Commons/Schemas/CommonTypes.xsd" namespace="https://www.ficohsa.com/regional/common/commonTypes"/>
  <xsd:element name="getPensionFundStatus">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="GeneralInfo" minOccurs="0" type="ctp:GeneralInfoType"/>
        <xsd:element name="CodeTypeIdentification" type="xsd:string"/>
        <xsd:element name="IdentificationNumber" type="xsd:string"/>
        <xsd:element name="NumberPhone" type="xsd:string"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="getPensionFundStatusResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="StatusInfo" type="ctp:StatusInfoType" minOccurs="0"/>
        <xsd:element name="ErrorInfo" type="ctp:ErrorInfoType" minOccurs="0"/>
        <xsd:element name="Error" type="xsd:string"/>
        <xsd:element name="Menssage" type="xsd:string"/>
        <xsd:element name="Data">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="Accounts">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="AccountCode" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="Currency" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="PersonalContribution" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="EmployersContribution" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="Interest" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="Commission" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="Withdrawal" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="Balance" type="xsd:string" minOccurs="0"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>]]></con:schema>
    <con:dependencies>
        <con:import namespace="https://www.ficohsa.com/regional/common/commonTypes" schemaLocation="../../SBRG_Pension_Commons/Schemas/CommonTypes.xsd" ref="SBRG_Pension_Commons/Schemas/CommonTypes"/>
    </con:dependencies>
    <con:targetNamespace>https://www.ficohsa.com/regional/pension</con:targetNamespace>
</con:schemaEntry>