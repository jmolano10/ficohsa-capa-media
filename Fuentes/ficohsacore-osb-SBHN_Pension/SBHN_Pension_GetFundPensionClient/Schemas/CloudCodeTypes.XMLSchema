<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<?xml version="1.0" encoding="windows-1252" ?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="https://www.ficohsa.com/regional/pension/cloudCodeTypes"
            targetNamespace="https://www.ficohsa.com/regional/pension/cloudCodeTypes">
  <xsd:element name="fondosPensiones">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="tipoIdentificacion" type="xsd:string"/>
        <xsd:element name="numeroIdentificacion" type="xsd:string"/>
        <xsd:element name="codigoCliente" type="xsd:string"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="fondosPensionesResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="error" type="xsd:string" minOccurs="0"/>
        <xsd:element name="mensaje" type="xsd:string" minOccurs="0"/>
        <xsd:element name="datos" minOccurs="0">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="cliente" minOccurs="0">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="tipoIdentificacion" type="xsd:string"/>
                    <xsd:element name="numeroIdentificacion" type="xsd:string"/>
                    <xsd:element name="codigoCliente" type="xsd:string"/>
                    <xsd:element name="cuentas" maxOccurs="unbounded">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="codigoCuenta" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="codigoMoneda" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="nombreMoneda" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="codigoLineaProducto" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="nombreLineaProducto" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="codigoProducto" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="nombreProducto" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="alternativa" type="xsd:string" minOccurs="0"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>]]></con:schema>
    <con:targetNamespace>https://www.ficohsa.com/regional/pension/cloudCodeTypes</con:targetNamespace>
</con:schemaEntry>