<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<xsd:schema targetNamespace="https://www.ficohsa.com/regional/pension" xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns="https://www.ficohsa.com/regional/pension" xmlns:gfu="https://www.ficohsa.com/regional/pension"
            xmlns:ctp="https://www.ficohsa.com/regional/common/commonTypes">
  <xsd:import schemaLocation="../../SBHN_Pension_Commons/Schemas/CommonTypes.xsd"
              namespace="https://www.ficohsa.com/regional/common/commonTypes"/>
  <xsd:element name="getFundPensionClient">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="GeneralInfo" minOccurs="0" type="ctp:GeneralInfoType"/>
        <xsd:element name="IdentificationType" type="xsd:string"/>
        <xsd:element name="IdentificationNumber" type="xsd:string"/>
        <xsd:element name="Clientcode" type="xsd:string"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="getFundPensionClientResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="StatusInfo" type="ctp:StatusInfoType" minOccurs="0"/>
        <xsd:element name="ErrorInfo" type="ctp:ErrorInfoType" minOccurs="0"/>
        <xsd:element name="Data" minOccurs="0">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="Client" minOccurs="0">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="IdentificationType" type="xsd:string"/>
                    <xsd:element name="IdentificationNumber" type="xsd:string"/>
                    <xsd:element name="Clientcode" type="xsd:string"/>
                    <xsd:element name="Accounts" maxOccurs="unbounded">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="AccountCode" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="CurrencyCode" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="CurrencyName" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="CodeProductLine" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="ProductLineName" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="ProductCode" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="ProductName" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="Alternative" type="xsd:string" minOccurs="0"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>]]></con:schema>
    <con:dependencies>
        <con:import namespace="https://www.ficohsa.com/regional/common/commonTypes" schemaLocation="../../SBHN_Pension_Commons/Schemas/CommonTypes.xsd" ref="SBHN_Pension_Commons/Schemas/CommonTypes"/>
    </con:dependencies>
    <con:targetNamespace>https://www.ficohsa.com/regional/pension</con:targetNamespace>
</con:schemaEntry>