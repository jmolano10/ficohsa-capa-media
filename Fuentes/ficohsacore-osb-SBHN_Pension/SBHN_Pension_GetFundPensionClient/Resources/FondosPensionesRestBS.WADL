<?xml version="1.0" encoding="UTF-8"?>
<con:wadlEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:wadl><![CDATA[<?xml version = '1.0' encoding = 'UTF-8'?>
<application xmlns:soa="http://www.oracle.com/soa/rest" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://wadl.dev.java.net/2009/02">
   <doc title="FondosPensionesRestBS">RestReference</doc>
   <grammars>
      <xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <xsd:import namespace="https://www.ficohsa.com/regional/pension/cloudCodeTypes" schemaLocation="../Schemas/CloudCodeTypes.xsd"/>
        </xsd:schema>
   </grammars>
   <resources>
      <resource path="/clientes/fondos/pensiones">
         <method name="GET" soa:wsdlOperation="fondosPesniones">
            <request soa:paramElement="pns:fondosPensiones" xmlns:pns="https://www.ficohsa.com/regional/pension/cloudCodeTypes">
               <param name="tipoIdentificacion" style="query" soa:expression="$msg.request/tipoIdentificacion" type="xsd:string"/>
               <param name="numeroIdentificacion" style="query" soa:expression="$msg.request/numeroIdentificacion" type="xsd:string"/>
               <param name="codigoCliente" style="query" soa:expression="$msg.request/codigoCliente" type="xsd:string"/>
            </request>
            <response status="200">
               <representation mediaType="application/xml" element="cns:fondosPensionesResponse" xmlns:cns="https://www.ficohsa.com/regional/pension/cloudCodeTypes"/>
               <representation mediaType="application/json" element="cns:fondosPensionesResponse" xmlns:cns="https://www.ficohsa.com/regional/pension/cloudCodeTypes"/>
            </response>
         </method>
      </resource>
   </resources>
</application>]]></con:wadl>
    <con:dependencies>
        <con:importSchema namespace="https://www.ficohsa.com/regional/pension/cloudCodeTypes" schemaLocation="../Schemas/CloudCodeTypes.xsd" ref="SBHN_Pension_GetFundPensionClient/Schemas/CloudCodeTypes"/>
    </con:dependencies>
</con:wadlEntry>