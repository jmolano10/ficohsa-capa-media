   <doc title="GetFundPensionClientRestPS">RestService</doc>
   <grammars>
      <xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns="https://www.ficohsa.com/regional/pension" xmlns:inp1="https://www.ficohsa.com/regional/pension" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">
            <xsd:import namespace="https://www.ficohsa.com/regional/pension" schemaLocation="../Schemas/GetFundPensionClientTypes.xsd"/>
        </xsd:schema>
   </grammars>
   <resources>
      <resource path="/">
