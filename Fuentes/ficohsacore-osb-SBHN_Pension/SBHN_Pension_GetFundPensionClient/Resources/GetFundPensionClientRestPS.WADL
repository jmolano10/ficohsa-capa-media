               <representation mediaType="application/json" element="cns:getFundPensionClient" xmlns:cns="https://www.ficohsa.com/regional/pension"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:getFundPensionClientResponse" xmlns:cns="https://www.ficohsa.com/regional/pension"/>
            </response>
         </method>
      </resource>
   </resources>
</application>]]></con:wadl>
