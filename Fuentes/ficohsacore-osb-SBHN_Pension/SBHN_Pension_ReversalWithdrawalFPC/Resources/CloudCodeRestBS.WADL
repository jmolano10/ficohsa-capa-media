<?xml version="1.0" encoding="UTF-8"?>
<con:wadlEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:wadl><![CDATA[<?xml version = '1.0' encoding = 'UTF-8'?>
<application xmlns:soa="http://www.oracle.com/soa/rest" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ns0="https://www.ficohsa.com/regional/pension" xmlns="http://wadl.dev.java.net/2009/02">
   <doc title="CloudCodeRestBS">RestReference</doc>
   <grammars>
      <xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <xsd:import namespace="https://www.ficohsa.com/honduras/pension/cloudCodeTypes" schemaLocation="../Schemas/APIFPCTypes.xsd"/>
        </xsd:schema>
   </grammars>
   <resources>
      <resource path="/retiros">
         <method name="PUT" soa:wsdlOperation="ReversalWithdrawalFPC">
            <request>
               <representation mediaType="application/json" element="cns:CloudCode" xmlns:cns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:CloudCodeResponse" xmlns:cns="https://www.ficohsa.com/honduras/pension/cloudCodeTypes"/>
            </response>
         </method>
      </resource>
   </resources>
</application>]]></con:wadl>
    <con:dependencies>
        <con:importSchema namespace="https://www.ficohsa.com/honduras/pension/cloudCodeTypes" schemaLocation="../Schemas/APIFPCTypes.xsd" ref="SBHN_Pension_ReversalWithdrawalFPC/Schemas/APIFPCTypes"/>
    </con:dependencies>
</con:wadlEntry>