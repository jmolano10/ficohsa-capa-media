<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<?xml version="1.0" encoding="windows-1252" ?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="https://www.ficohsa.com/regional/pension"
            targetNamespace="https://www.ficohsa.com/honduras/pension/cloudCodeTypes" elementFormDefault="qualified">
  <xsd:element name="CloudCode">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="numeroTransaccion" type="xsd:string"/>
        <xsd:element name="cuenta" type="xsd:string"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="CloudCodeResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="error" type="xsd:string" minOccurs="0"/>
        <xsd:element name="mensaje" type="xsd:string" minOccurs="0"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>]]></con:schema>
    <con:targetNamespace>https://www.ficohsa.com/honduras/pension/cloudCodeTypes</con:targetNamespace>
</con:schemaEntry>