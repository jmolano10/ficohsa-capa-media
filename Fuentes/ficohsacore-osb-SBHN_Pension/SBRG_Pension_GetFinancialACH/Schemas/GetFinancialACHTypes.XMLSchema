<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<xs:schema targetNamespace="https://www.ficohsa.com/regional/pension" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:gfa="https://www.ficohsa.com/regional/pension" xmlns:com="https://www.ficohsa.com/regional/common/commonTypes">
	<xs:import schemaLocation="../../SBRG_Pension_Commons/Schemas/CommonTypes.xsd" namespace="https://www.ficohsa.com/regional/common/commonTypes"/>

	  <xs:element name="getFinancialACH">
	  	<xs:complexType>
	  		<xs:sequence>
	  			<xs:element name="GeneralInfo" type="com:GeneralInfoType"/>
	  		</xs:sequence>
	  	</xs:complexType>
	  </xs:element>
   
      <xs:element name="getFinancialACHResponse">
       <xs:complexType>
         <xs:sequence>
			<xs:element name="StatusInfo" type="com:StatusInfoType"/>
			<xs:element name="ErrorInfo" type="com:ErrorInfoType"/> 		 
            <xs:element name="Data">
               <xs:complexType>
                  <xs:sequence>
                     <xs:element name="Entities" maxOccurs="unbounded">
                        <xs:complexType>
                           <xs:sequence>
                              <xs:element name="Code" type="xs:integer"/>
                              <xs:element name="Description" type="xs:string"/>
                           </xs:sequence>
                        </xs:complexType>
                     </xs:element>
                  </xs:sequence>
               </xs:complexType>
            </xs:element>
         </xs:sequence>
      </xs:complexType>
   </xs:element>
   
</xs:schema>]]></con:schema>
    <con:dependencies>
        <con:import namespace="https://www.ficohsa.com/regional/common/commonTypes" schemaLocation="../../SBRG_Pension_Commons/Schemas/CommonTypes.xsd" ref="SBRG_Pension_Commons/Schemas/CommonTypes"/>
    </con:dependencies>
    <con:targetNamespace>https://www.ficohsa.com/regional/pension</con:targetNamespace>
</con:schemaEntry>