<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<xsd:schema targetNamespace="https://www.ficohsa.com/honduras/pension" xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:gpf="https://www.ficohsa.com/honduras/pension"
            xmlns:com="https://www.ficohsa.com/regional/common/commonTypes">
  <xsd:import schemaLocation="../../SBHN_Pension_Commons/Schemas/CommonTypes.xsd"
              namespace="https://www.ficohsa.com/regional/common/commonTypes"/>
  <xsd:element name="getPensionFund">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="GeneralInfo" type="com:GeneralInfoType"/>
        <xsd:element name="AccountCode" type="xsd:string"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="getPensionFundResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="StatusInfo" type="com:StatusInfoType" minOccurs="0"/>
        <xsd:element name="ErrorInfo" type="com:ErrorInfoType" minOccurs="0"/>
        <xsd:element name="Data" minOccurs="0">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="Account" minOccurs="0">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="AccountCode" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="CustomerCode" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="CustomerName" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="CodeProductLine" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="ProductName" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="ProductCode" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="OpeningDate" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="InsuredAmount" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="LastContribution" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="NextContribution" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="LastContributionAmount" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="LastContributionExtra" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="FrequencyContribution" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="FormContribution" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="AmountContribution" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="Beneficiaries" maxOccurs="unbounded">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="NameBeneficiary" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="RelationshipBeneficiary" type="xsd:string" minOccurs="0"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>]]></con:schema>
    <con:dependencies>
        <con:import namespace="https://www.ficohsa.com/regional/common/commonTypes" schemaLocation="../../SBHN_Pension_Commons/Schemas/CommonTypes.xsd" ref="SBHN_Pension_Commons/Schemas/CommonTypes"/>
    </con:dependencies>
    <con:targetNamespace>https://www.ficohsa.com/honduras/pension</con:targetNamespace>
</con:schemaEntry>