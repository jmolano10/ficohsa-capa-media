<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<?xml version="1.0" encoding="windows-1252" ?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" 
            xmlns="https://www.ficohsa.com/honduras/pension/getEncryptCredentialsTypes"
            targetNamespace="https://www.ficohsa.com/honduras/pension/getEncryptCredentialsTypes">
  <xsd:element name="cloudCodeLoginRequest">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="userName" type="xsd:string"/>
        <xsd:element name="password" type="xsd:string"/>
        <xsd:element name="timestamp" type="xsd:dateTime" minOccurs="0"/>
        <xsd:element name="forceLogin" type="xsd:boolean"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="cloudCodeLoginResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="successIndicator" type="xsd:string" minOccurs="0"/>
        <xsd:element name="message" type="xsd:string" minOccurs="0"/>
        <xsd:element name="credentials" type="xsd:string" minOccurs="0"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>]]></con:schema>
    <con:targetNamespace>https://www.ficohsa.com/honduras/pension/getEncryptCredentialsTypes</con:targetNamespace>
</con:schemaEntry>