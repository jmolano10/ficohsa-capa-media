<?xml version="1.0" encoding="UTF-8"?>
<con:wadlEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:wadl><![CDATA[<application xmlns:soa="http://www.oracle.com/soa/rest" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://wadl.dev.java.net/2009/02">
   <doc title="CloudCodeLoginRestBS">RestReference</doc>
   <grammars>
      <xsd:schema>
            <xsd:import namespace="http://www.ficohsa.com.hn/honduras/cloudCodeLoginTypes" schemaLocation="../Schemas/CloudCodeLoginTypes.xsd"/>
        </xsd:schema>
   </grammars>
   <resources>
      <resource path="/auth/login">
         <method name="POST" soa:wsdlOperation="login">
            <request>
               <representation mediaType="application/json" element="cns:cloudCodeLogin" xmlns:cns="http://www.ficohsa.com.hn/honduras/cloudCodeLoginTypes"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:cloudCodeLoginResponse" xmlns:cns="http://www.ficohsa.com.hn/honduras/cloudCodeLoginTypes"/>
            </response>
         </method>
      </resource>
   </resources>
</application>]]></con:wadl>
    <con:dependencies>
        <con:importSchema namespace="http://www.ficohsa.com.hn/honduras/cloudCodeLoginTypes" schemaLocation="../Schemas/CloudCodeLoginTypes.xsd" ref="SBHN_Pension_CloudCodeLogin/Schemas/CloudCodeLoginTypes"/>
    </con:dependencies>
</con:wadlEntry>