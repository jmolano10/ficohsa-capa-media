<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<?xml version="1.0" encoding="windows-1252" ?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ech="https://www.ficohsa.com/honduras/pension/cloudCodeTypes"
            targetNamespace="https://www.ficohsa.com/honduras/pension/cloudCodeTypes" elementFormDefault="qualified">
  <xsd:element name="estadoCuentasHistoricos">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="ech:estadoCuentaItem" maxOccurs="unbounded" />
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  
    <xsd:element name="estadoCuentaItem">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="tipoIdentificacion" type="xsd:string"/>
        <xsd:element name="numeroIdentificacion" type="xsd:string"/>
        <xsd:element name="fechaInicio" type="xsd:string"/>
        <xsd:element name="fechaFinal" type="xsd:string"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  
  
<xsd:element name="estadoCuentasHistoricosResponse">
    <xsd:complexType>
      <xsd:sequence>
              <xsd:element name="error" type="xsd:boolean" minOccurs="0"/>
              <xsd:element name="mensaje" type="xsd:string" minOccurs="0"/>
              <xsd:element name="datos" maxOccurs="unbounded">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="estadoCuenta">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="fecha" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="nombreCliente" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="emailCliente" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="numeroCliente" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="movimientos" maxOccurs="unbounded">
                            <xsd:complexType>
                              <xsd:sequence>
                                <xsd:element name="moneda" type="xsd:string" minOccurs="0"/>
                                <xsd:element name="cuenta" type="xsd:string" minOccurs="0"/>
                                <xsd:element name="rendimiento" type="xsd:string" minOccurs="0"/>
                                <xsd:element name="totalPersonal" type="xsd:string" minOccurs="0"/>
                                <xsd:element name="totalPatronal" type="xsd:string" minOccurs="0"/>
                                <xsd:element name="granTotal" type="xsd:string" minOccurs="0"/>
                                <xsd:element name="transacciones" maxOccurs="unbounded">
                                  <xsd:complexType>
                                    <xsd:sequence>
                                      <xsd:element name="fecha" type="xsd:string" minOccurs="0"/>
                                      <xsd:element name="tipoMovimiento" type="xsd:string" minOccurs="0"/>                                      
                                      <xsd:element name="descripcionTransaccion" type="xsd:string" minOccurs="0"/>
                                      <xsd:element name="movimientoPersonal" type="xsd:string" minOccurs="0"/>
                                      <xsd:element name="movimientoPatronal" type="xsd:string" minOccurs="0"/>
                                      <xsd:element name="movimientoTotal" type="xsd:string" minOccurs="0"/>
                                    </xsd:sequence>
                                  </xsd:complexType>
                                </xsd:element>
                              </xsd:sequence>
                            </xsd:complexType>
                          </xsd:element>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>]]></con:schema>
    <con:targetNamespace>https://www.ficohsa.com/honduras/pension/cloudCodeTypes</con:targetNamespace>
</con:schemaEntry>