<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<?xml version="1.0" encoding="windows-1252" ?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="https://www.ficohsa.com/regional/pension"
            targetNamespace="https://www.ficohsa.com/regional/common/pensionCommonType">
 
 
 <!--Entrega 5 -->
<xsd:complexType name="PensionDetailsType">
    <xsd:sequence>
      <xsd:element name="BalanceType" type="xsd:string" minOccurs="0"/>
      <xsd:element name="PreviousBalance" type="xsd:decimal" minOccurs="0"/>
      <xsd:element name="GrossContributionsAmount" type="xsd:decimal" minOccurs="0"/>
      <xsd:element name="InterestAmount" type="xsd:decimal" minOccurs="0"/>
      <xsd:element name="WithdrawalsAmount" type="xsd:decimal" minOccurs="0"/>
      <xsd:element name="FeeAmount" type="xsd:decimal" minOccurs="0"/>
      <xsd:element name="InsuranceAmount" type="xsd:decimal" minOccurs="0"/>
      <xsd:element name="CurrentBalance" type="xsd:decimal" minOccurs="0"/>
    </xsd:sequence>
  </xsd:complexType>

</xsd:schema>]]></con:schema>
    <con:targetNamespace>https://www.ficohsa.com/regional/common/pensionCommonType</con:targetNamespace>
