<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<xsd:schema targetNamespace="https://www.ficohsa.com/regional/pension" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="https://www.ficohsa.com/regional/pension" xmlns:pscommon="https://www.ficohsa.com/regional/common/pensionCommonType" xmlns:ps="https://www.ficohsa.com/regional/pension" xmlns:ctp="https://www.ficohsa.com/regional/common/commonTypes">
  <xsd:import schemaLocation="CommonTypes.xsd" namespace="https://www.ficohsa.com/regional/common/commonTypes"/>
  <xsd:import schemaLocation="PensionCommonTypes.xsd" id="PensionCommonTypes" namespace="https://www.ficohsa.com/regional/common/pensionCommonType"/>
  
 <!-- Entrega 5 -->
 <xsd:element name="getPensionDetails">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="GeneralInfo" type="ctp:GeneralInfoType"/>
        <xsd:element name="InvestmentCode" type="ctp:string1" minOccurs="1"/>
        <xsd:element name="StartDate" type="xsd:date" minOccurs="1"/>
        <xsd:element name="EndDate" type="xsd:date" minOccurs="1"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  
   <xsd:element name="getPensionDetailsResponse">
    <xsd:complexType>
      <xsd:sequence> 
        <xsd:element name="StatusInfo" type="ctp:StatusInfoType" minOccurs="0"/>
        <xsd:element name="ErrorInfo" type="ctp:ErrorInfoType" minOccurs="0"/>
        <xsd:element name="CustomerLegalId" type="xsd:string" minOccurs="0"/>
        <xsd:element name="CustomerName" type="xsd:string" minOccurs="0"/>
        <xsd:element name="AccountNumber" type="xsd:string" minOccurs="0"/>
        <xsd:element name="AccountCurrency" type="xsd:string" minOccurs="0"/>
        <xsd:element name="ContractNumber" type="xsd:string" minOccurs="0"/>
        <xsd:element name="ContractType" type="xsd:string" minOccurs="0"/>
        <xsd:element name="Company" type="xsd:string" minOccurs="0"/>
        <xsd:element name="StartDate" type="xsd:string" minOccurs="0"/>
        <xsd:element name="PensionDetails" type="pscommon:PensionDetailsType" minOccurs="0"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  
</xsd:schema>]]></con:schema>
    <con:dependencies>
        <con:import namespace="https://www.ficohsa.com/regional/common/commonTypes" schemaLocation="CommonTypes.xsd" ref="SBRG_Pension_Commons/Schemas/CommonTypes"/>
        <con:import namespace="https://www.ficohsa.com/regional/common/pensionCommonType" schemaLocation="PensionCommonTypes.xsd" ref="SBRG_Pension_Commons/Schemas/PensionCommonTypes"/>
    </con:dependencies>
    <con:targetNamespace>https://www.ficohsa.com/regional/pension</con:targetNamespace>
</con:schemaEntry>