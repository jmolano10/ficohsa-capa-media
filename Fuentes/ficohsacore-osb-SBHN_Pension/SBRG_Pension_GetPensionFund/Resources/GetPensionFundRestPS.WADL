<?xml version="1.0" encoding="UTF-8"?>
<con:wadlEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:wadl><![CDATA[<application xmlns:soa="http://www.oracle.com/soa/rest" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://wadl.dev.java.net/2009/02">
   <doc title="GetPensionFundRestPS">RestService</doc>
   <grammars>
      <xsd:schema xmlns:tns="https://www.ficohsa.com/regional/pension" xmlns:inp1="https://www.ficohsa.com/regional/pension" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/">
            <xsd:import namespace="https://www.ficohsa.com/regional/pension" schemaLocation="../Schemas/GetPensionFundTypes.xsd"/>
        </xsd:schema>
   </grammars>
   <resources>
      <resource path="/">
         <method name="POST" soa:wsdlOperation="getPensionFund">
            <request>
               <representation mediaType="application/json" element="cns:getPensionFund" xmlns:cns="https://www.ficohsa.com/regional/pension"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:getPensionFundResponse" xmlns:cns="https://www.ficohsa.com/regional/pension"/>
            </response>
         </method>
      </resource>
   </resources>
</application>]]></con:wadl>
    <con:dependencies>
        <con:importSchema namespace="https://www.ficohsa.com/regional/pension" schemaLocation="../Schemas/GetPensionFundTypes.xsd" ref="SBRG_Pension_GetPensionFund/Schemas/GetPensionFundTypes"/>
    </con:dependencies>
</con:wadlEntry>