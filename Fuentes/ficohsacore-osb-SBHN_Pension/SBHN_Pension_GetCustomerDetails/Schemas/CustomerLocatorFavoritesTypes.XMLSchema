<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<?xml version="1.0" encoding="windows-1252" ?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="https://www.ficohsa.com/honduras/pension"
            targetNamespace="https://www.ficohsa.com/honduras/pension">
  <xsd:element name="customerLocatorFavoritesRequest">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="codigoTipoIdentificacion" type="xsd:string"/>
        <xsd:element name="numeroIdentificacion" type="xsd:string"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="customerLocatorFavoritesResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="error" type="xsd:string" minOccurs="0"/>
        <xsd:element name="mensaje" type="xsd:string" minOccurs="0"/>
        <xsd:element name="datos" minOccurs="0">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="localizadores" minOccurs="0">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="residencial" minOccurs="0" maxOccurs="unbounded">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="codigoUbicacion" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="codigoPais" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="nombrePais" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="codigoDepartamento" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="nombreDepartamento" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="codigoMunicipio" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="nombreMunicipio" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="codigoColinia" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="nombreColonia" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="direccionFisica" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="codigoAreaTelefono" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="numeroTelefono" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="codigoAreaCelular" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="tipoLocalizador" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="numeroCelular" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="correoElectronico" type="xsd:string" minOccurs="0"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="laboral" minOccurs="0" maxOccurs="unbounded">
                      <xsd:complexType>
                        <xsd:sequence>
                          <xsd:element name="codigoUbicacion" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="codigoPais" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="nombrePais" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="codigoDepartamento" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="nombreDepartamento" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="codigoMunicipio" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="nombreMunicipio" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="codigoColinia" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="nombreColonia" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="direccionFisica" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="codigoAreaTelefono" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="numeroTelefono" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="codigoAreaCelular" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="tipoLocalizador" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="numeroCelular" type="xsd:string" minOccurs="0"/>
                          <xsd:element name="correoElectronico" type="xsd:string" minOccurs="0"/>
                        </xsd:sequence>
                      </xsd:complexType>
                    </xsd:element>
                    <xsd:element name="celularSms" type="xsd:string" minOccurs="0"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>]]></con:schema>
    <con:targetNamespace>https://www.ficohsa.com/honduras/pension</con:targetNamespace>
</con:schemaEntry>