<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<?xml version="1.0" encoding="windows-1252" ?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="https://www.ficohsa.com/honduras/pension"
            targetNamespace="https://www.ficohsa.com/honduras/pension">
            <xsd:element name="customerWorkRequest">
              <xsd:complexType>
                <xsd:sequence>
                  <xsd:element name="tipoIdentificacion" type="xsd:string"/>
                  <xsd:element name="numeroIdentificacion" type="xsd:string"/>
                </xsd:sequence>
              </xsd:complexType>
            </xsd:element>
  <xsd:element name="customerWorkResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="error" type="xsd:boolean" minOccurs="0"/>
        <xsd:element name="mensaje" type="xsd:string" minOccurs="0"/>
        <xsd:element name="datos" minOccurs="0">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="laborales" minOccurs="0" maxOccurs="unbounded">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="codigoIdentificacionEmpleador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="numeroIdentificacionEmpleador" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="razonSocial" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="fechaIngresoLabor" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="cargo" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="empleoActual" type="xsd:string" minOccurs="0"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>]]></con:schema>
    <con:targetNamespace>https://www.ficohsa.com/honduras/pension</con:targetNamespace>
</con:schemaEntry>