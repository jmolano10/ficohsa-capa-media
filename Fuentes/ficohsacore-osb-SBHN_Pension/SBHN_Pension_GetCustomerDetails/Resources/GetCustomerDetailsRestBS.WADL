<?xml version="1.0" encoding="UTF-8"?>
<con:wadlEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:wadl><![CDATA[<?xml version = '1.0' encoding = 'UTF-8'?>
<application xmlns:soa="http://www.oracle.com/soa/rest" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://wadl.dev.java.net/2009/02">
   <doc title="GetCustomerDetailsRestBS">RestReference</doc>
   <grammars>
      <xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <xsd:import namespace="https://www.ficohsa.com/honduras/pension" schemaLocation="../Schemas/CustomerLocatorFavoritesTypes.xsd"/>
        </xsd:schema>
      <xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <xsd:import namespace="https://www.ficohsa.com/honduras/pension" schemaLocation="../Schemas/CustomerWorkTypes.xsd"/>
        </xsd:schema>
   </grammars>
   <resources>
      <resource path="/clientes/localizadores/preferidos">
         <method name="GET" soa:wsdlOperation="GetFavorites">
            <request soa:paramElement="pns:customerLocatorFavoritesRequest" xmlns:pns="https://www.ficohsa.com/honduras/pension">
               <param name="codigoTipoIdentificacion" style="query" soa:expression="$msg.request/codigoTipoIdentificacion" type="xsd:string"/>
               <param name="numeroIdentificacion" style="query" soa:expression="$msg.request/numeroIdentificacion" type="xsd:string"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:customerLocatorFavoritesResponse" xmlns:cns="https://www.ficohsa.com/honduras/pension"/>
            </response>
         </method>
      </resource>
      <resource path="/clientes/laborales">
         <method name="GET" soa:wsdlOperation="GetWorkInformation">
            <request soa:paramElement="pns:customerWorkRequest" xmlns:pns="https://www.ficohsa.com/honduras/pension">
               <param name="tipoIdentificacion" style="query" soa:expression="$msg.request/tipoIdentificacion" type="xsd:string"/>
               <param name="numeroIdentificacion" style="query" soa:expression="$msg.request/numeroIdentificacion" type="xsd:string"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:customerWorkResponse" xmlns:cns="https://www.ficohsa.com/honduras/pension"/>
            </response>
         </method>
      </resource>
   </resources>
</application>]]></con:wadl>
    <con:dependencies>
        <con:importSchema namespace="https://www.ficohsa.com/honduras/pension" schemaLocation="../Schemas/CustomerLocatorFavoritesTypes.xsd" ref="SBHN_Pension_GetCustomerDetails/Schemas/CustomerLocatorFavoritesTypes"/>
        <con:importSchema namespace="https://www.ficohsa.com/honduras/pension" schemaLocation="../Schemas/CustomerWorkTypes.xsd" ref="SBHN_Pension_GetCustomerDetails/Schemas/CustomerWorkTypes"/>
    </con:dependencies>
</con:wadlEntry>