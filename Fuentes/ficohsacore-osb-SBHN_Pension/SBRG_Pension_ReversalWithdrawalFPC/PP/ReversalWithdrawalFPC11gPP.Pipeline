<?xml version="1.0" encoding="UTF-8"?>
<con:pipelineEntry xmlns:con="http://www.bea.com/wli/sb/pipeline/config" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <con:coreEntry>
        <con:binding type="SOAP" isSoap12="false" xsi:type="con:SoapBindingType">
            <con:wsdl ref="SBRG_Pension_ReversalWithdrawalFPC/Resources/ReversalWithdrawalFPC11g"/>
            <con:binding>
                <con:name>ReversalWithdrawalFPC11gBind</con:name>
                <con:namespace>https://www.ficohsa.com/regional/pension</con:namespace>
            </con:binding>
        </con:binding>
        <con:xqConfiguration>
            <con:snippetVersion>1.0</con:snippetVersion>
        </con:xqConfiguration>
    </con:coreEntry>
    <con:router>
        <con:pipeline type="request" name="request-N53e8e33c.N70f83696.0.18cc31239e0.N7f43">
            <con:stage id="_StageId-N53e8e33c.N70f83696.0.18cc31239e0.N7ec7" name="Stage1">
                <con:context>
                    <con1:userNsDecl prefix="aut" namespace="http://www.ficohsa.com.hn/middleware.services/autType" xmlns:con1="http://www.bea.com/wli/sb/stages/config"/>
                    <con1:userNsDecl prefix="pen" namespace="https://www.ficohsa.com/regional/pension" xmlns:con1="http://www.bea.com/wli/sb/stages/config"/>
                </con:context>
                <con:actions>
                    <con2:assign varName="authorization" xmlns:con2="http://www.bea.com/wli/sb/stages/transform/config" xmlns:con1="http://www.bea.com/wli/sb/stages/routing/config">
                        <con3:id xmlns:con3="http://www.bea.com/wli/sb/stages/config">_ActionId-N53e8e33c.N70f83696.0.18cc31239e0.N7ec6</con3:id>
                        <con2:expr>
                            <con3:xqueryTransform xmlns:con3="http://www.bea.com/wli/sb/stages/config">
                                <con3:resource ref="SBRG_Pension_Commons/Transformations/VirtualAuthentication"/>
                                <con3:param name="entrada">
                                    <con3:path>fn:concat(
  data($header/aut:RequestHeader/Authentication/UserName/text()),
  ':',
  data($header/aut:RequestHeader/Authentication/Password/text())
)</con3:path>
                                </con3:param>
                            </con3:xqueryTransform>
                        </con2:expr>
                    </con2:assign>
                    <con1:wsCallout xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N53e8e33c.N70f83696.0.18cc31239e0.N7ec5</con2:id>
                        <con1:service ref="SBRG_Pension_ReversalWithdrawalFPC/BS/ReversalWithdrawalFPCSoapBS" xsi:type="ref:BusinessServiceRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
                        <con1:operation>reversalWithdrawalFPC</con1:operation>
                        <con1:request>
                            <con1:body wrapped="false">REQ</con1:body>
                        </con1:request>
                        <con1:response>
                            <con1:body wrapped="false">RSP</con1:body>
                        </con1:response>
                        <con1:requestTransform>
                            <con1:assign varName="REQ">
                                <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N53e8e33c.N70f83696.0.18cc31239e0.N7ec4</con2:id>
                                <con1:expr>
                                    <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">$body/pen:ReversalWithdrawalFPC</con2:xqueryText>
                                </con1:expr>
                            </con1:assign>
                            <con3:transport-headers copy-all="false" xmlns:con2="http://www.bea.com/wli/sb/stages/transform/config" xmlns:con1="http://www.bea.com/wli/sb/stages/routing/config" xmlns:con3="http://www.bea.com/wli/sb/stages/transform/config">
                                <con4:id xmlns:con4="http://www.bea.com/wli/sb/stages/config">_ActionId-N53e8e33c.N70f83696.0.18cc31239e0.N7ec3</con4:id>
                                <con2:header-set>outbound-request</con2:header-set>
                                <con2:header value="expression" name="Authorization">
                                    <con3:xqueryText xmlns:con3="http://www.bea.com/wli/sb/stages/config">fn:concat("Basic ", data($authorization))</con3:xqueryText>
                                </con2:header>
                                <con2:header value="expression" name="Accept">
                                    <con3:xqueryText xmlns:con3="http://www.bea.com/wli/sb/stages/config">"text/xml"</con3:xqueryText>
                                </con2:header>
                            </con3:transport-headers>
                            <con1:routing-options>
                                <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N53e8e33c.N70f83696.0.18cc31239e0.N7ec2</con2:id>
                                <con1:uriExpr>
                                    <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">'https://mwservices.gfficohsa.hn:8020/regional/pension/soap/reversalWithdrawalFPC/v1'</con2:xqueryText>
                                </con1:uriExpr>
                            </con1:routing-options>
                            <con3:delete varName="header" xmlns:con2="http://www.bea.com/wli/sb/stages/transform/config" xmlns:con1="http://www.bea.com/wli/sb/stages/routing/config" xmlns:con3="http://www.bea.com/wli/sb/stages/transform/config">
                                <con4:id xmlns:con4="http://www.bea.com/wli/sb/stages/config">_ActionId-N53e8e33c.N70f83696.0.18cc31239e0.N7ec1</con4:id>
                            </con3:delete>
                        </con1:requestTransform>
                        <con1:responseTransform/>
                    </con1:wsCallout>
                </con:actions>
            </con:stage>
        </con:pipeline>
        <con:pipeline type="response" name="response-N53e8e33c.N70f83696.0.18cc31239e0.N7f42">
            <con:stage id="_StageId-N53e8e33c.N70f83696.0.18cc31239e0.N7df6" name="Stage1">
                <con:context/>
                <con:actions>
                    <con1:replace varName="header" contents-only="true" xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N53e8e33c.N70f83696.0.18cc31239e0.N7df5</con2:id>
                        <con1:expr>
                            <con2:xqueryTransform xmlns:con2="http://www.bea.com/wli/sb/stages/config">
                                <con2:resource ref="SBRG_Pension_ReversalWithdrawalFPC/Transformations/ReversalWithdrawalFPCHeaderOut"/>
                                <con2:param name="ReversalWithdrawalFPCResponse">
                                    <con2:path>$RSP</con2:path>
                                </con2:param>
                            </con2:xqueryTransform>
                        </con1:expr>
                    </con1:replace>
                    <con1:replace varName="body" contents-only="true" xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N53e8e33c.N70f83696.0.18cc31239e0.N7df4</con2:id>
                        <con1:expr>
                            <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">$RSP</con2:xqueryText>
                        </con1:expr>
                    </con1:replace>
                </con:actions>
            </con:stage>
        </con:pipeline>
        <con:flow>
            <con:pipeline-node name="Pipeline Pair Node1">
                <con:request>request-N53e8e33c.N70f83696.0.18cc31239e0.N7f43</con:request>
