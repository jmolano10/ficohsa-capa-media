<?xml version="1.0" encoding="UTF-8"?>
<con:wadlEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:wadl><![CDATA[<?xml version = '1.0' encoding = 'UTF-8'?>
<application xmlns:soa="http://www.oracle.com/soa/rest" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:inp1="http://www.ficohsa.com.hn/middleware.services/messagingTypes" xmlns:ns0="http://www.ficohsa.com.hn/middleware.services/commonTypes" xmlns="http://wadl.dev.java.net/2009/02">
   <doc title="SendSmsRestPS">RestService</doc>
   <grammars>
      <xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <xsd:import namespace="http://www.ficohsa.com.hn/middleware.services/messagingTypes" schemaLocation="../../../../../MWBanking/Messaging/RequestorServices/XSD/messagingTypes.xsd"/>
        </xsd:schema>
   </grammars>
   <resources>
      <resource path="/">
         <method name="POST" soa:wsdlOperation="sendSMS">
            <request>
               <representation mediaType="application/xml" element="cns:sendSMSRequest" xmlns:cns="http://www.ficohsa.com.hn/middleware.services/messagingTypes"/>
               <representation mediaType="application/json" element="cns:sendSMSRequest" xmlns:cns="http://www.ficohsa.com.hn/middleware.services/messagingTypes"/>
            </request>
            <response status="200">
               <representation mediaType="application/xml" element="cns:sendSMSResponse" xmlns:cns="http://www.ficohsa.com.hn/middleware.services/messagingTypes"/>
               <representation mediaType="application/json" element="cns:sendSMSResponse" xmlns:cns="http://www.ficohsa.com.hn/middleware.services/messagingTypes"/>
            </response>
         </method>
      </resource>
   </resources>
</application>]]></con:wadl>
    <con:dependencies>
        <con:importSchema namespace="http://www.ficohsa.com.hn/middleware.services/messagingTypes" schemaLocation="../../../../../MWBanking/Messaging/RequestorServices/XSD/messagingTypes.xsd" ref="MWBanking/Messaging/RequestorServices/XSD/messagingTypes"/>
    </con:dependencies>
</con:wadlEntry>