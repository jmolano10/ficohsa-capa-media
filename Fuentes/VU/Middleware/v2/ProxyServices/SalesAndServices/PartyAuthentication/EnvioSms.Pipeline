<?xml version="1.0" encoding="UTF-8"?>
<con:pipelineEntry xmlns:con="http://www.bea.com/wli/sb/pipeline/config" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <con:coreEntry>
        <con:binding type="Native REST" xsi:type="con:NativeRestBindingType">
            <con:wadl ref="Middleware/v2/Resources/envioMensajeSMS/wsdl/EnvioSms"/>
        </con:binding>
        <oper:operations xmlns:oper="http://xmlns.oracle.com/servicebus/pipeline/operations">
            <oper:monitoring enabled="true" level="service" aggregationInterval="360"/>
        </oper:operations>
        <con:xqConfiguration>
            <con:snippetVersion>1.0</con:snippetVersion>
        </con:xqConfiguration>
    </con:coreEntry>
    <con:router>
        <con:pipeline type="request" name="request-N3f5776ff.N24374cfa.0.17e928c8ac1.N8000">
            <con:stage id="_StageId-N3f5776ff.N24374cfa.0.17e928c8ac1.N7f5d" name="TXaEnvioSmsREQHeader">
                <con:context>
                    <con1:userNsDecl prefix="con" namespace="http://www.bea.com/wli/sb/services/security/config" xmlns:con1="http://www.bea.com/wli/sb/stages/config"/>
                </con:context>
                <con:actions>
                    <con1:assign varName="creationTimestamp" xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N3f5776ff.N24374cfa.0.17e928c8ac1.N7ca1</con2:id>
                        <con1:expr>
                            <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">(fn:current-dateTime() - xs:dateTime("1970-01-01T00:00:00-00:00")) div xs:dayTimeDuration('PT0.001S')</con2:xqueryText>
                        </con1:expr>
                    </con1:assign>
                    <con1:assign varName="varSA" xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N3f5776ff.N24374cfa.0.17e928c8ac1.N7f5c</con2:id>
                        <con1:expr>
                            <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">fn-bea:lookupBasicCredentials('Middleware/Security/HNBNPRDVUSECURIT')</con2:xqueryText>
                        </con1:expr>
                    </con1:assign>
                    <con1:assign varName="userName" xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N3f5776ff.N24374cfa.0.17e928c8ac1.N7f5b</con2:id>
                        <con1:expr>
                            <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">fn:data($varSA/con:username)</con:xqueryText>
                        </con1:expr>
                    </con1:assign>
                    <con1:assign varName="password" xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N3f5776ff.N24374cfa.0.17e928c8ac1.N7f5a</con2:id>
                        <con1:expr>
                            <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">fn:data($varSA/con:password)</con:xqueryText>
                        </con1:expr>
                    </con1:assign>
                    <con1:assign varName="receiverNumber" xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N3f5776ff.N24374cfa.0.17e928c8ac1.N7f22</con2:id>
                        <con1:expr>
                            <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">$inbound/ctx:transport/ctx:request/http:query-parameters/http:parameter[@name='receiverNumber']/@value</con2:xqueryText>
                        </con1:expr>
                    </con1:assign>
                    <con1:assign varName="bank" xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N3f5776ff.N24374cfa.0.17e928c8ac1.N7f25</con2:id>
                        <con1:expr>
                            <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">if (fn:starts-with($receiverNumber, '502'))
then
'GT01'
else if (fn:starts-with($receiverNumber, '504'))
then
'HN01'
else if (fn:starts-with($receiverNumber, '505'))
then
'NI01'
else if (fn:starts-with($receiverNumber, '507'))
then
'PA01'
else
'NA'</con2:xqueryText>
                        </con1:expr>
                    </con1:assign>
                    <con1:assign varName="headerREQ" xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N3f5776ff.N24374cfa.0.17e928c8ac1.N7f59</con2:id>
                        <con1:expr>
                            <con2:xqueryTransform xmlns:con2="http://www.bea.com/wli/sb/stages/config">
                                <con2:resource ref="Middleware/v2/Resources/envioMensajeSMS/xq/envioSMSHeaderIn"/>
                                <con2:param name="bank">
                                    <con2:path>$bank</con2:path>
                                </con2:param>
                                <con2:param name="password">
                                    <con2:path>$password</con2:path>
                                </con2:param>
                                <con2:param name="username">
                                    <con2:path>$userName</con2:path>
                                </con2:param>
                            </con2:xqueryTransform>
                        </con1:expr>
                    </con1:assign>
                </con:actions>
            </con:stage>
            <con:stage id="_StageId-N3f5776ff.N24374cfa.0.17e928c8ac1.N7ef0" name="TxaEnvioSMS">
                <con:context/>
                <con:actions>
                    <con1:assign varName="message" xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N3f5776ff.N24374cfa.0.17e928c8ac1.N7ebc</con2:id>
                        <con1:expr>
                            <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">$inbound/ctx:transport/ctx:request/http:query-parameters/http:parameter[@name='message']/@value</con2:xqueryText>
                        </con1:expr>
                    </con1:assign>
                    <con1:assign varName="envioSmsREQ" xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N3f5776ff.N24374cfa.0.17e928c8ac1.N7eb9</con2:id>
                        <con1:expr>
                            <con2:xqueryTransform xmlns:con2="http://www.bea.com/wli/sb/stages/config">
                                <con2:resource ref="Middleware/v2/Resources/envioMensajeSMS/xq/envioSmsIn"/>
                                <con2:param name="mobileNumber">
                                    <con2:path>$receiverNumber</con2:path>
                                </con2:param>
                                <con2:param name="message">
                                    <con2:path>$message</con2:path>
                                </con2:param>
                            </con2:xqueryTransform>
                        </con1:expr>
                    </con1:assign>
                </con:actions>
            </con:stage>
        </con:pipeline>
        <con:pipeline type="response" name="response-N3f5776ff.N24374cfa.0.17e928c8ac1.N7fff">
            <con:stage id="_StageId-N3f5776ff.N24374cfa.0.17e928c8ac1.N7ffd" name="TxResponse">
                <con:context/>
                <con:actions>
                    <con1:assign varName="FinalResponse" xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N3f5776ff.N24374cfa.0.17e928c8ac1.N7ce4</con2:id>
                        <con1:expr>
                            <con2:xqueryTransform xmlns:con2="http://www.bea.com/wli/sb/stages/config">
                                <con2:resource ref="Middleware/v2/Resources/envioMensajeSMS/xq/envioSmsDynamoOut"/>
                                <con2:param name="receiverNumber">
                                    <con2:path>$receiverNumber</con2:path>
                                </con2:param>
                                <con2:param name="OutputResponse">
                                    <con2:path>$RSPBissness</con2:path>
                                </con2:param>
                                <con2:param name="creationTimestamp">
                                    <con2:path>$creationTimestamp</con2:path>
                                </con2:param>
                                <con2:param name="message">
                                    <con2:path>$message</con2:path>
                                </con2:param>
                            </con2:xqueryTransform>
                        </con1:expr>
                    </con1:assign>
                    <con1:nxsdTranslation xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N3f5776ff.N24374cfa.0.17e928c8ac1.N7ce1</con2:id>
                        <con1:type>XML-To-Native</con1:type>
                        <con1:sourceExpr>
                            <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">$FinalResponse</con2:xqueryText>
                        </con1:sourceExpr>
                        <con1:nxsd ref="Middleware/v2/Resources/envioMensajeSMS/xsd/envioSMSResponse"/>
                        <con1:schemaElement xmlns:env="http://ficohsa.com/EnvioSMS">env:EnvioSMSResponse</con1:schemaElement>
                        <con1:assign-variable>FinalResponseJson</con1:assign-variable>
                    </con1:nxsdTranslation>
                    <con1:replace varName="body" contents-only="true" xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N3f5776ff.N24374cfa.0.17e928c8ac1.N7cad</con2:id>
                        <con1:expr>
                            <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">$FinalResponseJson</con2:xqueryText>
                        </con1:expr>
                    </con1:replace>
                    <con1:transport-headers xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N3f5776ff.N24374cfa.0.17e928c8ac1.N7ca7</con2:id>
                        <con1:header-set>inbound-response</con1:header-set>
                        <con1:header value="expression" name="Content-Type">
                            <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">'application/json'</con2:xqueryText>
                        </con1:header>
                    </con1:transport-headers>
                </con:actions>
            </con:stage>
        </con:pipeline>
        <con:pipeline type="request" name="request-N53e8b9d0.N28b97bf9.0.18a6c621173.N7fc9">
            <con:stage id="_StageId-N53e8b9d0.N28b97bf9.0.18a6c621173.N7fc7" name="LlamadoServiceDynamo">
                <con:context>
                    <con1:userNsDecl prefix="ns1" namespace="http://www.ficohsa.com.hn/middleware.services/messagingTypes" xmlns:con1="http://www.bea.com/wli/sb/stages/config"/>
                    <con1:userNsDecl prefix="ns3" namespace="http://www.ficohsa.com.hn/middleware.services/commonTypes" xmlns:con1="http://www.bea.com/wli/sb/stages/config"/>
                </con:context>
                <con:actions>
                    <con1:wsCallout xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N53e8b9d0.N28b97bf9.0.18a6c621173.N7fc3</con2:id>
                        <con1:service ref="ThirdParty/RequestorServices/v1.0/SendSMS/ProxyServices/SendSMSHN_PS" xsi:type="ref:ProxyRef" xmlns:ref="http://www.bea.com/wli/sb/reference"/>
                        <con1:operation>sendSMS</con1:operation>
                        <con1:request>
                            <con1:body wrapped="false">REQBissness</con1:body>
                            <con1:header/>
                        </con1:request>
                        <con1:response>
                            <con1:body wrapped="false">RSPBissness</con1:body>
                            <con1:header/>
                        </con1:response>
                        <con1:requestTransform>
                            <con1:assign varName="REQBissness">
                                <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N53e8b9d0.N28b97bf9.0.18a6c621173.N7fc0</con2:id>
                                <con1:expr>
                                    <con2:xqueryTransform xmlns:con2="http://www.bea.com/wli/sb/stages/config">
                                        <con2:resource ref="Middleware/v2/Resources/envioMensajeSMS/xq/envioSmsDynamoIn"/>
                                        <con2:param name="ResourceInput">
                                            <con2:path>$envioSmsREQ</con2:path>
                                        </con2:param>
                                        <con2:param name="ResourceInputElement">
                                            <con2:path>$headerREQ</con2:path>
                                        </con2:param>
                                    </con2:xqueryTransform>
                                </con1:expr>
                            </con1:assign>
                        </con1:requestTransform>
                        <con1:responseTransform>
                            <con1:assign varName="SmsError">
                                <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N53e8b9d0.N1cd78806.0.18a77061814.N7ffe</con2:id>
                                <con1:expr>
                                    <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">$RSPBissness/ns1:StatusInfo/ns3:Status/text()</con2:xqueryText>
                                </con1:expr>
                            </con1:assign>
                        </con1:responseTransform>
                    </con1:wsCallout>
                </con:actions>
            </con:stage>
        </con:pipeline>
        <con:pipeline type="response" name="response-N53e8b9d0.N28b97bf9.0.18a6c621173.N7fc8">
            <con:stage id="_StageId-N53e8b9d0.N28b97bf9.0.18a6c621173.N7fc6" name="FlujoSalida">
                <con:context/>
                <con:actions>
                    <con1:ifThenElse xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N53e8b9d0.N1cd78806.0.18a77061814.N7fa6</con2:id>
                        <con1:case id="_BranchId-N53e8b9d0.N1cd78806.0.18a77061814.N7fa5">
                            <con1:condition>
                                <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">fn:upper-case($SmsError) ='SUCCESS'</con2:xqueryText>
                            </con1:condition>
                            <con1:actions>
                                <con1:replace varName="body" contents-only="true">
                                    <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N53e8b9d0.N28b97bf9.0.18a6c621173.N7fba</con2:id>
                                    <con1:expr>
                                        <con2:xqueryTransform xmlns:con2="http://www.bea.com/wli/sb/stages/config">
                                            <con2:resource ref="Middleware/v2/Resources/envioMensajeSMS/xq/envioSmsDynamoOut"/>
                                            <con2:param name="receiverNumber">
                                                <con2:path>$receiverNumber</con2:path>
                                            </con2:param>
                                            <con2:param name="OutputResponse">
                                                <con2:path>$RSPBissness</con2:path>
                                            </con2:param>
                                            <con2:param name="creationTimestamp">
                                                <con2:path>$creationTimestamp</con2:path>
                                            </con2:param>
                                            <con2:param name="message">
                                                <con2:path>$message</con2:path>
                                            </con2:param>
                                        </con2:xqueryTransform>
                                    </con1:expr>
                                </con1:replace>
                            </con1:actions>
                        </con1:case>
                        <con1:default/>
                    </con1:ifThenElse>
                </con:actions>
            </con:stage>
        </con:pipeline>
        <con:flow>
            <con:pipeline-node name="EnvioSMSPipeline">
                <con:request>request-N3f5776ff.N24374cfa.0.17e928c8ac1.N8000</con:request>
                <con:response>response-N3f5776ff.N24374cfa.0.17e928c8ac1.N7fff</con:response>
            </con:pipeline-node>
            <con:pipeline-node name="Llamado al biz">
                <con:request>request-N53e8b9d0.N28b97bf9.0.18a6c621173.N7fc9</con:request>
                <con:response>response-N53e8b9d0.N28b97bf9.0.18a6c621173.N7fc8</con:response>
            </con:pipeline-node>
        </con:flow>
    </con:router>
</con:pipelineEntry>