                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N3f5776ff.N24374cfa.0.17e928c8ac1.N7ca4</con2:id>
                        <con1:expr>
                            <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">(fn:current-dateTime() - xs:dateTime("1970-01-01T00:00:00-00:00")) div xs:dayTimeDuration('PT0.001S')</con2:xqueryText>
                        </con1:expr>
                    </con1:assign>
                    <con1:assign varName="varSA" xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N53e80454.Nae2ef9d.0.17e8d7d32e7.N7ebe</con2:id>
                        <con1:expr>
                            <con:xqueryText xmlns:con="http://www.bea.com/wli/sb/stages/config">fn-bea:lookupBasicCredentials('Middleware/Security/HNBNPRDVUSECURIT')</con:xqueryText>
                        </con1:expr>
                    </con1:assign>
                    <con1:assign varName="userName" xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
