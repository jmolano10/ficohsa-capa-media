                        <con1:expr>
                            <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">$inbound/ctx:transport/ctx:request/http:query-parameters/http:parameter[@name='ccEmailAccounts']/@value</con2:xqueryText>
