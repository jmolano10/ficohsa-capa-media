                        <con1:expr>
                            <con2:xqueryTransform xmlns:con2="http://www.bea.com/wli/sb/stages/config">
                                <con2:resource ref="Middleware/v2/Resources/EnvioCorreoElectronico/xq/envioEmailHeaderIn"/>
                                <con2:param name="password">
                                    <con2:path>$password</con2:path>
                                </con2:param>
                                <con2:param name="username">
                                    <con2:path>$userName</con2:path>
                                </con2:param>
                            </con2:xqueryTransform>
                        </con1:expr>
                    </con1:assign>
                </con:actions>
            </con:stage>
            <con:stage id="_StageId-N53e80454.Nae2ef9d.0.17e8d7d32e7.N7e43" name="TXaEnvioMail">
                <con:context/>
                <con:actions>
                    <con1:assign varName="toEmailAccounts" xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N53e80454.Nae2ef9d.0.17e8d7d32e7.N7e42</con2:id>
                        <con1:expr>
                            <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">$inbound/ctx:transport/ctx:request/http:query-parameters/http:parameter[@name='toEmailAccounts']/@value</con2:xqueryText>
