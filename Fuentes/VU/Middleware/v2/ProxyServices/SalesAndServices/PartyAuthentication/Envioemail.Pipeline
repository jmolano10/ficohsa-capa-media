        <con:pipeline type="response" name="response-N53e80454.Nae2ef9d.0.17e8d7d32e7.N7f61">
            <con:stage id="_StageId-N53e80454.Nae2ef9d.0.17e8d7d32e7.N7f5f" name="TXResponse">
                <con:context/>
                <con:actions>
                    <con1:assign varName="messageId" xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N53e80454.N6a33f0ae.0.17e8dbaf143.N7fb7</con2:id>
                        <con1:expr>
                            <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">fn:data($headerRSP/*:ResponseHeader/*:messageId)</con2:xqueryText>
