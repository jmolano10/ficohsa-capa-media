    </con:coreEntry>
    <con:router>
        <con:pipeline type="request" name="request-N53e80454.Nae2ef9d.0.17e8d7d32e7.N7f62">
            <con:stage id="_StageId-N53e80454.Nae2ef9d.0.17e8d7d32e7.N7ebf" name="TXaEnvioEmailREQHeader">
                <con:context>
                    <con1:userNsDecl prefix="con" namespace="http://www.bea.com/wli/sb/services/security/config" xmlns:con1="http://www.bea.com/wli/sb/stages/config"/>
                </con:context>
                <con:actions>
