                        <con1:expr>
                            <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">fn:data($varSA/con:username)</con2:xqueryText>
                        </con1:expr>
                    </con1:assign>
                    <con1:assign varName="password" xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
                        <con2:id xmlns:con2="http://www.bea.com/wli/sb/stages/config">_ActionId-N53e80454.Nae2ef9d.0.17e8d7d32e7.N7ebc</con2:id>
                        <con1:expr>
                            <con2:xqueryText xmlns:con2="http://www.bea.com/wli/sb/stages/config">fn:data($varSA/con:password)</con2:xqueryText>
                        </con1:expr>
                    </con1:assign>
                    <con1:assign varName="headerREQ" xmlns:con1="http://www.bea.com/wli/sb/stages/transform/config">
