                                <con3:id xmlns:con3="http://www.bea.com/wli/sb/stages/config">_ActionId-N53e80454.N6a33f0ae.0.17e8dbaf143.N7fc3</con3:id>
                                <con2:expr>
                                    <con3:xqueryText xmlns:con3="http://www.bea.com/wli/sb/stages/config">$body</con3:xqueryText>
