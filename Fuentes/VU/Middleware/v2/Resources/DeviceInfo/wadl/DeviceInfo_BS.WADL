<?xml version="1.0" encoding="UTF-8"?>
<con:wadlEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:wadl><![CDATA[<application xmlns:soa="http://www.oracle.com/soa/rest" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ns0="http://www.ficohsa.com.hn/middleware.services/DeviceInfoTypes" xmlns="http://wadl.dev.java.net/2009/02">
   <doc title="DeviceInfo_BS">RestReference</doc>
   <grammars>
      <xsd:schema>
            <xsd:import namespace="http://www.ficohsa.com.hn/middleware.services/DeviceInfoTypes" schemaLocation="../xsd/DeviceInfoTypes.xsd"/>
        </xsd:schema>
   </grammars>
   <resources>
      <resource path="/getFingerprintListByUserId">
         <method name="POST" soa:wsdlOperation="getDevices">
            <request>
               <representation mediaType="application/json" element="cns:DeviceInfoRequestVU" xmlns:cns="http://www.ficohsa.com.hn/middleware.services/DeviceInfoTypes"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:DeviceInfoResponseVU" xmlns:cns="http://www.ficohsa.com.hn/middleware.services/DeviceInfoTypes"/>
            </response>
         </method>
      </resource>
   </resources>
</application>]]></con:wadl>
    <con:dependencies>
        <con:importSchema namespace="http://www.ficohsa.com.hn/middleware.services/DeviceInfoTypes" schemaLocation="../xsd/DeviceInfoTypes.xsd" ref="Middleware/v2/Resources/DeviceInfo/xsd/DeviceInfoTypes"/>
    </con:dependencies>
</con:wadlEntry>