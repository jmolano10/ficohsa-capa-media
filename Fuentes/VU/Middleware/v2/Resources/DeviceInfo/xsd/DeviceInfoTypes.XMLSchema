<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<?xml version="1.0" encoding="windows-1252" ?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns="http://www.ficohsa.com.hn/middleware.services/DeviceInfoTypes"
            targetNamespace="http://www.ficohsa.com.hn/middleware.services/DeviceInfoTypes"
            elementFormDefault="qualified">
  <xsd:element name="DeviceInfoRequest">
    <xsd:annotation>
      <xsd:documentation>A sample element</xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="user" type="xsd:string"/>
        <xsd:element name="device_type" type="deviceType"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="DeviceInfoRequestVU">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="apikey" type="xsd:string"/>
        <xsd:element name="userId" type="xsd:string"/>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="DeviceInfoResponseVU">
      <xsd:complexType>
         <xsd:sequence>
            <xsd:element name="code" type="xsd:integer" minOccurs="0"/>
            <xsd:element name="description" type="xsd:string" minOccurs="0"/>
            <xsd:element name="browserInfo" maxOccurs="unbounded" minOccurs="0">
               <xsd:complexType>
                  <xsd:sequence>
                     <xsd:element name="id" type="xsd:integer" minOccurs="0"/>
                     <xsd:element name="userId" type="xsd:integer" minOccurs="0"/>
                     <xsd:element name="eventDate" type="xsd:string" minOccurs="0"/>
                     <xsd:element name="geoData" type="xsd:string" minOccurs="0"/>
                     <xsd:element name="aditionalParameters" type="xsd:string" minOccurs="0"/>
                     <xsd:element name="hash" type="xsd:string" minOccurs="0"/>
                     <xsd:element name="creationDate" type="xsd:string" minOccurs="0"/>
                     <xsd:element name="lastCheckDate" type="xsd:string" minOccurs="0"/>
                     <xsd:element name="status" type="xsd:string" minOccurs="0"/>
                     <xsd:element name="userHashId" type="xsd:integer" minOccurs="0"/>
                     <xsd:element name="accuracy" type="xsd:double" minOccurs="0"/>
                     <xsd:element name="agentInfo" minOccurs="0">
                        <xsd:complexType>
                           <xsd:sequence>
                              <xsd:element name="ua" type="xsd:string" minOccurs="0"/>
                              <xsd:element name="browser" minOccurs="0">
                                 <xsd:complexType>
                                    <xsd:sequence>
                                       <xsd:element name="name" type="xsd:string" minOccurs="0"/>
                                       <xsd:element name="major" type="xsd:integer" minOccurs="0"/>
                                       <xsd:element name="version" type="xsd:double" minOccurs="0"/>
                                    </xsd:sequence>
                                 </xsd:complexType>
                              </xsd:element>
                              <xsd:element name="cpu" minOccurs="0">
                                 <xsd:complexType>
                                    <xsd:sequence>
                                       <xsd:element name="architecture" type="xsd:string" minOccurs="0"/>
                                    </xsd:sequence>
                                 </xsd:complexType>
                              </xsd:element>
                              <xsd:element name="device" minOccurs="0">
                                 <xsd:complexType>
                                    <xsd:sequence>
                                       <xsd:element name="type" type="xsd:string" minOccurs="0"/>
                                       <xsd:element name="model" type="xsd:string" minOccurs="0"/>
                                       <xsd:element name="vendor" type="xsd:string" minOccurs="0"/>
                                    </xsd:sequence>
                                 </xsd:complexType>
                              </xsd:element>
                              <xsd:element name="engine" minOccurs="0">
                                 <xsd:complexType>
                                    <xsd:sequence>
                                       <xsd:element name="name" type="xsd:string" minOccurs="0"/>
                                       <xsd:element name="version" type="xsd:double" minOccurs="0"/>
                                    </xsd:sequence>
                                 </xsd:complexType>
                              </xsd:element>
                              <xsd:element name="os" minOccurs="0">
                                 <xsd:complexType>
                                    <xsd:sequence>
                                       <xsd:element name="name" type="xsd:string" minOccurs="0"/>
                                       <xsd:element name="version" type="xsd:integer" minOccurs="0"/>
                                    </xsd:sequence>
                                 </xsd:complexType>
                              </xsd:element>
                           </xsd:sequence>
                        </xsd:complexType>
                     </xsd:element>
                  </xsd:sequence>
               </xsd:complexType>
            </xsd:element>
            <xsd:element name="deviceInfo" maxOccurs="unbounded" minOccurs="0">
               <xsd:complexType>
                  <xsd:sequence>
                     <xsd:element name="id" type="xsd:integer" minOccurs="0"/>
                     <xsd:element name="userId" type="xsd:integer" minOccurs="0"/>
                     <xsd:element name="eventDate" type="xsd:string" minOccurs="0"/>
                     <xsd:element name="geoData" type="xsd:string" minOccurs="0"/>
                     <xsd:element name="aditionalParameters" minOccurs="0"/>
                     <xsd:element name="hash" type="xsd:string" minOccurs="0"/>
                     <xsd:element name="creationDate" type="xsd:string" minOccurs="0"/>
                     <xsd:element name="lastCheckDate" type="xsd:string" minOccurs="0"/>
                     <xsd:element name="status" type="xsd:string" minOccurs="0"/>
                     <xsd:element name="userHashId" type="xsd:integer" minOccurs="0"/>
                     <xsd:element name="accuracy" type="xsd:double" minOccurs="0"/>
                     <xsd:element name="agentInfo" type="xsd:string" minOccurs="0"/>
                     <xsd:element name="deviceValueId" type="xsd:integer" minOccurs="0"/>
                     <xsd:element name="randomSeed" type="xsd:string" minOccurs="0"/>
                     <xsd:element name="deviceId" type="xsd:integer" minOccurs="0"/>
                     <xsd:element name="deviceName" type="xsd:string" minOccurs="0"/>
                     <xsd:element name="deviceManufacturer" type="xsd:string" minOccurs="0"/>
                     <xsd:element name="deviceResolution" type="xsd:string" minOccurs="0"/>
                     <xsd:element name="osName" type="xsd:string" minOccurs="0"/>
                     <xsd:element name="osVersion" type="xsd:integer" minOccurs="0"/>
                     <xsd:element name="apiLevel" type="xsd:integer" minOccurs="0"/>
                     <xsd:element name="deviceLocation" type="xsd:string" minOccurs="0"/>
                     <xsd:element name="rooted" type="xsd:string" minOccurs="0"/>
                     <xsd:element name="gpscompatible" type="xsd:string" minOccurs="0"/>
                     <xsd:element name="fingerprintCompatible" type="xsd:string" minOccurs="0"/>
                  </xsd:sequence>
               </xsd:complexType>
            </xsd:element>
         </xsd:sequence>
      </xsd:complexType>
  </xsd:element>
  <xsd:element name="DeviceInfoResponse">
      <xsd:complexType>
         <xsd:sequence>
            <xsd:element name="DeviceInfoRecordType" minOccurs="0">
               <xsd:complexType>
                  <xsd:sequence>
                     <xsd:element name="Devices" minOccurs="0">
                        <xsd:complexType>
                           <xsd:sequence>
                              <xsd:element name="Browsers" minOccurs="0">
                                 <xsd:complexType>
                                    <xsd:sequence>
                                       <xsd:element name="BrowserInfo" maxOccurs="unbounded" minOccurs="0">
                                          <xsd:complexType>
                                             <xsd:sequence>
                                                <xsd:element name="Id" type="xsd:string" minOccurs="0"/>
                                                <xsd:element name="hashdevice" type="xsd:string" minOccurs="0"/>
                                                <xsd:element name="creationDate" type="xsd:string" minOccurs="0"/>
                                                <xsd:element name="DeviceId" type="xsd:string" minOccurs="0"/>
                                                <xsd:element name="DeviceName" type="xsd:string" minOccurs="0"/>
                                                <xsd:element name="Deviceversion" type="xsd:string" minOccurs="0"/>
                                                <xsd:element name="lastCheckDate" type="xsd:string" minOccurs="0"/>
                                                <xsd:element name="status" type="xsd:string" minOccurs="0"/>
                                             </xsd:sequence>
                                          </xsd:complexType>
                                       </xsd:element>
                                    </xsd:sequence>
                                 </xsd:complexType>
                              </xsd:element>
                              <xsd:element name="Mobiles" minOccurs="0">
                                 <xsd:complexType>
                                    <xsd:sequence>
                                       <xsd:element name="DeviceInfo" maxOccurs="unbounded" minOccurs="0">
                                          <xsd:complexType>
                                             <xsd:sequence>
                                                <xsd:element name="Id" minOccurs="0" type="xsd:string"/>
                                                <xsd:element name="hashdevice" minOccurs="0" type="xsd:string"/>
                                                <xsd:element name="creationDate" minOccurs="0" type="xsd:string"/>
                                                <xsd:element name="DeviceId" minOccurs="0" type="xsd:string"/>
                                                <xsd:element name="DeviceName" minOccurs="0" type="xsd:string"/>
                                                <xsd:element name="Status" minOccurs="0" type="xsd:string"/>
                                                <xsd:element name="LastCheckDate" minOccurs="0" type="xsd:string"/>
                                                <xsd:element name="deviceLocation" minOccurs="0" type="xsd:string"/>
                                                <xsd:element name="deviceOSName" minOccurs="0" type="xsd:string"/>
                                                <xsd:element name="deviceOSVersion" minOccurs="0" type="xsd:string"/>
                                             </xsd:sequence>
                                          </xsd:complexType>
                                       </xsd:element>
                                    </xsd:sequence>
                                 </xsd:complexType>
                              </xsd:element>
                           </xsd:sequence>
                        </xsd:complexType>
                     </xsd:element>
                  </xsd:sequence>
               </xsd:complexType>
            </xsd:element>
         </xsd:sequence>
      </xsd:complexType>
   </xsd:element>
    <xsd:simpleType name="deviceType">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="DEVICE_WEB"/>
			<xsd:enumeration value="DEVICE_APP"/>
		</xsd:restriction>
	</xsd:simpleType>
</xsd:schema>]]></con:schema>
    <con:targetNamespace>http://www.ficohsa.com.hn/middleware.services/DeviceInfoTypes</con:targetNamespace>
</con:schemaEntry>