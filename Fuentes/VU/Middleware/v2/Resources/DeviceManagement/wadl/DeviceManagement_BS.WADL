<?xml version="1.0" encoding="UTF-8"?>
<con:wadlEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:wadl><![CDATA[<?xml version = '1.0' encoding = 'UTF-8'?>
<application xmlns:soa="http://www.oracle.com/soa/rest" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="http://www.ficohsa.com.hn/middleware.services/DeviceManagement" xmlns="http://wadl.dev.java.net/2009/02">
   <doc title="DeviceManagement_PS">RestReference</doc>
   <grammars>
      <xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <xsd:import namespace="http://www.ficohsa.com.hn/middleware.services/DeviceManagement" schemaLocation="../xsd/DevicesManagementTypes.xsd"/>
        </xsd:schema>
   </grammars>
   <resources>
      <resource path="/checkFingerprint">
         <method name="POST" soa:wsdlOperation="registerWeb">
            <request>
               <representation mediaType="application/json" element="cns:DeviceManagementRequestVU" xmlns:cns="http://www.ficohsa.com.hn/middleware.services/DeviceManagement"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:DeviceManagementResponseVU" xmlns:cns="http://www.ficohsa.com.hn/middleware.services/DeviceManagement"/>
            </response>
         </method>
      </resource>
      <resource path="/checkMobileFingerprint">
         <method name="POST" soa:wsdlOperation="registerMobile">
            <request>
               <representation mediaType="application/json" element="cns:DeviceManagementRequestVU" xmlns:cns="http://www.ficohsa.com.hn/middleware.services/DeviceManagement"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:DeviceManagementResponseVU" xmlns:cns="http://www.ficohsa.com.hn/middleware.services/DeviceManagement"/>
            </response>
         </method>
      </resource>
      <resource path="/DeleteFingerprintByHash">
         <method name="POST" soa:wsdlOperation="deleteDevice">
            <request>
               <representation mediaType="application/json" element="cns:DeviceManagementRequestVU" xmlns:cns="http://www.ficohsa.com.hn/middleware.services/DeviceManagement"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:DeviceManagementResponseVU" xmlns:cns="http://www.ficohsa.com.hn/middleware.services/DeviceManagement"/>
            </response>
         </method>
      </resource>
      <resource path="/FingerprintValidByHash">
         <method name="POST" soa:wsdlOperation="validateDeviceByHash">
            <request>
               <representation mediaType="application/json" element="cns:DeviceManagementRequestVU" xmlns:cns="http://www.ficohsa.com.hn/middleware.services/DeviceManagement"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:DeviceManagementResponseVU" xmlns:cns="http://www.ficohsa.com.hn/middleware.services/DeviceManagement"/>
            </response>
         </method>
      </resource>
      <resource path="/Fingerprint">
         <method name="POST" soa:wsdlOperation="validateDevice">
            <request>
               <representation mediaType="application/json" element="cns:DeviceManagementRequestVU" xmlns:cns="http://www.ficohsa.com.hn/middleware.services/DeviceManagement"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:DeviceManagementResponseVU" xmlns:cns="http://www.ficohsa.com.hn/middleware.services/DeviceManagement"/>
            </response>
         </method>
      </resource>
   </resources>
</application>]]></con:wadl>
    <con:dependencies>
        <con:importSchema namespace="http://www.ficohsa.com.hn/middleware.services/DeviceManagement" schemaLocation="../xsd/DevicesManagementTypes.xsd" ref="Middleware/v2/Resources/DeviceManagement/xsd/DevicesManagementTypes"/>
    </con:dependencies>
</con:wadlEntry>