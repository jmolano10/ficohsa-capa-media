<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<?xml version="1.0" encoding="windows-1252"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tns="http://www.ficohsa.com.hn/middleware.services/DeviceManagement" targetNamespace="http://www.ficohsa.com.hn/middleware.services/DeviceManagement" elementFormDefault="qualified">
	<xsd:element name="DeviceManagementRequest">
		<xsd:annotation>
			<xsd:documentation>A sample element</xsd:documentation>
		</xsd:annotation>
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="user" type="xsd:string"/>
				<xsd:element name="operation" type="tns:operation" minOccurs="0"/>
				<xsd:element name="hash64" type="xsd:string" minOccurs="0"/>
				<xsd:element name="hashApp" type="xsd:string" minOccurs="0"/>
				<xsd:element name="token" type="xsd:string" minOccurs="0"/>
				<xsd:element name="description" type="xsd:string" minOccurs="0"/>
				<xsd:element name="randomSeed" type="xsd:string" minOccurs="0"/>
				<xsd:element name="deviceLocation" minOccurs="0">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="Location" minOccurs="0" maxOccurs="unbounded">
								<xsd:complexType>
									<xsd:sequence>
          <xsd:element name="KEY" type="xsd:string" minOccurs="0"/>
          <xsd:element name="VALUE" type="xsd:string" minOccurs="0"/>
									</xsd:sequence>
								</xsd:complexType>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="DeviceInfo" minOccurs="0">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="Info" minOccurs="0" maxOccurs="unbounded">
								<xsd:complexType>
									<xsd:sequence>
          <xsd:element name="KEY" type="xsd:string" minOccurs="0"/>
          <xsd:element name="VALUE" type="xsd:string" minOccurs="0"/>
									</xsd:sequence>
								</xsd:complexType>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="DeviceManagementRequestVU">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="apikey" type="xsd:string" minOccurs="0"/>
				<xsd:element name="bfp" type="xsd:string" minOccurs="0"/>
				<xsd:element name="fingerprint" type="xsd:string" minOccurs="0"/>
				<xsd:element name="userid" type="xsd:string" minOccurs="0"/>
				<xsd:element name="randomSeed" type="xsd:string" minOccurs="0"/>
                                <xsd:element name="minThresholdToValidate" type="xsd:integer" minOccurs="0"/>
				<xsd:element name="deviceFingerprintData" minOccurs="0">                   
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="deviceId" type="xsd:string" minOccurs="0"/>
							<xsd:element name="deviceName" type="xsd:string" minOccurs="0"/>
							<xsd:element name="deviceManufacturer" type="xsd:string" minOccurs="0"/>
							<xsd:element name="deviceResolution" type="xsd:string" minOccurs="0"/>
							<xsd:element name="isRooted" type="xsd:string" minOccurs="0"/>
							<xsd:element name="isJailbroken" type="xsd:string" minOccurs="0"/>
							<xsd:element name="isFingerprCompatible" type="xsd:string" minOccurs="0"/>
							<xsd:element name="isGPSCompatible" type="xsd:string" minOccurs="0"/>
							<xsd:element name="osName" type="xsd:string" minOccurs="0"/>
							<xsd:element name="osVersion" type="xsd:string" minOccurs="0"/>
							<xsd:element name="apiLevel" type="xsd:string" minOccurs="0"/>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="deviceLocation" minOccurs="0">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="latitude" type="xsd:double" minOccurs="0"/>
							<xsd:element name="longitude" type="xsd:double" minOccurs="0"/>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="fingerprintHash" type="xsd:string" minOccurs="0"/>
				<xsd:element name="token" type="xsd:string" nillable="true" minOccurs="0"/>
				<xsd:element name="description" type="xsd:string" minOccurs="0"/>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="DeviceManagementResponseVU">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="result" type="xsd:string" minOccurs="0"/>
				<xsd:element name="score" type="xsd:string" minOccurs="0"/>
				<xsd:element name="triggeredRules" type="xsd:string" minOccurs="0"/>
				<xsd:element name="error" type="xsd:string" minOccurs="0"/>
				<xsd:element name="status" type="xsd:string" minOccurs="0"/>
				<xsd:element name="eventId" type="xsd:string" minOccurs="0"/>
				<xsd:element name="ofacCoincidence" type="xsd:string" minOccurs="0"/>
				<xsd:element name="code" type="xsd:integer" minOccurs="0"/>
				<xsd:element name="existsHash" type="xsd:string" minOccurs="0"/>
				<xsd:element name="analyzeResult" type="xsd:integer" minOccurs="0"/>
				<xsd:element name="triggeredRule" type="xsd:integer" minOccurs="0" nillable="true"/>
				<xsd:element name="description" type="xsd:string" minOccurs="0"/>
				<xsd:element name="accuracyPercent" type="xsd:double" minOccurs="0"/>
				<xsd:element name="token" type="xsd:string" nillable="true" minOccurs="0"/>
                                <xsd:element name="fingerprint" type="xsd:string" nillable="true" minOccurs="0"/>
				<xsd:element name="browserInfo" minOccurs="0" maxOccurs="unbounded">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="id" type="xsd:integer" minOccurs="0"/>
							<xsd:element name="userId" type="xsd:integer" minOccurs="0"/>
							<xsd:element name="eventDate" type="xsd:integer" minOccurs="0"/>
							<xsd:element name="geoData" type="xsd:integer" minOccurs="0"/>
							<xsd:element name="aditionalParameters" type="xsd:integer" minOccurs="0"/>
							<xsd:element name="hash" type="xsd:string" minOccurs="0"/>
							<xsd:element name="creationDate" type="xsd:string" minOccurs="0"/>
							<xsd:element name="lastCheckDate" type="xsd:string" minOccurs="0"/>
							<xsd:element name="status" type="xsd:string" minOccurs="0"/>
							<xsd:element name="userHashId" type="xsd:integer" minOccurs="0"/>
							<xsd:element name="accuracy" type="xsd:double" minOccurs="0"/>
							<xsd:element name="agentInfo" minOccurs="0">
								<xsd:complexType>
									<xsd:sequence>
										<xsd:element name="ua" type="xsd:string" minOccurs="0"/>
										<xsd:element name="browser" minOccurs="0">
											<xsd:complexType>
												<xsd:sequence>
													<xsd:element name="name" type="xsd:string" minOccurs="0"/>
													<xsd:element name="major" type="xsd:integer" minOccurs="0"/>
													<xsd:element name="version" type="xsd:double" minOccurs="0"/>
												</xsd:sequence>
											</xsd:complexType>
										</xsd:element>
										<xsd:element name="cpu" minOccurs="0">
											<xsd:complexType>
												<xsd:sequence>
													<xsd:element name="architecture" type="xsd:string" minOccurs="0"/>
												</xsd:sequence>
											</xsd:complexType>
										</xsd:element>
										<xsd:element name="device" minOccurs="0">
											<xsd:complexType>
												<xsd:sequence>
													<xsd:element name="type" type="xsd:integer" minOccurs="0"/>
													<xsd:element name="model" type="xsd:integer" minOccurs="0"/>
													<xsd:element name="vendor" type="xsd:integer" minOccurs="0"/>
												</xsd:sequence>
											</xsd:complexType>
										</xsd:element>
										<xsd:element name="engine">
											<xsd:complexType>
												<xsd:sequence>
													<xsd:element name="name" type="xsd:string" minOccurs="0"/>
													<xsd:element name="version" type="xsd:double" minOccurs="0"/>
												</xsd:sequence>
											</xsd:complexType>
										</xsd:element>
										<xsd:element name="os">
											<xsd:complexType>
												<xsd:sequence>
													<xsd:element name="name" type="xsd:string" minOccurs="0"/>
													<xsd:element name="version" type="xsd:integer" minOccurs="0"/>
												</xsd:sequence>
											</xsd:complexType>
										</xsd:element>
									</xsd:sequence>
								</xsd:complexType>
							</xsd:element>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
				<xsd:element name="deviceInfo" minOccurs="0">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="id" type="xsd:integer" minOccurs="0"/>
							<xsd:element name="userId" type="xsd:integer" minOccurs="0"/>
							<xsd:element name="eventDate" type="xsd:integer" minOccurs="0"/>
							<xsd:element name="geoData" type="xsd:integer" minOccurs="0"/>
							<xsd:element name="aditionalParameters" type="xsd:integer" minOccurs="0"/>
							<xsd:element name="hash" type="xsd:string" minOccurs="0"/>
							<xsd:element name="creationDate" type="xsd:string" minOccurs="0"/>
							<xsd:element name="lastCheckDate" type="xsd:string" minOccurs="0"/>
							<xsd:element name="status" type="xsd:string" minOccurs="0"/>
							<xsd:element name="userHashId" type="xsd:integer" minOccurs="0"/>
							<xsd:element name="accuracy" type="xsd:double" minOccurs="0"/>
							<xsd:element name="agentInfo" type="xsd:integer" minOccurs="0"/>
							<xsd:element name="deviceValueId" type="xsd:integer" minOccurs="0"/>
							<xsd:element name="randomSeed" type="xsd:string" minOccurs="0"/>
							<xsd:element name="deviceId" type="xsd:integer" minOccurs="0"/>
							<xsd:element name="deviceName" type="xsd:string" minOccurs="0"/>
							<xsd:element name="deviceManufacturer" type="xsd:string" minOccurs="0"/>
							<xsd:element name="deviceResolution" type="xsd:string" minOccurs="0"/>
							<xsd:element name="osName" type="xsd:string" minOccurs="0"/>
							<xsd:element name="osVersion" type="xsd:integer" minOccurs="0"/>
							<xsd:element name="apiLevel" type="xsd:integer" minOccurs="0"/>
							<xsd:element name="deviceLocation" type="xsd:integer" minOccurs="0"/>
							<xsd:element name="rooted" type="xsd:string" minOccurs="0"/>
							<xsd:element name="gpscompatible" type="xsd:string" minOccurs="0"/>
							<xsd:element name="fingerprintCompatible" type="xsd:string" minOccurs="0"/>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:element name="DeviceManagementResponse">
		<xsd:complexType>
			<xsd:sequence>
				<xsd:element name="DeviceManagementRecordType">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="RESULT" type="xsd:string" minOccurs="0"/>
							<xsd:element name="EXISTSDEVICE" type="tns:existsDevice" minOccurs="0"/>
							<xsd:element name="ACCURANCYPERCENT" type="xsd:decimal" minOccurs="0"/>
							<xsd:element name="TOKEN" type="xsd:string" minOccurs="0"/>
							<xsd:element name="TRIGGEREDRULE" type="xsd:string" minOccurs="0"/>
							<xsd:element name="ANALYZERESULT" type="xsd:string" minOccurs="0"/>
                                                        <xsd:element name="HASH" type="xsd:string" minOccurs="0"/>
						</xsd:sequence>
					</xsd:complexType>
				</xsd:element>
			</xsd:sequence>
		</xsd:complexType>
	</xsd:element>
	<xsd:simpleType name="operation">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="REGISTER_MOBILE"/>
			<xsd:enumeration value="REGISTER_WEB"/>
			<xsd:enumeration value="VALIDATE_DEVICE"/>
			<xsd:enumeration value="VALIDATE_DEVICEBYHASH"/>
			<xsd:enumeration value="DELETE_DEVICE"/>
                        <xsd:enumeration value="VALIDATE_WEB"/>
                        <xsd:enumeration value="VALIDATE_WEB_BYHASH"/>
                        <xsd:enumeration value="DELETE_WEB"/>
		</xsd:restriction>
	</xsd:simpleType>
	<xsd:simpleType name="existsDevice">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="YES"/>
			<xsd:enumeration value="NO"/>
		</xsd:restriction>
	</xsd:simpleType>
</xsd:schema>]]></con:schema>
    <con:targetNamespace>http://www.ficohsa.com.hn/middleware.services/DeviceManagement</con:targetNamespace>
</con:schemaEntry>