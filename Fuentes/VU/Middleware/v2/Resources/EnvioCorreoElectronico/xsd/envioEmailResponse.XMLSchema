<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<?xml version = '1.0' encoding = 'UTF-8'?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://TargetNamespace.com/ServiceName" targetNamespace="http://TargetNamespace.com/ServiceName" elementFormDefault="qualified" xmlns:nxsd="http://xmlns.oracle.com/pcbpel/nxsd" nxsd:version="JSON" nxsd:encoding="UTF-8">
   <xsd:element name="Root-Element">
      <xsd:complexType>
         <xsd:sequence>
            <xsd:element name="code" type="xsd:integer"/>
            <xsd:element name="message" type="xsd:string"/>
            <xsd:element name="emailOperation">
               <xsd:complexType>
                  <xsd:sequence>
                     <xsd:element name="id" type="xsd:integer"/>
                     <xsd:element name="subject" type="xsd:string"/>
                     <xsd:element name="message" type="xsd:string"/>
                     <xsd:element name="toEmailAccounts" type="xsd:string"/>
                     <xsd:element name="ccEmailAccounts" type="xsd:string"/>
                     <xsd:element name="ccoEmailAccounts" type="xsd:string"/>
                     <xsd:element name="attachments" type="xsd:integer"/>
                     <xsd:element name="status" type="xsd:integer"/>
                     <xsd:element name="creationTimestamp" type="xsd:integer"/>
                     <xsd:element name="updateTimestamp" type="xsd:integer"/>
                  </xsd:sequence>
               </xsd:complexType>
            </xsd:element>
         </xsd:sequence>
      </xsd:complexType>
   </xsd:element>
<xsd:annotation xmlns="">
      <xsd:appinfo>NXSDSAMPLE=</xsd:appinfo>
      <xsd:appinfo>USEHEADER=false</xsd:appinfo>
   </xsd:annotation>
</xsd:schema>]]></con:schema>
    <con:targetNamespace>http://TargetNamespace.com/ServiceName</con:targetNamespace>
    <con:nxsdVersion>JSON</con:nxsdVersion>
</con:schemaEntry>