<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:iden="http://www.ficohsa.com.hn/middleware.services/IdentityProtectionTypes"
            targetNamespace="http://www.ficohsa.com.hn/middleware.services/IdentityProtectionTypes"
            elementFormDefault="qualified">
  <xsd:element name="IdentityProtectionRequest">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="OPERATION_NAME">
             <xsd:simpleType>
              <xsd:restriction base="xsd:string">
               <xsd:enumeration value="TOTP"/>
               <xsd:enumeration value="SMS"/>
               <xsd:enumeration value="EMAIL"/>
              </xsd:restriction>
             </xsd:simpleType>
        </xsd:element>
        <xsd:element name="ACTION">
             <xsd:simpleType>
              <xsd:restriction base="xsd:string">
               <xsd:enumeration value="SEND"/>
               <xsd:enumeration value="LOGIN"/>
               <xsd:enumeration value="REGISTRATION"/>
               <xsd:enumeration value="STATUS"/>
               <xsd:enumeration value="DELETE"/>
               <xsd:enumeration value="LOCK"/>
               <xsd:enumeration value="UNLOCK"/>
              </xsd:restriction>
             </xsd:simpleType>
        </xsd:element>
        <xsd:element name="KVPAIRS" minOccurs="0">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="KV_PAIR" maxOccurs="unbounded">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="KEY" type="xsd:string"/>
                    <xsd:element name="VALUE" type="xsd:string"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
</xsd:schema>]]></con:schema>
    <con:targetNamespace>http://www.ficohsa.com.hn/middleware.services/IdentityProtectionTypes</con:targetNamespace>
</con:schemaEntry>