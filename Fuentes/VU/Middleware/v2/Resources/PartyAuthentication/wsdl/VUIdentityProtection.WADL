            </response>
            <response>
               <representation mediaType="text/plain"/>
               <representation mediaType="*/*"/>
            </response>
         </method>
      </resource>
      
      <!-- DELETE SMS -->
      <resource path="/sms/delete.php">
         <method name="POST" soa:name="SMSDelete">
            <request>
               <param name="username" style="query" type="xsd:string"/>
            </request>
