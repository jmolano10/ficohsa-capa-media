<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<?xml version = '1.0' encoding = 'UTF-8'?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://ficohsa.com/EnvioSMS" targetNamespace="http://ficohsa.com/EnvioSMS" elementFormDefault="qualified" xmlns:nxsd="http://xmlns.oracle.com/pcbpel/nxsd" nxsd:version="JSON" nxsd:encoding="UTF-8">
   <xsd:element name="EnvioSMSResponse">
      <xsd:complexType>
         <xsd:sequence>
            <xsd:element name="code" type="xsd:integer"/>
            <xsd:element name="message" type="xsd:string"/>
            <xsd:element name="smsOperation">
               <xsd:complexType>
                  <xsd:sequence>
                     <xsd:element name="id" type="xsd:integer"/>
                     <xsd:element name="senderNumber" type="xsd:integer"/>
                     <xsd:element name="receiverNumber" type="xsd:integer"/>
                     <xsd:element name="message" type="xsd:string"/>
                     <xsd:element name="resultCode" type="xsd:integer"/>
                     <xsd:element name="result" type="xsd:string"/>
                     <xsd:element name="fail" type="xsd:string"/>
                     <xsd:element name="attempts" type="xsd:integer"/>
                     <xsd:element name="externalId" type="xsd:string"/>
                     <xsd:element name="creationTimestamp" type="xsd:integer"/>
                     <xsd:element name="resultTimestamp" type="xsd:integer"/>
                  </xsd:sequence>
               </xsd:complexType>
            </xsd:element>
         </xsd:sequence>
      </xsd:complexType>
   </xsd:element>
<xsd:annotation xmlns="">
      <xsd:appinfo>NXSDSAMPLE=</xsd:appinfo>
      <xsd:appinfo>USEHEADER=false</xsd:appinfo>
   </xsd:annotation>
</xsd:schema>]]></con:schema>
    <con:targetNamespace>http://ficohsa.com/EnvioSMS</con:targetNamespace>
    <con:nxsdVersion>JSON</con:nxsdVersion>
</con:schemaEntry>