<?xml version="1.0" encoding="UTF-8"?>
<con:wadlEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:wadl><![CDATA[<application xmlns:soa="http://www.oracle.com/soa/rest" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:tns="http://www.ficohsa.com.hn/middleware.services/FraudAnalysisTypes" xmlns="http://wadl.dev.java.net/2009/02">
   <doc title="FraudAnalysis_BS">RestReference</doc>
   <grammars>
      <xsd:schema>
            <xsd:import namespace="http://www.ficohsa.com.hn/middleware.services/FraudAnalysisTypes" schemaLocation="../xsd/FraudAnalysisTypes.xsd"/>
        </xsd:schema>
   </grammars>
   <resources>
      <resource path="/analyze">
         <method name="POST" soa:wsdlOperation="analyze">
            <request>
               <representation mediaType="application/json" element="cns:FraudAnalysisRequestVU" xmlns:cns="http://www.ficohsa.com.hn/middleware.services/FraudAnalysisTypes"/>
            </request>
            <response status="200">
               <representation mediaType="application/json" element="cns:fraudAnalysisResponseVU" xmlns:cns="http://www.ficohsa.com.hn/middleware.services/FraudAnalysisTypes"/>
            </response>
         </method>
      </resource>
   </resources>
</application>]]></con:wadl>
    <con:dependencies>
        <con:importSchema namespace="http://www.ficohsa.com.hn/middleware.services/FraudAnalysisTypes" schemaLocation="../xsd/FraudAnalysisTypes.xsd" ref="Middleware/v2/Resources/FraudAnalysis/xsd/FraudAnalysisTypes"/>
    </con:dependencies>
</con:wadlEntry>