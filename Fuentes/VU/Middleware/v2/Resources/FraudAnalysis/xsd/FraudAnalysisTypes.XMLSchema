<?xml version="1.0" encoding="UTF-8"?>
<con:schemaEntry xmlns:con="http://www.bea.com/wli/sb/resources/config">
    <con:schema><![CDATA[<?xml version="1.0" encoding="windows-1252" ?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:tns="http://www.ficohsa.com.hn/middleware.services/FraudAnalysisTypes"
            targetNamespace="http://www.ficohsa.com.hn/middleware.services/FraudAnalysisTypes"
            elementFormDefault="qualified">
  <xsd:element name="FraudAnalysisRequest">
    <xsd:annotation>
      <xsd:documentation>A sample element</xsd:documentation>
    </xsd:annotation>
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="user" type="xsd:string"/>
        <xsd:element name="channel" type="tns:channel"/>
        <xsd:element name="idOperationType" type="xsd:string"/>
        <xsd:element name="OperationDesc" type="xsd:string"/>
        <xsd:element name="dateTime" type="xsd:string"/>
        <xsd:element name="debitAccount" type="xsd:string"/>
        <xsd:element name="creditAccount" type="xsd:string" minOccurs="0"/>
        <xsd:element name="amount" type="xsd:string"/>
        <xsd:element name="optionalParams" minOccurs="0">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="entry" maxOccurs="unbounded" minOccurs="0">
                <xsd:complexType>
                  <xsd:sequence>
                    <xsd:element name="key" type="xsd:string" minOccurs="0"/>
                    <xsd:element name="value" type="xsd:string" minOccurs="0"/>
                  </xsd:sequence>
                </xsd:complexType>
              </xsd:element>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="FraudAnalysisRequestVU">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="apiKey" type="xsd:string" minOccurs="0"/>
        <xsd:element name="idChannel" type="xsd:string" minOccurs="0"/>
        <xsd:element name="idOperation" type="xsd:string" minOccurs="0"/>
        <xsd:element name="userId" type="xsd:string" minOccurs="0"/>
        <xsd:element name="eventDate" type="xsd:string" minOccurs="0"/>
        <xsd:element name="amount" type="xsd:string" minOccurs="0"/>
        <xsd:element name="debitAccount" type="xsd:string" minOccurs="0"/>
        <xsd:element name="creditAccount" type="xsd:string" minOccurs="0"/>
        <xsd:element name="optionalParams" minOccurs="0" maxOccurs="unbounded">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="name" type="xsd:string" minOccurs="0"/>
              <xsd:element name="value" type="xsd:string" minOccurs="0"/>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="FraudAnalysisResponse">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="FraudAnalysisRecordType">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="ACTION" type="xsd:string" minOccurs="0"/>
              <xsd:element name="SCORERISK" type="xsd:integer" minOccurs="0"/>
              <xsd:element name="TRIGGEREDRULENAME" type="xsd:string" minOccurs="0"/>
              <xsd:element name="EVENTID" type="xsd:integer" minOccurs="0"/>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
  </xsd:element>
  <xsd:element name="fraudAnalysisResponseVU">
      <xsd:complexType>
         <xsd:sequence>
            <xsd:element name="result" type="xsd:integer"/>
            <xsd:element name="score" type="xsd:integer"/>
            <xsd:element name="eventId" type="xsd:integer"/>
            <xsd:element name="ofacCoincidence" type="xsd:integer"/>
            <xsd:element name="error" type="xsd:string"/>
            <xsd:element name="triggeredRules" type="xsd:string"/>
            <xsd:element name="status" type="xsd:integer"/>
         </xsd:sequence>
      </xsd:complexType>
  </xsd:element>
  <xsd:simpleType name="channel">
		<xsd:restriction base="xsd:string">
			<xsd:enumeration value="INTERBANCA_WEB"/>
			<xsd:enumeration value="IVR"/>
			<xsd:enumeration value="ATM"/>
			<xsd:enumeration value="INTERBANCA_APP"/>
		</xsd:restriction>
	</xsd:simpleType>
</xsd:schema>]]></con:schema>
    <con:targetNamespace>http://www.ficohsa.com.hn/middleware.services/FraudAnalysisTypes</con:targetNamespace>
</con:schemaEntry>