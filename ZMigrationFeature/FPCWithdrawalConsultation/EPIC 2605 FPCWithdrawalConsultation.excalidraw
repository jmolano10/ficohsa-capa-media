      "text": "{\n  \"pk\": \"COUNTRY#XRS#DOMAIN#MANTAIN_PARTY_DIGITAL_REFRENCE#PARAM#initiate-digital-reference\",\n  \"sk\": \"V#0001\",\n  \"name\": \"initiate-digital-reference\",\n  \"value\": [\n    {\n      \"region\": \"HN01-HN01\",\n      \"enabled\": true,\n      \"secret-name\": \"ban-xrs-ic-secm-send_grid-<env>\",\n      \"param-name\": \"ban-xrs-ic-parm-send_grid-<env>\",\n      \"LEGAL_ID\": \"ID\",\n      \"DOCUMENT_ID\": \"RTN\",\n      \"Canal-SRV-ITINTB\": \"INTERBANCA_WEB\",\n      \"comment_CanalKeyRule\": \"Esta llave se construye concatenando 'Canal' con el 'Application-User' obtenido en la cabecera.\",\n      \"Canal-HNBNDSROMNIRBT\": \"INTERBANCA_WEB\",\n      \"PaisOrigen\": \"HONDURAS\"\n    },\n    {\n      \"region\": \"GT01-GT01\",\n      \"enabled\": true,\n      \"secret-name\": \"ban-xrs-ic-secm-send_grid-<env>\",\n      \"param-name\": \"ban-hn-xx-proxy-abanks-hn-param-wsdl-<env>\",\n      \"queryType\": \"EQ\",\n      \"queryValue\": \"BANK_BATCH_ID\"\n    },\n    {\n      \"region\": \"NI01-NI01\",\n      \"enabled\": true\n    },\n    {\n      \"region\": \"PA01-PA01\",\n      \"enabled\": true\n    }\n  ],\n  \"type\": \"JSON\",\n  \"description\": \"CONFIG OF MANTAIN_PARTY_DIGITAL_REFRENCE BY METHOD\",\n  \"country\": \"XRS\",\n  \"domain\": \"MANTAIN_PARTY_DIGITAL_REFRENCE\",\n  \"tags\": [],\n  \"precedence\": 10,\n  \"effective_from\": \"\",\n  \"effective_to\": \"\",\n  \"status\": \"active\",\n  \"updated_at\": \"2025-12-19T18:10:00Z\",\n  \"updated_by\": \"eudis.perdomo@ficohsa.com\"\n}\n",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "r0XNJ0nhxID2XRL1c7K5a",
