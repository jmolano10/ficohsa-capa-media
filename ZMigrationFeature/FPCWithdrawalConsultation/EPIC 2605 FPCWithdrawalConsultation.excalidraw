    {
      "id": "4rB3yAJORfqLot0k8yv57",
      "type": "text",
      "x": 29159.304821573125,
      "y": 3072.7470216269658,
      "width": 628.7996215820312,
      "height": 775,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
