        L --> L2[CARDHOLDER_FLAG: PRINCIPAL→1, ADDITIONAL→0]
        L --> L3[PIN_SUPPRESSION: YES→0, NO→1]
        L --> L4[SDP_PROCESS_TYPE: EMERGENCY→1, NORMAL→0]
        L --> L5[RQTD_CARD_TYPE/TYPE_CARD_MAILER:<br/>Si vacío → PRINCIPAL=01, ADDITIONAL=00]
    end
    
    L1 --> M[Validar Schema<br/>XMLSchema_769155616]
    L2 --> M
    L3 --> M
    L4 --> M
    L5 --> M
    
    M --> N[BS: visionPlus<br/>http://172.28.1.145:7802/VisionPlusService<br/>Operación: EmbosserAddL8VB<br/>Timeout: 5seg]
    
    N --> O{ServiceReturnCode = P?}
    O -->|Sí| P[validationMessage = vacío]
    O -->|No| Q[validationMessage = RC-1-Desc<br/>errorCode = RC-1-Code]
    
    K -->|No - org vacío| R[No invoca VisionPlus]
    R --> S
    
    P --> S{validationMessage = vacío?}
    Q --> S
    
    S -->|Sí - Éxito| T[solicitudTCOut.xqy<br/>Mapear respuesta VP → OSB]
